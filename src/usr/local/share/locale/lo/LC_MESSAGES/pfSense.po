msgstr "ຄຳຕິຊົມການຕິດຕັ້ງ"

#: src/usr/local/www/system_advanced_misc.php:398
msgid "Netgate Device ID"
msgstr "Netgate Device ID"

#: src/usr/local/www/system_advanced_misc.php:401
