#: src/usr/local/www/firewall_rules_edit.php:1516 src/usr/local/www/diag_smart.php:295 src/usr/local/www/diag_smart.php:298 src/usr/local/www/firewall_rules.php:936
msgid "Log"
msgstr "ບັນທຶກ (Log)"

#: src/usr/local/www/firewall_rules_edit.php:1519
#, php-format
msgid "Hint: the firewall has limited local log space. Don't turn on logging for everything. If doing a lot of logging, consider using a remote syslog server (see the %1$sStatus: System Logs: Settings%2$s page)."
msgstr "ຄຳແນະນຳ: ໄຟວໍມີພື້ນທີ່ຈັດເກັບ Log ໃນເຄື່ອງທີ່ຈຳກັດ. ບໍ່ຄວນເປີດການບັນທຶກ Log ສຳລັບທຸກຢ່າງ. ຖ້າຕ້ອງການບັນທຶກ Log ຈຳນວນຫຼາຍ, ໃຫ້ພິຈາລະນາໃຊ້ remote syslog server (ເບິ່ງທີ່ໜ້າ %1$sStatus: System Logs: Settings%2$s)."

#: src/usr/local/www/firewall_rules_edit.php:1528
#, php-format
msgid "A description may be entered here for administrative reference. A maximum of %s characters will be used in the ruleset and displayed in the firewall log."
msgstr "ສາມາດໃສ່ຄຳອະທິບາຍຢູ່ບ່ອນນີ້ເພື່ອໃຊ້ໃນການອ້າງອີງ. ສາມາດໃຊ້ໄດ້ສູງສຸດ %s ຕົວອັກສອນໃນຊຸດກົດ ແລະ ຈະສະແດງໃນ firewall log."

#: src/usr/local/www/firewall_rules_edit.php:1553
msgid "Source OS"
msgstr "ລະບົບປະຕິບັດການຕົ້ນທາງ (Source OS)"

#: src/usr/local/www/firewall_rules_edit.php:1556
msgid "Note: this only works for TCP rules. General OS choice matches all subtypes."
msgstr "ໝາຍເຫດ: ຕົວເລືອກນີ້ໃຊ້ໄດ້ສະເພາະກັບກົດ TCP ເທົ່ານັ້ນ. ການເລືອກ OS ທົ່ວໄປຈະກວມເອົາທຸກປະເພດຍ່ອຍ."

#: src/usr/local/www/firewall_rules_edit.php:1560
msgid "Diffserv Code Point"
msgstr "Diffserv Code Point"

