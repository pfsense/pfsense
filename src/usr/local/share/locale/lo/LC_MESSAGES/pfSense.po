#: src/etc/inc/web/system_advanced_firewall.inc:169
#, php-format
msgid "The Firewall Maximum Table Entries value must be greater than %s when block bogons is enabled."
msgstr "ຄ່າ Firewall Maximum Table Entries ຕ້ອງຫຼາຍກວ່າ %s ເມື່ອເປີດໃຊ້ງານການບລັອກເຄືອຂ່າຍ Bogon."

#: src/etc/inc/web/system_advanced_firewall.inc:385
msgid "Changed Advanced Firewall/NAT settings."
msgstr "ມີການປ່ຽນແປງການຕັ້ງຄ່າໄຟວໍຂັ້ນສູງ/NAT."

#: src/etc/inc/web/backup.inc:118
msgid "Supplied password and confirmation do not match."
msgstr "ລະຫັດຜ່ານທີ່ລະບຸ ແລະ ລະຫັດຜ່ານຢືນຢັນບໍ່ກົງກັນ."

#: src/etc/inc/web/backup.inc:195
msgid "A password for decryption must be supplied and confirmed."
msgstr "ຕ້ອງມີການລະບຸ ແລະ ຢືນຢັນລະຫັດຜ່ານສຳລັບການຖອດລະຫັດ."

#: src/etc/inc/web/backup.inc:209
#, php-format
msgid "The uploaded file does not appear to contain an encrypted %s configuration."
msgstr "ໄຟລ໌ທີ່ອັບໂຫຼດເບິ່ງຄືວ່າບໍ່ມີຂໍ້ມູນການຕັ້ງຄ່າ %s ທີ່ຖືກເຂົ້າລະຫັດໄວ້."

#: src/etc/inc/web/backup.inc:214
msgid "File decryption failed. Incorrect password or file is invalid."
msgstr "ຖອດລະຫັດໄຟລ໌ບໍ່ສຳເລັດ. ລະຫັດຜ່ານບໍ່ຖືກຕ້ອງ ຫຼື ໄຟລ໌ໃຊ້ບໍ່ໄດ້."

#: src/etc/inc/web/backup.inc:228 src/etc/inc/web/backup.inc:231
msgid "An area to restore was selected but the correct xml tag could not be located."
msgstr "ມີການເລືອກສ່ວນທີ່ຈະກູ້ຄືນ ແຕ່ບໍ່ພົບແທັກ XML ທີ່ຖືກຕ້ອງ."

#: src/etc/inc/web/backup.inc:245
#, php-format
msgid "Unset RRD and extra data from configuration after restoring %s configuration area"
msgstr "ຍົກເລີກການຕັ້ງຄ່າ RRD ແລະ ຂໍ້ມູນພິເສດຈາກການຕັ້ງຄ່າ ຫຼັງຈາກກູ້ຄືນສ່ວນການຕັ້ງຄ່າ %s"

#: src/etc/inc/web/backup.inc:250
msgid "The configuration area has been restored. The firewall may need to be rebooted."
msgstr "ກູ້ຄືນສ່ວນການຕັ້ງຄ່າສຳເລັດແລ້ວ. ໄຟວໍອາດຈະຕ້ອງໄດ້ຮັບການເລີ່ມຕົ້ນໃໝ່ (Reboot)."

#: src/etc/inc/web/backup.inc:255
#, php-format
msgid "A full configuration restore was selected but a %s tag could not be located."
msgstr "ມີການເລືອກການກູ້ຄືນການຕັ້ງຄ່າທັງໝົດ ແຕ່ບໍ່ພົບແທັກ %s."

#: src/etc/inc/web/backup.inc:287
msgid "Removing pkg repository set after restoring full configuration"
msgstr "ກຳລັງລຶບການຕັ້ງຄ່າຄັງແພັກເກດ (pkg repository) ຫຼັງຈາກກູ້ຄືນການຕັ້ງຄ່າທັງໝົດ"

#: src/etc/inc/web/backup.inc:296 src/etc/inc/web/backup.inc:305
msgid "Restore serial console enabling in configuration."
msgstr "ກູ້ຄືນການເປີດໃຊ້ງານ Serial Console ໃນການຕັ້ງຄ່າ."

#: src/etc/inc/web/backup.inc:324
msgid "Unset RRD and extra data from configuration after full restore."
msgstr "ຍົກເລີກການຕັ້ງຄ່າ RRD ແລະ ຂໍ້ມູນພິເສດຈາກການຕັ້ງຄ່າ ຫຼັງຈາກກູ້ຄືນທັງໝົດ."

#: src/etc/inc/web/backup.inc:357
msgid "The configuration could not be restored."
msgstr "ບໍ່ສາມາດກູ້ຄືນການຕັ້ງຄ່າໄດ້."

#: src/etc/inc/web/backup.inc:362
msgid "The configuration could not be restored (file upload error)."
msgstr "ບໍ່ສາມາດກູ້ຄືນການຕັ້ງຄ່າໄດ້ (ເກີດຂໍ້ຜິດພາດໃນການອັບໂຫຼດໄຟລ໌)."

#: src/etc/inc/web/system_advanced_misc.inc:124
msgid "Please select a valid Cryptographic Accelerator."
msgstr "ກະລຸນາເລືອກຕົວເລັ່ງການເຂົ້າລະຫັດ (Cryptographic Accelerator) ທີ່ຖືກຕ້ອງ."

#: src/etc/inc/web/system_advanced_misc.inc:128
msgid "Please select a valid Thermal Hardware Sensor."
msgstr "ກະລຸນາເລືອກເຊັນເຊີກວດຈັບຄວາມຮ້ອນທີ່ຖືກຕ້ອງ."

#: src/etc/inc/web/system_advanced_misc.inc:132
msgid "/tmp Size must be numeric and should not be less than 40MiB."
msgstr "ຂະໜາດຂອງ /tmp ຕ້ອງເປັນຕົວເລກ ແລະ ບໍ່ຄວນໜ້ອຍກວ່າ 40MiB."

#: src/etc/inc/web/system_advanced_misc.inc:136
msgid "/var Size must be numeric and should not be less than 60MiB."
msgstr "ຂະໜາດຂອງ /var ຕ້ອງເປັນຕົວເລກ ແລະ ບໍ່ຄວນໜ້ອຍກວ່າ 60MiB."

#: src/etc/inc/web/system_advanced_misc.inc:141
msgid "Combined size of /tmp and /var RAM disks would exceed available kernel memory."
msgstr "ຂະໜາດລວມຂອງ /tmp ແລະ /var RAM disks ຈະເກີນໜ່ວຍຄວາມຈຳຂອງເຄີເນິນທີ່ມີ."

#: src/etc/inc/web/system_advanced_misc.inc:145
msgid "Proxy port must be a valid port number, 1-65535."
msgstr "ພອດ Proxy ຕ້ອງເປັນຕົວເລກພອດທີ່ຖືກຕ້ອງ, 1-65535."

#: src/etc/inc/web/system_advanced_misc.inc:149
msgid "Proxy URL must be a valid IP address or FQDN."
msgstr "Proxy URL ຕ້ອງເປັນທີ່ຢູ່ IP ຫຼື FQDN ທີ່ຖືກຕ້ອງ."

#: src/etc/inc/web/system_advanced_misc.inc:153
msgid "The proxy username contains invalid characters."
msgstr "ຊື່ຜູ້ໃຊ້ Proxy ມີຕົວອັກສອນທີ່ບໍ່ຖືກຕ້ອງ."

#: src/etc/inc/web/system_advanced_misc.inc:157
msgid "Proxy password and confirmation must match."
msgstr "ລະຫັດຜ່ານ Proxy ແລະ ລະຫັດຢືນຢັນຕ້ອງກົງກັນ."

#: src/etc/inc/web/system_advanced_misc.inc:161
msgid "Invalid AC Power mode."
msgstr "ໂໝດພະລັງງານ AC ບໍ່ຖືກຕ້ອງ."

#: src/etc/inc/web/system_advanced_misc.inc:165
msgid "Invalid Battery Power mode."
msgstr "ໂໝດພະລັງງານຈາກແບັດເຕີຣີບໍ່ຖືກຕ້ອງ."

#: src/etc/inc/web/system_advanced_misc.inc:169
msgid "Invalid Unknown Power mode."
msgstr "ໂໝດພະລັງງານທີ່ບໍ່ຮູ້ຈັກ ບໍ່ຖືກຕ້ອງ."

#: src/etc/inc/web/system_advanced_misc.inc:173
msgid "Invalid MDS Mode."
msgstr "ໂໝດ MDS ບໍ່ຖືກຕ້ອງ."

#: src/etc/inc/web/system_advanced_sysctl.inc:85
msgid "Both a name and a value must be specified."
msgstr "ຕ້ອງລະບຸທັງຊື່ ແລະ ຄ່າ."

#: src/etc/inc/web/system_advanced_sysctl.inc:87
msgid "The value may only contain alphanumeric characters, -, _, %, and /."
msgstr "ຄ່າສາມາດປະກອບດ້ວຍຕົວອັກສອນ, ຕົວເລກ, -, _, %, ແລະ / ເທົ່ານັ້ນ."

#: src/etc/inc/web/system_advanced_notifications.inc:144
msgid "Certificate Expiration Threshold must be a positive integer"
msgstr "ເກນການແຈ້ງເຕືອນການໝົດອາຍຸຂອງໃບຢັ້ງຢືນຕ້ອງເປັນຕົວເລກຖ້ວນບວກ"

#: src/etc/inc/web/system_advanced_notifications.inc:149
msgid "Please enter valid E-Mail server address."
msgstr "ກະລຸນາໃສ່ທີ່ຢູ່ອີເມລເຊີເວີທີ່ຖືກຕ້ອງ."

#: src/etc/inc/web/system_advanced_notifications.inc:155
msgid "Please enter valid SMTP port of E-Mail server address."
msgstr "ກະລຸນາໃສ່ພອດ SMTP ຂອງອີເມລເຊີເວີທີ່ຖືກຕ້ອງ."

#: src/etc/inc/web/system_advanced_notifications.inc:173
msgid "Please enter valid connection timeout."
msgstr "ກະລຸນາໃສ່ຄ່າໝົດເວລາການເຊື່ອມຕໍ່ (timeout) ທີ່ຖືກຕ້ອງ."

#: src/etc/inc/web/system_advanced_notifications.inc:179
msgid "Please enter valid notification E-Mail address."
msgstr "ກະລຸນາໃສ່ທີ່ຢູ່ອີເມລສຳລັບຮັບການແຈ້ງເຕືອນທີ່ຖືກຕ້ອງ."

#: src/etc/inc/web/system_advanced_notifications.inc:192
msgid "SMTP passwords must match"
msgstr "ລະຫັດຜ່ານ SMTP ຕ້ອງກົງກັນ"

#: src/etc/inc/web/system_advanced_notifications.inc:198
msgid "Please select valid authentication mechanism."
msgstr "ກະລຸນາເລືອກກົນໄກການຢືນຢັນຕົວຕົນທີ່ຖືກຕ້ອງ."

#: src/etc/inc/web/system_advanced_notifications.inc:223
msgid "The only special characters permitted in the Telegram API string are _, - and :"
msgstr "ຕົວອັກສອນພິເສດທີ່ອະນຸຍາດໃນ Telegram API ແມ່ນ _, - ແລະ : ເທົ່ານັ້ນ"

#: src/etc/inc/web/system_advanced_notifications.inc:226
msgid "The Chat ID can only contain @, _ or - as special characters"
msgstr "Chat ID ສາມາດມີ @, _ ຫຼື - ເປັນຕົວອັກສອນພິເສດເທົ່ານັ້ນ"

#: src/etc/inc/web/system_advanced_notifications.inc:235
msgid "API keys are case-sensitive, 30 characters long, and can only use the character set A-Z,a-z,0-9"
msgstr "API keys ແຍກຕົວອັກສອນໃຫຍ່-ນ້ອຍ, ມີຄວາມຍາວ 30 ຕົວອັກສອນ ແລະ ໃຊ້ໄດ້ສະເພາະ A-Z, a-z, 0-9 ເທົ່ານັ້ນ"

#: src/etc/inc/web/system_advanced_notifications.inc:238
msgid "User keys are case-sensitive, 30 characters long, and can only use the character set A-Z,a-z,0-9"
msgstr "User keys ແຍກຕົວອັກສອນໃຫຍ່-ນ້ອຍ, ມີຄວາມຍາວ 30 ຕົວອັກສອນ ແລະ ໃຊ້ໄດ້ສະເພາະ A-Z, a-z, 0-9 ເທົ່ານັ້ນ"

#: src/etc/inc/web/system_advanced_notifications.inc:241
msgid "Please select a valid Pushover notification sound."
msgstr "ກະລຸນາເລືອກສຽງແຈ້ງເຕືອນ Pushover ທີ່ຖືກຕ້ອງ."

#: src/etc/inc/web/system_advanced_notifications.inc:246
msgid "Please select a valid Pushover message priority."
msgstr "ກະລຸນາເລືອກລະດັບຄວາມສຳຄັນຂອງຂໍ້ຄວາມ Pushover ທີ່ຖືກຕ້ອງ."

#: src/etc/inc/web/system_advanced_notifications.inc:251
msgid "Please enter valid notification retry interval in seconds."
msgstr "ກະລຸນາໃສ່ໄລຍະຫ່າງການລອງໃໝ່ຂອງການແຈ້ງເຕືອນເປັນວິນາທີທີ່ຖືກຕ້ອງ."

#: src/etc/inc/web/system_advanced_notifications.inc:253
msgid "Please enter valid notification retry interval with a minimum value of 30."
msgstr "ກະລຸນາໃສ່ໄລຍະຫ່າງການລອງໃໝ່ຂອງການແຈ້ງເຕືອນ ໂດຍມີຄ່າຕ່ຳສຸດແມ່ນ 30."

#: src/etc/inc/web/system_advanced_notifications.inc:258
msgid "Please enter valid notification expiration time in seconds."
