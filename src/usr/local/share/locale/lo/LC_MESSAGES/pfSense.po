#: src/etc/inc/web/system_advanced_network.inc:58
msgid "An IP address to NAT IPv6 packets must be specified."
msgstr "ຕ້ອງລະບຸທີ່ຢູ່ IP ສຳລັບການເຮັດ NAT ໃຫ້ກັບແພັກເກັດ IPv6."

#: src/etc/inc/web/system_advanced_network.inc:96
#, php-format
msgid "In order enable IPv6 and block bogon networks the Firewall Maximum Table Entries value in System / Advanced / Firewall must be increased at least to %s."
msgstr "ເພື່ອເປີດໃຊ້ IPv6 ແລະ ບລັອກເຄືອຂ່າຍ Bogon, ຄ່າ Firewall Maximum Table Entries ໃນ System / Advanced / Firewall ຕ້ອງເພີ່ມຂຶ້ນຢ່າງໜ້ອຍເປັນ %s."

#: src/etc/inc/web/firewall_virtual_ip.inc:82
msgid "The interface chosen for the VIP does not support CARP mode."
msgstr "ອິນເຕີເຟສທີ່ເລືອກສຳລັບ VIP ບໍ່ຮອງຮັບໂໝດ CARP."

#: src/etc/inc/web/firewall_virtual_ip.inc:84
msgid "The interface chosen for the VIP does not support Proxy ARP mode."
msgstr "ອິນເຕີເຟສທີ່ເລືອກສຳລັບ VIP ບໍ່ຮອງຮັບໂໝດ Proxy ARP."

#: src/etc/inc/web/firewall_virtual_ip.inc:109
msgid "This IP address is being used by another interface or VIP."
msgstr "ທີ່ຢູ່ IP ນີ້ກຳລັງຖືກໃຊ້ໂດຍອິນເຕີເຟສອື່ນ ຫຼື VIP ອື່ນ."

#: src/etc/inc/web/firewall_virtual_ip.inc:119
msgid "The interface chosen for the VIP has no IPv4 or IPv6 address configured so it cannot be used as a parent for the VIP."
msgstr "ອິນເຕີເຟສທີ່ເລືອກສຳລັບ VIP ຍັງບໍ່ໄດ້ຕັ້ງຄ່າ IPv4 ຫຼື IPv6, ຈຶ່ງບໍ່ສາມາດໃຊ້ເປັນ parent ສຳລັບ VIP ໄດ້."

#: src/etc/inc/web/firewall_virtual_ip.inc:134
msgid "The network address cannot be used for this VIP"
msgstr "ທີ່ຢູ່ເຄືອຂ່າຍ (Network Address) ບໍ່ສາມາດໃຊ້ສຳລັບ VIP ນີ້ໄດ້"

#: src/etc/inc/web/firewall_virtual_ip.inc:136
msgid "The broadcast address cannot be used for this VIP"
msgstr "ທີ່ຢູ່ບຣອດແຄສ (Broadcast Address) ບໍ່ສາມາດໃຊ້ສຳລັບ VIP ນີ້ໄດ້"

#: src/etc/inc/web/firewall_virtual_ip.inc:155
msgid "A CARP password that is shared between the two VHID members must be specified."
msgstr "ຕ້ອງລະບຸລະຫັດຜ່ານ CARP ທີ່ຈະໃຊ້ຮ່ວມກັນລະຫວ່າງສະມາຊິກ VHID ທັງສອງ."

#: src/etc/inc/web/firewall_virtual_ip.inc:159
msgid "Password and confirm password must match"
msgstr "ລະຫັດຜ່ານ ແລະ ລະຫັດຜ່ານຢືນຢັນຕ້ອງກົງກັນ"

#: src/etc/inc/web/firewall_virtual_ip.inc:163 src/etc/inc/web/firewall_virtual_ip.inc:183
msgid "For this type of vip localhost is not allowed."
msgstr "ສຳລັບ VIP ປະເພດນີ້ ບໍ່ອະນຸຍາດໃຫ້ໃຊ້ localhost."

#: src/etc/inc/web/firewall_virtual_ip.inc:165 src/etc/inc/web/firewall_virtual_ip.inc:185
msgid "A CARP parent interface can only be used with IP Alias type Virtual IPs."
msgstr "ອິນເຕີເຟສ CARP parent ສາມາດໃຊ້ໄດ້ກັບ Virtual IPs ປະເພດ IP Alias ເທົ່ານັ້ນ."

#: src/etc/inc/web/firewall_virtual_ip.inc:174
msgid "An IPv4 Virtual IP cannot have an IPv6 CARP parent."
msgstr "IPv4 Virtual IP ບໍ່ສາມາດມີ IPv6 CARP parent ໄດ້."

#: src/etc/inc/web/firewall_virtual_ip.inc:177
msgid "An IPv6 Virtual IP cannot have an IPv4 CARP parent."
msgstr "IPv6 Virtual IP ບໍ່ສາມາດມີ IPv4 CARP parent ໄດ້."

#: src/etc/inc/web/firewall_virtual_ip.inc:266
