#: src/usr/local/www/diag_packet_capture.php:555
msgid "Command line"
msgstr "ຄຳສັ່ງ (Command line)"

#: src/usr/local/www/diag_packet_capture.php:563
msgid "Packets Captured"
msgstr "ແພັກເກັດທີ່ດັກຈັບໄດ້"

#: src/usr/local/www/diag_packet_capture.php:591
