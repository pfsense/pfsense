msgstr "ສາມາດຕັ້ງຄ່າໄດ້ພຽງແຕ່ໜຶ່ງອິນເຕີເຟສພາຍໃນ 6rd prefix ດຽວ."

#: src/usr/local/www/interfaces.php:725
msgid "6RD Border Relay must be an IPv4 address."
msgstr "6RD Border Relay ຕ້ອງເປັນທີ່ຢູ່ IPv4."

#: src/usr/local/www/interfaces.php:734
#, php-format
msgid "Only one interface can be configured as 6to4."
msgstr "ສາມາດຕັ້ງຄ່າໄດ້ພຽງແຕ່ໜຶ່ງອິນເຕີເຟສເປັນ 6to4."

#: src/usr/local/www/interfaces.php:749
msgid "A valid interface to track must be selected."
msgstr "ຕ້ອງເລືອກອິນເຕີເຟສທີ່ຈະຕິດຕາມ (track) ທີ່ຖືກຕ້ອງ."

#: src/usr/local/www/interfaces.php:753
msgid "A valid hexadecimal number must be entered for the IPv6 prefix ID."
msgstr "ຕ້ອງປ້ອນເລກຖານສິບຫົກທີ່ຖືກຕ້ອງສຳລັບ IPv6 prefix ID."

#: src/usr/local/www/interfaces.php:757
msgid "The specified IPv6 Prefix ID is out of range."
msgstr "IPv6 Prefix ID ທີ່ລະບຸຢູ່ນອກຂອບເຂດ."

#: src/usr/local/www/interfaces.php:767
#, php-format
msgid "This track6 prefix ID is already being used in %s."
msgstr "ໄອດີພຣີຟິກ (prefix ID) ຂອງ track6 ນີ້ ແມ່ນຖືກໃຊ້ງານຢູ່ແລ້ວໃນ %s."

#: src/usr/local/www/interfaces.php:784
#, php-format
msgid "IPv4 address %s is being used by or overlaps with:"
msgstr "ທີ່ຢູ່ IPv4 %s ກຳລັງຖືກໃຊ້ ຫຼື ຊ້ອນທັບກັບ:"

#: src/usr/local/www/interfaces.php:794
msgid "This IPv4 address is the network address and cannot be used"
msgstr "ທີ່ຢູ່ IPv4 ນີ້ແມ່ນທີ່ຢູ່ເຄືອຂ່າຍ (network address) ແລະ ບໍ່ສາມາດໃຊ້ງານໄດ້"

#: src/usr/local/www/interfaces.php:796
msgid "This IPv4 address is the broadcast address and cannot be used"
msgstr "ທີ່ຢູ່ IPv4 ນີ້ແມ່ນທີ່ຢູ່ບຣອດແຄສ (broadcast address) ແລະ ບໍ່ສາມາດໃຊ້ງານໄດ້"

#: src/usr/local/www/interfaces.php:803
msgid "This IPv4 address conflicts with a Static Route."
msgstr "ທີ່ຢູ່ IPv4 ນີ້ຂັດແຍ້ງກັບ Static Route."

#: src/usr/local/www/interfaces.php:814 src/usr/local/www/services_dhcpv6_edit.php:113
msgid "A valid IPv6 address must be specified."
msgstr "ຕ້ອງລະບຸທີ່ຢູ່ IPv6 ທີ່ຖືກຕ້ອງ."

#: src/usr/local/www/interfaces.php:817
msgid "IPv6 link local addresses cannot be configured as an interface IP."
msgstr "ທີ່ຢູ່ IPv6 link local ບໍ່ສາມາດຕັ້ງຄ່າເປັນ IP ຂອງອິນເຕີເຟສໄດ້."

#: src/usr/local/www/interfaces.php:821
#, php-format
msgid "IPv6 address %s is being used by or overlaps with:"
msgstr "ທີ່ຢູ່ IPv6 %s ກຳລັງຖືກໃຊ້ ຫຼື ຊ້ອນທັບກັບ:"

#: src/usr/local/www/interfaces.php:831
msgid "This IPv6 address conflicts with a Static Route."
msgstr "ທີ່ຢູ່ IPv6 ນີ້ຂັດແຍ້ງກັບ Static Route."

#: src/usr/local/www/interfaces.php:839 src/usr/local/www/interfaces.php:842
msgid "A valid subnet bit count must be specified."
msgstr "ຕ້ອງລະບຸຈຳນວນບິດ subnet ທີ່ຖືກຕ້ອງ."

#: src/usr/local/www/interfaces.php:845
msgid "A valid alias IP address must be specified."
msgstr "ຕ້ອງລະບຸທີ່ຢູ່ IP alias ທີ່ຖືກຕ້ອງ."

#: src/usr/local/www/interfaces.php:848
msgid "A valid alias subnet bit count must be specified."
msgstr "ຕ້ອງລະບຸຈຳນວນບິດ alias subnet ທີ່ຖືກຕ້ອງ."

#: src/usr/local/www/interfaces.php:851
msgid "An invalid IP address was detected in the 'Reject leases from' field."
msgstr "ພົບທີ່ຢູ່ IP ທີ່ບໍ່ຖືກຕ້ອງໃນຊ່ອງ 'Reject leases from'."

#: src/usr/local/www/interfaces.php:863
msgid "A valid IPv4 gateway must be specified."
msgstr "ຕ້ອງລະບຸ IPv4 gateway ທີ່ຖືກຕ້ອງ."

#: src/usr/local/www/interfaces.php:875
msgid "A valid IPv6 gateway must be specified."
msgstr "ຕ້ອງລະບຸ IPv6 gateway ທີ່ຖືກຕ້ອງ."

#: src/usr/local/www/interfaces.php:880
msgid "The service name may not contain quote characters."
msgstr "ຊື່ບໍລິການບໍ່ສາມາດມີຕົວອັກສອນອັນຍະປະກາດ (quote) ໄດ້."

#: src/usr/local/www/interfaces.php:883
msgid "The Host-Uniq value can only be hexadecimal or letters and numbers."
msgstr "ຄ່າ Host-Uniq ສາມາດເປັນໄດ້ພຽງແຕ່ເລກຖານສິບຫົກ ຫຼື ຕົວອັກສອນ ແລະ ຕົວເລກ."

#: src/usr/local/www/interfaces.php:900
msgid "A valid PPTP local IP address must be specified."
msgstr "ຕ້ອງລະບຸທີ່ຢູ່ IP ທ້ອງຖິ່ນຂອງ PPTP ທີ່ຖືກຕ້ອງ."

#: src/usr/local/www/interfaces.php:903
msgid "A valid PPTP subnet bit count must be specified."
msgstr "ຕ້ອງລະບຸຈຳນວນບິດ PPTP subnet ທີ່ຖືກຕ້ອງ."

#: src/usr/local/www/interfaces.php:906
msgid "A valid PPTP remote IP address must be specified."
msgstr "ຕ້ອງລະບຸທີ່ຢູ່ IP ປາຍທາງຂອງ PPTP ທີ່ຖືກຕ້ອງ."

#: src/usr/local/www/interfaces.php:946
msgid "The MTU of a VLAN cannot be greater than that of its parent interface."
msgstr "ຄ່າ MTU ຂອງ VLAN ບໍ່ສາມາດໃຫຍ່ກວ່າ MTU ຂອງອິນເຕີເຟສຫຼັກ (parent interface)."

#: src/usr/local/www/interfaces.php:962
#, php-format
msgid "Interface %s (VLAN) has MTU set to a larger value."
msgstr "ອິນເຕີເຟສ %s (VLAN) ຖືກຕັ້ງຄ່າ MTU ໃຫ້ມີຄ່າໃຫຍ່ກວ່າ."

#: src/usr/local/www/interfaces.php:969
msgid "The MSS must be an integer between 576 and 65535 bytes."
msgstr "MSS ຕ້ອງເປັນຕົວເລກລະຫວ່າງ 576 ຫາ 65535 ໄບຕ໌."

#: src/usr/local/www/interfaces.php:981
msgid "A specific channel, not auto, must be selected for Access Point mode."
msgstr "ຕ້ອງເລືອກຊ່ອງ (channel) ສະເພາະ, ບໍ່ແມ່ນ auto, ສຳລັບໂໝດ Access Point."

#: src/usr/local/www/interfaces.php:985
msgid "Channel width selection is only supported by 802.11n standards."
msgstr "ການເລືອກຄວາມກວ້າງຂອງຊ່ອງ (Channel width) ຮອງຮັບສະເພາະມາດຕະຖານ 802.11n ເທົ່ານັ້ນ."

#: src/usr/local/www/interfaces.php:989
msgid "802.11n standards require enabling WME."
msgstr "ມາດຕະຖານ 802.11n ຕ້ອງການໃຫ້ເປີດໃຊ້ WME."

#: src/usr/local/www/interfaces.php:995
#, php-format
msgid "Unable to use %s channel width with channel %s."
msgstr "ບໍ່ສາມາດໃຊ້ຄວາມກວ້າງຂອງຊ່ອງ %s ກັບຊ່ອງ %s ໄດ້."

#: src/usr/local/www/interfaces.php:1001
msgid "Key Rotation must be an integer between 1 and 9999."
msgstr "Key Rotation ຕ້ອງເປັນຕົວເລກລະຫວ່າງ 1 ຫາ 9999."

#: src/usr/local/www/interfaces.php:1004
msgid "Master Key Regeneration must be an integer between 1 and 9999."
msgstr "Master Key Regeneration ຕ້ອງເປັນຕົວເລກລະຫວ່າງ 1 ຫາ 9999."

#: src/usr/local/www/interfaces.php:1008
msgid "Master Key Regeneration must be greater than Key Rotation."
msgstr "Master Key Regeneration ຕ້ອງຫຼາຍກວ່າ Key Rotation."

#: src/usr/local/www/interfaces.php:1013
msgid "802.1X Authentication Server must be an IP or hostname."
msgstr "ເຊີເວີຢືນຢັນຕົວຕົນ 802.1X ຕ້ອງເປັນ IP ຫຼື ຊື່ໂຮສ (hostname)."

#: src/usr/local/www/interfaces.php:1018
msgid "Secondary 802.1X Authentication Server must be an IP or hostname."
msgstr "ເຊີເວີຢືນຢັນຕົວຕົນ 802.1X ສຳຮອງ ຕ້ອງເປັນ IP ຫຼື ຊື່ໂຮສ."

#: src/usr/local/www/interfaces.php:1023
msgid "802.1X Authentication Server Port must be a valid port number (1-65535)."
msgstr "ພອດຂອງເຊີເວີຢືນຢັນຕົວຕົນ 802.1X ຕ້ອງເປັນເລກພອດທີ່ຖືກຕ້ອງ (1-65535)."

#: src/usr/local/www/interfaces.php:1028
msgid "Secondary 802.1X Authentication Server Port must be a valid port number (1-65535)."
msgstr "ພອດຂອງເຊີເວີຢືນຢັນຕົວຕົນ 802.1X ສຳຮອງ ຕ້ອງເປັນເລກພອດທີ່ຖືກຕ້ອງ (1-65535)."

#: src/usr/local/www/interfaces.php:1033
msgid "Invalid channel specified."
msgstr "ຊ່ອງທີ່ລະບຸບໍ່ຖືກຕ້ອງ."

#: src/usr/local/www/interfaces.php:1036
msgid "Channel must be between 0-255."
msgstr "ຊ່ອງຕ້ອງຢູ່ລະຫວ່າງ 0-255."

#: src/usr/local/www/interfaces.php:1041
msgid "Distance must be an integer."
msgstr "ໄລຍະທາງ (Distance) ຕ້ອງເປັນຕົວເລກ."

#: src/usr/local/www/interfaces.php:1045
msgid "Channel selected is not valid for 802.11a or 802.11na."
msgstr "ຊ່ອງທີ່ເລືອກບໍ່ຖືກຕ້ອງສຳລັບ 802.11a ຫຼື 802.11na."

#: src/usr/local/www/interfaces.php:1050
msgid "Channel selected is not valid for 802.11b or 802.11g."
msgstr "ຊ່ອງທີ່ເລືອກບໍ່ຖືກຕ້ອງສຳລັບ 802.11b ຫຼື 802.11g."

#: src/usr/local/www/interfaces.php:1054
msgid "Invalid option chosen for OFDM Protection Mode"
msgstr "ຕົວເລືອກທີ່ເລືອກສຳລັບ OFDM Protection Mode ບໍ່ຖືກຕ້ອງ"

#: src/usr/local/www/interfaces.php:1060
msgid "The WPA passphrase must be between 8 and 63 characters long."
msgstr "ລະຫັດຜ່ານ WPA ຕ້ອງມີຄວາມຍາວລະຫວ່າງ 8 ຫາ 63 ຕົວອັກສອນ."

#: src/usr/local/www/interfaces.php:1066
msgid "A WPA Passphrase must be specified when WPA PSK is enabled."
msgstr "ຕ້ອງລະບຸລະຫັດຜ່ານ WPA ເມື່ອເປີດໃຊ້ WPA PSK."

#: src/usr/local/www/interfaces.php:1071
msgid "An Inner Authentication Identity must be specified when PEAP/TTLS authentication method is selected."
msgstr "ຕ້ອງລະບຸ Inner Authentication Identity ເມື່ອເລືອກວິທີການຢືນຢັນຕົວຕົນແບບ PEAP/TTLS."

#: src/usr/local/www/interfaces.php:1075
msgid "An Inner Authentication Passphrase must be specified when PEAP/TTLS authentication method is selected."
msgstr "ຕ້ອງລະບຸ Inner Authentication Passphrase ເມື່ອເລືອກວິທີການຢືນຢັນຕົວຕົນແບບ PEAP/TTLS."

#: src/usr/local/www/interfaces.php:1083
msgid "PPP Password and confirmed password must match!"
msgstr "ລະຫັດຜ່ານ PPP ແລະ ລະຫັດຜ່ານຢືນຢັນຕ້ອງຕົງກັນ!"

#: src/usr/local/www/interfaces.php:1087
msgid "PPPoE Password and confirmed password must match!"
msgstr "ລະຫັດຜ່ານ PPPoE ແລະ ລະຫັດຜ່ານຢືນຢັນຕ້ອງຕົງກັນ!"

#: src/usr/local/www/interfaces.php:1091
msgid "PTPP Password and confirmed password must match!"
msgstr "ລະຫັດຜ່ານ PTPP ແລະ ລະຫັດຜ່ານຢືນຢັນຕ້ອງຕົງກັນ!"

#: src/usr/local/www/interfaces.php:1842
#, php-format
msgid "Unable to change mode to %s. The maximum number of wireless clones supported in this mode may have been reached."
msgstr "ບໍ່ສາມາດປ່ຽນໂໝດເປັນ %s. ອາດຈະຮອດຈຳນວນສູງສຸດຂອງ wireless clones ທີ່ຮອງຮັບໃນໂໝດນີ້ແລ້ວ."

