#: src/usr/local/www/firewall_rules_edit.php:1645
msgid "Max. src. conn. Rates"
msgstr "ອັດຕາການເຊື່ອມຕໍ່ຕົ້ນທາງສູງສຸດ (ຫຼາຍອັດຕາ)"

#: src/usr/local/www/firewall_rules_edit.php:1649
msgid "/ per how many second(s) (TCP only)"
