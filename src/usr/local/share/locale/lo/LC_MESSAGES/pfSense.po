msgstr "CSR ໃໝ່ (ວາງລົງຂ້າງລຸ່ມ)"

#: src/usr/local/www/system_certmanager.php:760
msgid "Sign CSR"
msgstr "ລົງນາມ CSR"

#: src/usr/local/www/system_certmanager.php:765
msgid "*CA to sign with"
msgstr "*CA ທີ່ຈະໃຊ້ລົງນາມ"

#: src/usr/local/www/system_certmanager.php:772
msgid "*CSR to sign"
msgstr "*CSR ທີ່ຈະລົງນາມ"

#: src/usr/local/www/system_certmanager.php:779
msgid "CSR data"
msgstr "ຂໍ້ມູນ CSR"

#: src/usr/local/www/system_certmanager.php:781
msgid "Paste a Certificate Signing Request in X.509 PEM format here."
msgstr "ວາງຄຳຮ້ອງຂໍການລົງນາມໃບຢັ້ງຢືນໃນຮູບແບບ X.509 PEM ຢູ່ບ່ອນນີ້."

#: src/usr/local/www/system_certmanager.php:785
msgid "Key data"
msgstr "ຂໍ້ມູນຄີ"

#: src/usr/local/www/system_certmanager.php:787
#, php-format
msgid "Optionally paste a private key here. The key will be associated with the newly signed certificate in %1$s"
msgstr "ສາມາດເລືອກວາງຄີສ່ວນຕົວຢູ່ບ່ອນນີ້ໄດ້. ຄີຈະຖືກຜູກມັດກັບໃບຢັ້ງຢືນທີ່ລົງນາມໃໝ່ໃນ %1$s"

#: src/usr/local/www/system_certmanager.php:791
msgid "*Certificate Lifetime (days)"
msgstr "*ອາຍຸການໃຊ້ງານຂອງໃບຢັ້ງຢືນ (ມື້)"

#: src/usr/local/www/system_certmanager.php:795 src/usr/local/www/system_certmanager.php:954
#, php-format
msgid "The length of time the signed certificate will be valid, in days. %1$sServer certificates should not have a lifetime over %2$s days or some platforms may consider the certificate invalid."
msgstr "ໄລຍະເວລາທີ່ໃບຢັ້ງຢືນທີ່ລົງນາມຈະມີຜົນໃຊ້ງານ, ເປັນມື້. %1$sໃບຢັ້ງຢືນເຊີບເວີ ບໍ່ຄວນມີອາຍຸການໃຊ້ງານເກີນ %2$s ມື້ ຖ້າບໍ່ດັ່ງນັ້ນ ບາງແພລັດຟອມອາດຈະຖືວ່າໃບຢັ້ງຢືນນັ້ນບໍ່ຖືກຕ້ອງ."

#: src/usr/local/www/system_certmanager.php:800 src/usr/local/www/system_certmanager.php:941 src/usr/local/www/system_certmanager.php:1045 src/usr/local/www/system_camanager.php:690 src/usr/local/www/system_usermanager.php:1019
msgid "*Digest Algorithm"
msgstr "*ອັລກໍຣິດທຶມ Digest"

#: src/usr/local/www/system_certmanager.php:803 src/usr/local/www/system_certmanager.php:944 src/usr/local/www/system_certmanager.php:1048 src/usr/local/www/system_usermanager.php:1022
#, php-format
msgid "The digest method used when the certificate is signed. %1$sThe best practice is to use an algorithm stronger than SHA1. Some platforms may consider weaker digest algorithms invalid"
msgstr "ວິທີການ Digest ທີ່ໃຊ້ເມື່ອໃບຢັ້ງຢືນຖືກລົງນາມ. %1$sແນວທາງທີ່ດີທີ່ສຸດແມ່ນການໃຊ້ອັລກໍຣິດທຶມທີ່ແຂງແກ່ນກວ່າ SHA1. ບາງແພລັດຟອມອາດຖືວ່າອັລກໍຣິດທຶມ Digest ທີ່ອ່ອນແອນັ້ນບໍ່ຖືກຕ້ອງ"

#: src/usr/local/www/system_certmanager.php:810 src/usr/local/www/system_certmanager.php:1435
