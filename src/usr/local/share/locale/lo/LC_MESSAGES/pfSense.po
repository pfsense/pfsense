msgid "Sends accounting packets to the RADIUS server."
msgstr "ສົ່ງແພັກເກັດການເກັບຂໍ້ມູນການໃຊ້ງານ (Accounting packets) ໄປຍັງເຊີບເວີ RADIUS."

#: src/usr/local/www/vpn_l2tp.php:332
msgid "*Server"
msgstr "*ເຊີບເວີ"

#: src/usr/local/www/vpn_l2tp.php:334
msgid "Enter the IP address of the RADIUS server."
msgstr "ປ້ອນທີ່ຢູ່ IP ຂອງເຊີບເວີ RADIUS."

#: src/usr/local/www/vpn_l2tp.php:338 src/usr/local/www/interfaces_ppps_edit.php:595 src/usr/local/www/interfaces.php:3051
msgid "*Secret"
msgstr "*ລະຫັດລັບ"

#: src/usr/local/www/vpn_l2tp.php:341 src/usr/local/www/services_pppoe_edit.php:466
msgid "Enter the shared secret that will be used to authenticate to the RADIUS server."
msgstr "ປ້ອນລະຫັດລັບຮ່ວມທີ່ຈະໃຊ້ໃນການຢືນຢັນຕົວຕົນກັບເຊີບເວີ RADIUS."

