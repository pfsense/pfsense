#: src/usr/local/www/system_advanced_misc.php:389
#, php-format
msgid "Puts the hard disk into standby mode when the selected number of minutes has elapsed since the last access.%1$s%2$sDo not set this for CF cards.%3$s"
msgstr "ໃຫ້ຮາດດິດເຂົ້າສູ່ໂຫມດສະແຕນບາຍເມື່ອຮອດເວລາທີ່ກຳນົດ (ນາທີ) ນັບຈາກການເຂົ້າເຖິງຄັ້ງຫຼ້າສຸດ. %1$s%2$sຢ່າຕັ້ງຄ່ານີ້ສຳລັບກາດ CF. %3$s"

#: src/usr/local/www/system_advanced_misc.php:394
