#, php-format
msgid "Low and high thresholds for packet loss in %%. Default is %1$d/%2$d."
msgstr "ເກນຕ່ຳ ແລະ ສູງ ສຳລັບການສູນເສຍແພັກເກັດ (packet loss) ເປັນ %%. ຄ່າເລີ່ມຕົ້ນແມ່ນ %1$d/%2$d."

#: src/usr/local/www/system_gateways_edit.php:316
msgid "Probe Interval"
msgstr "ຊ່ວງເວລາການກວດສອບ (Probe Interval)"

#: src/usr/local/www/system_gateways_edit.php:323
#, php-format
msgid "How often an ICMP probe will be sent in milliseconds. Default is %d."
msgstr "ຄວາມຖີ່ໃນການສົ່ງ ICMP probe (ມິນລິວິນາທີ). ຄ່າເລີ່ມຕົ້ນແມ່ນ %d."

#: src/usr/local/www/system_gateways_edit.php:327
msgid "Loss Interval"
msgstr "ຊ່ວງເວລາທີ່ຈະຖືວ່າສູນຫາຍ (Loss Interval)"

#: src/usr/local/www/system_gateways_edit.php:331
#, php-format
msgid "Time interval in milliseconds before packets are treated as lost. Default is %d."
msgstr "ໄລຍະເວລາ (ມິນລິວິນາທີ) ກ່ອນທີ່ຈະຖືວ່າແພັກເກັດສູນຫາຍ. ຄ່າເລີ່ມຕົ້ນແມ່ນ %d."

#: src/usr/local/www/system_gateways_edit.php:334
msgid "Time Period"
msgstr "ໄລຍະເວລາລວມ (Time Period)"

#: src/usr/local/www/system_gateways_edit.php:344
#, php-format
msgid "Time period in milliseconds over which results are averaged. Default is %d."
msgstr "ໄລຍະເວລາ (ມິນລິວິນາທີ) ທີ່ຈະນຳຜົນມາສະເລ່ຍ. ຄ່າເລີ່ມຕົ້ນແມ່ນ %d."

#: src/usr/local/www/system_gateways_edit.php:348
msgid "Alert interval"
msgstr "ຊ່ວງເວລາການແຈ້ງເຕືອນ"

#: src/usr/local/www/system_gateways_edit.php:358
#, php-format
msgid "Time interval in milliseconds between checking for an alert condition. Default is %d."
msgstr "ໄລຍະເວລາ (ມິນລິວິນາທີ) ໃນການກວດສອບເງື່ອນໄຂການແຈ້ງເຕືອນ. ຄ່າເລີ່ມຕົ້ນແມ່ນ %d."

#: src/usr/local/www/system_gateways_edit.php:363
msgid "Additional information"
msgstr "ຂໍ້ມູນເພີ່ມເຕີມ"

#: src/usr/local/www/system_gateways_edit.php:365
msgid "The time period, probe interval and loss interval are closely related. The ratio between these values control the accuracy of the numbers reported and the timeliness of alerts."
msgstr "Time period, probe interval ແລະ loss interval ແມ່ນມີຄວາມກ່ຽວພັນກັນ. ອັດຕາສ່ວນລະຫວ່າງຄ່າເຫຼົ່ານີ້ຈະຄວບຄຸມຄວາມຊັດເຈນຂອງຕົວເລກທີ່ລາຍງານ ແລະ ຄວາມວ່ອງໄວຂອງການແຈ້ງເຕືອນ."

#: src/usr/local/www/system_gateways_edit.php:369
msgid "A longer time period will provide smoother results for round trip time and loss, but will increase the time before a latency or loss alert is triggered."
msgstr "ໄລຍະເວລາ (time period) ທີ່ດົນຂຶ້ນຈະໃຫ້ຜົນສະເລ່ຍທີ່ຮາບລື່ນກວ່າ ແຕ່ຈະເຮັດໃຫ້ການແຈ້ງເຕືອນຊ້າລົງ."

#: src/usr/local/www/system_gateways_edit.php:372
msgid "A shorter probe interval will decrease the time required before a latency or loss alert is triggered, but will use more network resource. Longer probe intervals will degrade the accuracy of the quality graphs."
msgstr "Probe interval ທີ່ສັ້ນລົງຈະຊ່ວຍໃຫ້ແຈ້ງເຕືອນໄດ້ໄວຂຶ້ນ ແຕ່ຈະໃຊ້ຊັບພະຍາກອນເຄືອຂ່າຍເພີ່ມຂຶ້ນ."

#: src/usr/local/www/system_gateways_edit.php:376
msgid "The ratio of the probe interval to the time period (minus the loss interval) also controls the resolution of loss reporting. To determine the resolution, the following formula can be used:"
msgstr "ອັດຕາສ່ວນຂອງ probe interval ຕໍ່ time period ກໍຄວບຄຸມຄວາມລະອຽດຂອງການລາຍງານການສູນຫາຍຄືກັນ. ສາມາດໃຊ້ສູດດັ່ງນີ້:"

#: src/usr/local/www/system_gateways_edit.php:380
msgid "&nbsp;&nbsp;&nbsp;&nbsp;100 * probe interval / (time period - loss interval)"
msgstr "&nbsp;&nbsp;&nbsp;&nbsp;100 * probe interval / (time period - loss interval)"

#: src/usr/local/www/system_gateways_edit.php:382
msgid "Rounding up to the nearest whole number will yield the resolution of loss reporting in percent. The default values provide a resolution of 1%."
msgstr "ການປັດເລກຂຶ້ນຈະໃຫ້ຄ່າຄວາມລະອຽດຂອງການລາຍງານການສູນຫາຍເປັນເປີເຊັນ. ຄ່າເລີ່ມຕົ້ນໃຫ້ຄວາມລະອຽດຢູ່ທີ່ 1%."

#: src/usr/local/www/system_gateways_edit.php:385
msgid "The default settings are recommended for most use cases. However if changing the settings, please observe the following restrictions:"
msgstr "ແນະນຳໃຫ້ໃຊ້ຄ່າເລີ່ມຕົ້ນສຳລັບການໃຊ້ງານທົ່ວໄປ. ແຕ່ຫາກມີການປ່ຽນແປງ, ກະລຸນາສັງເກດຂໍ້ຈຳກັດດັ່ງນີ້:"

#: src/usr/local/www/system_gateways_edit.php:388
msgid "- The time period must be greater than twice the probe interval plus the loss interval. This guarantees there is at least one completed probe at all times. "
msgstr "- ໄລຍະເວລາ ຕ້ອງຫຼາຍກວ່າສອງເທົ່າຂອງ ໄລຍະຫ່າງການກວດສອບ (probe interval) ບວກກັບ ໄລຍະຫ່າງການສູນເສຍ (loss interval). ສິ່ງນີ້ຮັບປະກັນວ່າ ຈະມີການກວດສອບທີ່ສຳເລັດຢ່າງໜ້ອຍໜຶ່ງຄັ້ງຢູ່ຕະຫຼອດເວລາ. "

#: src/usr/local/www/system_gateways_edit.php:391
msgid "- The alert interval must be greater than or equal to the probe interval. There is no point checking for alerts more often than probes are done."
msgstr "- Alert interval ຕ້ອງຫຼາຍກວ່າ ຫຼື ເທົ່າກັບ probe interval."

#: src/usr/local/www/system_gateways_edit.php:394
msgid "- The loss interval must be greater than or equal to the high latency threshold."
msgstr "- Loss interval ຕ້ອງຫຼາຍກວ່າ ຫຼື ເທົ່າກັບເກນ latency ສູງ (high latency threshold)."

#: src/usr/local/www/system_gateways_edit.php:400
msgid "Use non-local gateway"
msgstr "ໃຊ້ເກດເວທີ່ບໍ່ໄດ້ຢູ່ໃນທ້ອງຖິ່ນ (non-local gateway)"

#: src/usr/local/www/system_gateways_edit.php:403
msgid "This will allow use of a gateway outside of this interface's subnet. This is usually indicative of a configuration error, but is required for some scenarios."
msgstr "ສິ່ງນີ້ຈະອະນຸຍາດໃຫ້ໃຊ້ເກດເວທີ່ຢູ່ນອກຊັບເນັດຂອງອິນເຕີເຟດນີ້. ປົກກະຕິແລ້ວມັນອາດຈະໝາຍເຖິງການຕັ້ງຄ່າທີ່ຜິດພາດ ແຕ່ຈຳເປັນໃນບາງກໍລະນີ."

