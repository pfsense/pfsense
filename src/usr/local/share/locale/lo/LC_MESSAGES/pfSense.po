msgstr "ຊຸດລະຫັດຂໍ້ມູນ (Data Ciphers)"

#: src/usr/local/www/vpn_openvpn_client.php:1236 src/usr/local/www/system_certmanager_renew.php:240 src/usr/local/www/vpn_openvpn_server.php:1708
msgid "Digest"
msgstr "ໄດເຈສ (Digest)"

