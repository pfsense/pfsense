msgstr "6to4 Tunnel"

#: src/usr/local/www/interfaces.php:1875
msgid "Track Interface"
msgstr "ຕິດຕາມອິນເຕີເຟສ (Track Interface)"

#: src/usr/local/www/interfaces.php:1884
msgid "Default (no preference, typically autoselect)"
msgstr "ຄ່າເລີ່ມຕົ້ນ (ບໍ່ມີການກຳນົດ, ປົກກະຕິຈະເລືອກອັດຕະໂນມັດ)"

#: src/usr/local/www/interfaces.php:1885
msgid "------- Media Supported by this interface -------"
msgstr "------- ມີເດຍທີ່ຮອງຮັບໂດຍອິນເຕີເຟສນີ້ -------"

#: src/usr/local/www/interfaces.php:1928
#, php-format
msgid "The %s configuration has been changed."
msgstr "ການຕັ້ງຄ່າ %s ໄດ້ຖືກປ່ຽນແປງ."

#: src/usr/local/www/interfaces.php:1929
msgid "The changes must be applied to take effect."
msgstr "ຕ້ອງນຳໃຊ້ການປ່ຽນແປງເພື່ອໃຫ້ມີຜົນ."

#: src/usr/local/www/interfaces.php:1930
msgid "Don't forget to adjust the DHCP Server range if needed after applying."
msgstr "ຢ່າລືມປັບປ່ຽນຊ່ວງ DHCP Server ຖ້າຈຳເປັນ ຫຼັງຈາກນຳໃຊ້ການຕັ້ງຄ່າ."

#: src/usr/local/www/interfaces.php:1939
msgid "General Configuration"
msgstr "ການຕັ້ງຄ່າທົ່ວໄປ"

#: src/usr/local/www/interfaces.php:1951
msgid "*Description"
msgstr "*ຄຳອະທິບາຍ"

#: src/usr/local/www/interfaces.php:1954
msgid "Enter a description (name) for the interface here."
msgstr "ໃສ່ຄຳອະທິບາຍ (ຊື່) ສຳລັບອິນເຕີເຟສທີ່ນີ້."

#: src/usr/local/www/interfaces.php:1959
msgid "IPv4 Configuration Type"
msgstr "ປະເພດການຕັ້ງຄ່າ IPv4"

#: src/usr/local/www/interfaces.php:1965
msgid "IPv6 Configuration Type"
msgstr "ປະເພດການຕັ້ງຄ່າ IPv6"

#: src/usr/local/www/interfaces.php:1971
msgid "IPv4/IPv6 Configuration"
msgstr "ການຕັ້ງຄ່າ IPv4/IPv6"

#: src/usr/local/www/interfaces.php:1999
msgid "The MAC address of a VLAN interface must be set on its parent interface"
msgstr "ທີ່ຢູ່ MAC ຂອງອິນເຕີເຟສ VLAN ຕ້ອງຖືກຕັ້ງຄ່າໃນອິນເຕີເຟສຫຼັກ (parent interface)"

#: src/usr/local/www/interfaces.php:2002
#, php-format
msgid "This field can be used to modify (\"spoof\") the MAC address of this interface.%sEnter a MAC address in the following format: xx:xx:xx:xx:xx:xx or leave blank."
msgstr "ຊ່ອງນີ້ສາມາດໃຊ້ເພື່ອປ່ຽນແປງ (\"spoof\") ທີ່ຢູ່ MAC ຂອງອິນເຕີເຟສນີ້.%sໃສ່ທີ່ຢູ່ MAC ໃນຮູບແບບ: xx:xx:xx:xx:xx:xx ຫຼື ປະວ່າງໄວ້."

#: src/usr/local/www/interfaces.php:2020
msgid "MSS"
msgstr "MSS"

