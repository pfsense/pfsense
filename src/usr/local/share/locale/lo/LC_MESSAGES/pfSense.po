#: src/usr/local/www/services_captiveportal.php:900 src/usr/local/www/vpn_ipsec_phase1.php:836
msgid "*Authentication Method"
msgstr "*ວິທີການຢືນຢັນຕົວຕົນ"

#: src/usr/local/www/services_captiveportal.php:908
msgid "Authentication Method"
msgstr "ວິທີການຢືນຢັນຕົວຕົນ"

#: src/usr/local/www/services_captiveportal.php:911
msgid "Select an Authentication Method to use for this zone. One method must be selected.<br />- \"Authentication backend\" will force the login page to be displayed and will authenticate users using their login and password, or using vouchers.<br />- \"None\" method will force the login page to be displayed but will accept any visitor that clicks the \"submit\" button.<br/>- \"RADIUS MAC Authentication\" method will try to authenticate devices automatically with their MAC address without displaying any login page."
msgstr "ເລືອກວິທີການຢືນຢັນຕົວຕົນສຳລັບໂຊນນີ້. ຕ້ອງເລືອກຢ່າງໜ້ອຍໜຶ່ງວິທີ.<br />- \"Authentication backend\" ຈະບັງຄັບໃຫ້ສະແດງໜ້າລົງຊື່ເຂົ້າໃຊ້ ແລະ ຢືນຢັນຕົວຕົນດ້ວຍຊື່ຜູ້ໃຊ້ ແລະ ລະຫັດຜ່ານ ຫຼື ບັດເຕີມ (vouchers).<br />- \"None\" ຈະສະແດງໜ້າລົງຊື່ເຂົ້າໃຊ້ ແຕ່ຈະອະນຸຍາດໃຫ້ທຸກຄົນທີ່ກົດປຸ່ມ \"submit\" ເຂົ້າໃຊ້ໄດ້ເລີຍ.<br />- \"RADIUS MAC Authentication\" ຈະພະຍາຍາມຢືນຢັນຕົວຕົນອັດຕະໂນມັດດ້ວຍທີ່ຢູ່ MAC ໂດຍບໍ່ສະແດງໜ້າລົງຊື່ເຂົ້າໃຊ້."

#: src/usr/local/www/services_captiveportal.php:927
msgid "You can add a remote authentication server in the <a href=\"/system_authservers.php\">User Manager</a>.<br/><span class=\"vouchers_helptext\">Vouchers could also be used, please go to "
msgstr "ທ່ານສາມາດເພີ່ມເຊີບເວີຢືນຢັນຕົວຕົນຈາກພາຍນອກໄດ້ທີ່ <a href=\"/system_authservers.php\">ຈັດການຜູ້ໃຊ້</a>.<br/><span class=\"vouchers_helptext\">ນອກຈາກນີ້ຍັງສາມາດໃຊ້ບັດເຕີມ (Vouchers) ໄດ້, ກະລຸນາໄປທີ່ "

#: src/usr/local/www/services_captiveportal.php:932
msgid "Secondary authentication Server"
msgstr "ເຊີບເວີຢືນຢັນຕົວຕົນສຳຮອງ"

#: src/usr/local/www/services_captiveportal.php:941
msgid "You can optionally select a second set of servers to to authenticate users. Users will then be able to login using separated HTML inputs.<br />This setting is useful if you want to provide multiple authentication method to your users. If you don't need multiple authentication method, then leave this setting empty."
msgstr "ທ່ານສາມາດເລືອກເຊີບເວີຊຸດທີສອງເພື່ອຢືນຢັນຕົວຕົນຜູ້ໃຊ້ໄດ້. ຜູ້ໃຊ້ຈະສາມາດລົງຊື່ເຂົ້າໃຊ້ຜ່ານຊ່ອງຂໍ້ມູນ HTML ທີ່ແຍກກັນ.<br />ການຕັ້ງຄ່ານີ້ມີປະໂຫຍດຫາກທ່ານຕ້ອງການໃຫ້ມີຫຼາຍວິທີການຢືນຢັນຕົວຕົນ. ຫາກບໍ່ຈຳເປັນ ໃຫ້ປ່ອຍຫວ່າງໄວ້."

#: src/usr/local/www/services_captiveportal.php:947
msgid "NAS Identifier"
msgstr "NAS Identifier"

#: src/usr/local/www/services_captiveportal.php:950
#, php-format
msgid "Specify a NAS identifier to override the default value (CaptivePortal-%s)"
msgstr "ລະບຸ NAS identifier ເພື່ອຂຽນທັບຄ່າເລີ່ມຕົ້ນ (CaptivePortal-%s)"

#: src/usr/local/www/services_captiveportal.php:954
msgid "Reauthenticate Users"
msgstr "ຢືນຢັນຕົວຕົນຜູ້ໃຊ້ຄືນໃໝ່"

#: src/usr/local/www/services_captiveportal.php:957
msgid "If reauthentication is enabled, request are made to the server for each user that is logged in every minute. If an access denied is received for a user, that user is disconnected from the captive portal immediately. Reauthentication requires user credentials to be cached in the captive portal database while a user is logged in; The cached credentials are necessary for the portal to perform automatic reauthentication requests."
msgstr "ຫາກເປີດໃຊ້ການຢືນຢັນຕົວຕົນຄືນໃໝ່, ລະບົບຈະສົ່ງຄຳຂໍໄປຫາເຊີບເວີທຸກໆນາທີສຳລັບຜູ້ໃຊ້ແຕ່ລະຄົນທີ່ເຊື່ອມຕໍ່ຢູ່. ຫາກໄດ້ຮັບການປະຕິເສດ, ຜູ້ໃຊ້ນັ້ນຈະຖືກຕັດການເຊື່ອມຕໍ່ທັນທີ. ການຢືນຢັນຕົວຕົນຄືນໃໝ່ຕ້ອງມີການເກັບຂໍ້ມູນການເຂົ້າໃຊ້ຂອງຜູ້ໃຊ້ໄວ້ໃນຖານຂໍ້ມູນຊົ່ວຄາວໃນຂະນະທີ່ເຊື່ອມຕໍ່ຢູ່."

#: src/usr/local/www/services_captiveportal.php:966
msgid "Local Authentication Privileges"
msgstr "ສິດທິໃນການຢືນຢັນຕົວຕົນພາຍໃນລະບົບ"

#: src/usr/local/www/services_captiveportal.php:974
msgid "RADIUS MAC Secret"
msgstr "RADIUS MAC Secret"

#: src/usr/local/www/services_captiveportal.php:977
msgid "RADIUS MAC will automatically try to authenticate devices with their MAC address as username, and the password entered below as password. Devices will still need to make one HTTP request to get connected, through."
msgstr "RADIUS MAC ຈະພະຍາຍາມຢືນຢັນຕົວຕົນອັດຕະໂນມັດໂດຍໃຊ້ທີ່ຢູ່ MAC ເປັນຊື່ຜູ້ໃຊ້ ແລະ ໃຊ້ລະຫັດຜ່ານທີ່ລະບຸຂ້າງລຸ່ມ. ແນວໃດກໍຕາມ, ອຸປະກອນຍັງຈຳເປັນຕ້ອງມີການສົ່ງຄຳຂໍ HTTP ໜຶ່ງຄັ້ງເພື່ອເຊື່ອມຕໍ່."

#: src/usr/local/www/services_captiveportal.php:981
msgid "Login page Fallback"
msgstr "ການກັບໄປໃຊ້ໜ້າລົງຊື່ເຂົ້າໃຊ້ (Fallback)"

#: src/usr/local/www/services_captiveportal.php:984
msgid "When enabled, users will be redirected to the captive portal login page when RADIUS MAC authentication failed."
msgstr "ເມື່ອເປີດໃຊ້, ຜູ້ໃຊ້ຈະຖືກສົ່ງຕໍ່ໄປຫາໜ້າລົງຊື່ເຂົ້າໃຊ້ captive portal ຫາກການຢືນຢັນຕົວຕົນ RADIUS MAC ຫຼົ້ມເຫຼວ."

#: src/usr/local/www/services_captiveportal.php:991
msgid "When enabled, clients will be disconnected after the amount of time retrieved from the RADIUS Session-Timeout attribute."
msgstr "ເມື່ອເປີດໃຊ້, ລູກຂ່າຍຈະຖືກຕັດການເຊື່ອມຕໍ່ຫຼັງຈາກໝົດເວລາທີ່ໄດ້ຮັບຈາກຄ່າ RADIUS Session-Timeout."

#: src/usr/local/www/services_captiveportal.php:995
msgid "Traffic quota"
msgstr "ໂຄຕ້າການຮັບສົ່ງຂໍ້ມູນ"

#: src/usr/local/www/services_captiveportal.php:998
msgid "When enabled, clients will be disconnected after exceeding the amount of traffic, inclusive of both downloads and uploads, retrieved from the RADIUS pfSense-Max-Total-Octets attribute."
msgstr "ເມື່ອເປີດໃຊ້, ລູກຂ່າຍຈະຖືກຕັດການເຊື່ອມຕໍ່ຫຼັງຈາກໃຊ້ຂໍ້ມູນເກີນກຳນົດ (ລວມທັງດາວໂຫຼດ ແລະ ອັບໂຫຼດ) ຕາມຄ່າທີ່ໄດ້ຮັບຈາກ RADIUS pfSense-Max-Total-Octets."

#: src/usr/local/www/services_captiveportal.php:1002
msgid "Per-user bandwidth restrictions"
msgstr "ການຈຳກັດແບນວິດຕໍ່ຜູ້ໃຊ້"

#: src/usr/local/www/services_captiveportal.php:1005
msgid "When enabled, the bandwidth assigned to a client will be limited to the values retrieved from the RADIUS pfSense-Bandwidth-Max-Up and pfSense-Bandwidth-Max-Down attributes or from the comparable WISPr attributes."
msgstr "ເມື່ອເປີດໃຊ້, ແບນວິດຂອງລູກຂ່າຍຈະຖືກຈຳກັດຕາມຄ່າທີ່ໄດ້ຮັບຈາກ RADIUS pfSense-Bandwidth-Max-Up ແລະ pfSense-Bandwidth-Max-Down ຫຼື ຈາກຄ່າ WISPr ທີ່ກ່ຽວຂ້ອງ."

#: src/usr/local/www/services_captiveportal.php:1012
msgid "Single dash"
msgstr "ຂີດດຽວ (Single dash)"

#: src/usr/local/www/services_captiveportal.php:1012
msgid "Unformatted"
msgstr "ບໍ່ມີຮູບແບບ (Unformatted)"

#: src/usr/local/www/services_captiveportal.php:1010
msgid "MAC address format"
msgstr "ຮູບແບບທີ່ຢູ່ MAC"

#: src/usr/local/www/services_captiveportal.php:1013
#, php-format
msgid "This option changes the MAC address format used when performing a RADIUS authentication. %1$sDefault: 00:11:22:33:44:55 %1$sSingle dash: 001122-334455 %1$sIETF: 00-11-22-33-44-55 %1$sCisco: 0011.2233.4455 %1$sUnformatted: 001122334455"
msgstr "ຕົວເລືອກນີ້ໃຊ້ເພື່ອປ່ຽນຮູບແບບທີ່ຢູ່ MAC ເມື່ອມີການຢືນຢັນຕົວຕົນຜ່ານ RADIUS. %1$sເລີ່ມຕົ້ນ: 00:11:22:33:44:55 %1$sຂີດດຽວ: 001122-334455 %1$sIETF: 00-11-22-33-44-55 %1$sCisco: 0011.2233.4455 %1$sບໍ່ມີຮູບແບບ: 001122334455"

#: src/usr/local/www/services_captiveportal.php:1030
msgid "If enabled, accounting request will be made for users identified against any RADIUS server."
msgstr "ຫາກເປີດໃຊ້, ຈະມີການສົ່ງຄຳຂໍເກັບຂໍ້ມູນການໃຊ້ງານ (Accounting) ສຳລັບຜູ້ໃຊ້ທີ່ຢືນຢັນຕົວຕົນຜ່ານ RADIUS."

#: src/usr/local/www/services_captiveportal.php:1041 src/usr/local/www/services_captiveportal.php:1046
msgid "Accounting Server"
msgstr "ເຊີບເວີເກັບຂໍ້ມູນການໃຊ້ງານ (Accounting Server)"

#: src/usr/local/www/services_captiveportal.php:1052
msgid "You can add a Radius Accounting server in the <a href=\"/system_authservers.php\">User Manager</a>."
msgstr "ທ່ານສາມາດເພີ່ມເຊີບເວີ Radius Accounting ໄດ້ທີ່ <a href=\"/system_authservers.php\">ຈັດການຜູ້ໃຊ້</a>."

#: src/usr/local/www/services_captiveportal.php:1056
msgid "Send accounting updates"
msgstr "ສົ່ງຂໍ້ມູນການໃຊ້ງານທີ່ອັບເດດ"

#: src/usr/local/www/services_captiveportal.php:1092
msgid ""
"This field set the way Accounting Updates should be done : <br />- If \"No updates\" is selected, then only one \"Accounting Start\" and one \"Accounting Stop\" request will be sent, when any user get connected and disconnected.<br />- If \"Interim\" is selected, then \"Accounting Update\" requests will be send regularly (every minute) to the RADIUS server, for each connected user.<br />- In some rare cases, you would like to simulate users to disconnect and reconnect every minute (eg, to send an Accounting Stop then an Accounting Start) instead of sending Accounting "
"updates, this is the purpose of \"Stop/Start\" option. FreeRADIUS does not support this option very well, you should select \"Stop/Start (FreeRADIUS)\" instead."
msgstr "ຊ່ອງນີ້ກຳນົດວິທີການອັບເດດຂໍ້ມູນການໃຊ້ງານ (Accounting): <br />- ຫາກເລືອກ \"No updates\", ຈະມີການສົ່ງຄຳຂໍພຽງແຕ່ \"Accounting Start\" ເມື່ອເລີ່ມເຊື່ອມຕໍ່ ແລະ \"Accounting Stop\" ເມື່ອຕັດການເຊື່ອມຕໍ່.<br />- ຫາກເລືອກ \"Interim\", ຈະມີການສົ່ງຄຳຂໍ \"Accounting Update\" ໄປຫາເຊີບເວີ RADIUS ເປັນໄລຍະ (ທຸກໆນາທີ).<br />- ໃນບາງກໍລະນີ, ທ່ານອາດຕ້ອງການຈຳລອງໃຫ້ຜູ້ໃຊ້ຕັດການເຊື່ອມຕໍ່ ແລະ ເຊື່ອມຕໍ່ໃໝ່ທຸກນາທີ ໃຫ້ເລືອກ \"Stop/Start\". ແຕ່ FreeRADIUS ບໍ່ຮອງຮັບຕົວເລືອກນີ້ດີປານໃດ, ຄວນເລືອກ \"Stop/Start (FreeRADIUS)\" ແທນ."

#: src/usr/local/www/services_captiveportal.php:1101
msgid "Accounting style"
msgstr "ຮູບແບບການເກັບຂໍ້ມູນການໃຊ້ງານ"

#: src/usr/local/www/services_captiveportal.php:1104
msgid "When enabled, data counts for RADIUS accounting packets will be taken from the client perspective, not the NAS. Acct-Input-Octets will represent download, and Acct-Output-Octets will represent upload."
msgstr "ເມື່ອເປີດໃຊ້, ການນັບຂໍ້ມູນສຳລັບ RADIUS accounting ຈະຖືເອົາຈາກມຸມມອງຂອງລູກຂ່າຍ. Acct-Input-Octets ຈະໝາຍເຖິງການດາວໂຫຼດ, ແລະ Acct-Output-Octets ຈະໝາຍເຖິງການອັບໂຫຼດ."

#: src/usr/local/www/services_captiveportal.php:1109
msgid "Idle time accounting"
msgstr "ການເກັບຂໍ້ມູນເວລາວ່າງ (Idle time accounting)"

#: src/usr/local/www/services_captiveportal.php:1112
msgid "This setting change the stop time that will be send in the Accounting Stop request, when a user get disconnected after exceeding the idle timeout. If not checked, the sent stop time will be the last activity time."
msgstr "ການຕັ້ງຄ່ານີ້ຈະປ່ຽນເວລາຢຸດທີ່ຈະສົ່ງໄປໃນຄຳຂໍ Accounting Stop ເມື່ອຜູ້ໃຊ້ຖືກຕັດການເຊື່ອມຕໍ່ຍ້ອນເກີນກຳນົດ idle timeout. ຫາກບໍ່ເລືອກ, ເວລາຢຸດທີ່ສົ່ງໄປຈະແມ່ນເວລາທີ່ມີການເຄື່ອນໄຫວຫຼ້າສຸດ."

#: src/usr/local/www/services_captiveportal.php:1116
msgid "HTTPS Options"
msgstr "ຕົວເລືອກ HTTPS"

#: src/usr/local/www/services_captiveportal.php:1121
msgid "Login"
msgstr "ລົງຊື່ເຂົ້າໃຊ້"

#: src/usr/local/www/services_captiveportal.php:1124
msgid "When enabled, the username and password will be transmitted over an HTTPS connection to protect against eavesdroppers. A server name and certificate must also be specified below."
msgstr "ເມື່ອເປີດໃຊ້, ຊື່ຜູ້ໃຊ້ ແລະ ລະຫັດຜ່ານຈະຖືກສົ່ງຜ່ານການເຊື່ອມຕໍ່ HTTPS ເພື່ອປ້ອງກັນການດັກຂໍ້ມູນ. ຕ້ອງລະບຸຊື່ເຊີບເວີ ແລະ ໃບຢັ້ງຢືນ (Certificate) ຢູ່ຂ້າງລຸ່ມນຳ."

#: src/usr/local/www/services_captiveportal.php:1129
msgid "*HTTPS server name"
msgstr "*ຊື່ເຊີບເວີ HTTPS"

#: src/usr/local/www/services_captiveportal.php:1132
#, php-format
msgid "This name will be used in the form action for the HTTPS POST and should match the Common Name (CN) in the certificate (otherwise, the client browser will most likely display a security warning). Make sure captive portal clients can resolve this name in DNS and verify on the client that the IP resolves to the correct interface IP on %s."
msgstr "ຊື່ນີ້ຈະຖືກໃຊ້ໃນ form action ສຳລັບ HTTPS POST ແລະ ຄວນກົງກັບ Common Name (CN) ໃນໃບຢັ້ງຢືນ (ບໍ່ດັ່ງນັ້ນ ບຣາວເຊີຈະແຈ້ງເຕືອນຄວາມປອດໄພ). ກະລຸນາກວດສອບໃຫ້ແນ່ໃຈວ່າລູກຂ່າຍສາມາດຄົ້ນຫາຊື່ນີ້ຜ່ານ DNS ໄດ້ ແລະ IP ທີ່ໄດ້ກົງກັບ IP ຂອງອິນເຕີເຟດໃນ %s."

#: src/usr/local/www/services_captiveportal.php:1139
msgid "*SSL/TLS Certificate"
msgstr "*ໃບຢັ້ງຢືນ SSL/TLS"

#: src/usr/local/www/services_captiveportal.php:1142
#, php-format
msgid "Certificates known to be incompatible with use for HTTPS are not included in this list. If no certificates are defined, one may be defined here: %1$sSystem &gt; Cert. Manager%2$s"
msgstr "ໃບຢັ້ງຢືນທີ່ບໍ່ຮອງຮັບກັບ HTTPS ຈະບໍ່ຖືກສະແດງໃນລາຍການນີ້. ຫາກຍັງບໍ່ມີໃບຢັ້ງຢືນ, ສາມາດເພີ່ມໄດ້ທີ່: %1$sລະບົບ &gt; ຈັດການໃບຢັ້ງຢືນ (Cert. Manager)%2$s"

#: src/usr/local/www/services_captiveportal.php:1146
msgid "HTTPS Forwards"
msgstr "ການສົ່ງຕໍ່ HTTPS"

#: src/usr/local/www/services_captiveportal.php:1149
msgid "If this option is set, attempts to connect to HTTPS (SSL/TLS on port 443) sites will not be forwarded to the captive portal. This prevents certificate errors from being presented to the user even if HTTPS logins are enabled. Users must attempt a connection to an HTTP (Port 80) site to get forwarded to the captive portal. If HTTPS logins are enabled, the user will be redirected to the HTTPS login page."
msgstr "ຫາກຕັ້ງຄ່ານີ້, ການພະຍາຍາມເຂົ້າເວັບໄຊ HTTPS (ພອດ 443) ຈະບໍ່ຖືກສົ່ງຕໍ່ໄປຫາ captive portal. ສິ່ງນີ້ຊ່ວຍປ້ອງກັນຂໍ້ຜິດພາດຂອງໃບຢັ້ງຢືນທີ່ຈະສະແດງໃຫ້ຜູ້ໃຊ້ເຫັນ. ຜູ້ໃຊ້ຕ້ອງເຂົ້າເວັບໄຊ HTTP (ພອດ 80) ກ່ອນເພື່ອໃຫ້ລະບົບສົ່ງຕໍ່ໄປຫາ captive portal."

#: src/usr/local/www/services_captiveportal.php:1158
msgid "Don't forget to enable the DHCP server on the captive portal interface! Make sure that the default/maximum DHCP lease time is higher than the hard timeout entered on this page. Also, the DNS Forwarder or Resolver must be enabled for DNS lookups by unauthenticated clients to work."
msgstr "ຢ່າລືມເປີດໃຊ້ DHCP server ໃນອິນເຕີເຟດຂອງ captive portal! ແລະ ກວດສອບໃຫ້ແນ່ໃຈວ່າເວລາ DHCP lease ສູງກວ່າ hard timeout ທີ່ກຳນົດໃນໜ້ານີ້. ນອກຈາກນີ້ ຕ້ອງເປີດໃຊ້ DNS Forwarder ຫຼື Resolver ເພື່ອໃຫ້ລູກຂ່າຍທີ່ຍັງບໍ່ໄດ້ຢືນຢັນຕົວຕົນສາມາດໃຊ້ DNS ໄດ້."

