#: src/usr/local/www/vpn_ipsec_phase2.php:139
msgid "A valid ikeid must be specified."
msgstr "ຕ້ອງລະບຸ ikeid ທີ່ຖືກຕ້ອງ."

#: src/usr/local/www/vpn_ipsec_phase2.php:144
msgid "Local network type"
msgstr "ປະເພດເຄືອຂ່າຍທ້ອງຖິ່ນ"

#: src/usr/local/www/vpn_ipsec_phase2.php:144
msgid "Unique Identifier"
msgstr "ຕົວລະບຸສະເພາະ"

#: src/usr/local/www/vpn_ipsec_phase2.php:147
msgid "Remote network type"
msgstr "ປະເພດເຄືອຂ່າຍປາຍທາງ"

#: src/usr/local/www/vpn_ipsec_phase2.php:156
msgid "A valid local network bit count must be specified."
msgstr "ຕ້ອງລະບຸຈຳນວນບິດເຄືອຂ່າຍທ້ອງຖິ່ນ (Subnet mask) ທີ່ຖືກຕ້ອງ."

#: src/usr/local/www/vpn_ipsec_phase2.php:160
msgid "A valid local network IP address must be specified."
msgstr "ຕ້ອງລະບຸທີ່ຢູ່ IP ເຄືອຂ່າຍທ້ອງຖິ່ນທີ່ຖືກຕ້ອງ."

#: src/usr/local/www/vpn_ipsec_phase2.php:163
msgid "VTI requires a valid local address"
msgstr "VTI ຕ້ອງການທີ່ຢູ່ທ້ອງຖິ່ນທີ່ຖືກຕ້ອງ"

#: src/usr/local/www/vpn_ipsec_phase2.php:166
msgid "An IPv4 local address was specified but the mode is not set to tunnel"
msgstr "ມີການລະບຸທີ່ຢູ່ IPv4 ທ້ອງຖິ່ນ ແຕ່ໂໝດບໍ່ໄດ້ຕັ້ງເປັນ tunnel"

#: src/usr/local/www/vpn_ipsec_phase2.php:168
msgid "An IPv6 local address was specified but the mode is not set to tunnel6"
msgstr "ມີການລະບຸທີ່ຢູ່ IPv6 ທ້ອງຖິ່ນ ແຕ່ໂໝດບໍ່ໄດ້ຕັ້ງເປັນ tunnel6"

#: src/usr/local/www/vpn_ipsec_phase2.php:173
msgid "VTI requires a valid local network or IP address for its endpoint address, it cannot use a network macro for a different interface (e.g. LAN)."
msgstr "VTI ຕ້ອງການເຄືອຂ່າຍທ້ອງຖິ່ນ ຫຼື ທີ່ຢູ່ IP ທີ່ຖືກຕ້ອງສຳລັບທີ່ຢູ່ endpoint, ມັນບໍ່ສາມາດໃຊ້ network macro ຈາກອິນເຕີເຟສອື່ນໄດ້ (ເຊັ່ນ: LAN)."

#: src/usr/local/www/vpn_ipsec_phase2.php:184 src/usr/local/www/vpn_ipsec_phase2.php:214
msgid "Invalid Local Network."
msgstr "ເຄືອຂ່າຍທ້ອງຖິ່ນບໍ່ຖືກຕ້ອງ."

#: src/usr/local/www/vpn_ipsec_phase2.php:184 src/usr/local/www/vpn_ipsec_phase2.php:214
#, php-format
msgid "%s has no subnet."
msgstr "%s ບໍ່ມີເຄືອຂ່າຍຍ່ອຍ (subnet)."

#: src/usr/local/www/vpn_ipsec_phase2.php:192
msgid "A valid NAT local network bit count must be specified."
msgstr "ຕ້ອງລະບຸຈຳນວນບິດເຄືອຂ່າຍ NAT ທ້ອງຖິ່ນທີ່ຖືກຕ້ອງ."

#: src/usr/local/www/vpn_ipsec_phase2.php:195
msgid "A network type address cannot be configured for NAT while only an address type is selected for local source."
msgstr "ບໍ່ສາມາດກຳນົດທີ່ຢູ່ປະເພດເຄືອຂ່າຍສຳລັບ NAT ໄດ້ ໃນຂະນະທີ່ມີການເລືອກພຽງແຕ່ປະເພດທີ່ຢູ່ (address type) ສຳລັບແຫຼ່ງຂໍ້ມູນທ້ອງຖິ່ນ."

#: src/usr/local/www/vpn_ipsec_phase2.php:199
msgid "A valid NAT local network IP address must be specified."
msgstr "ຕ້ອງລະບຸທີ່ຢູ່ IP ເຄືອຂ່າຍ NAT ທ້ອງຖິ່ນທີ່ຖືກຕ້ອງ."

#: src/usr/local/www/vpn_ipsec_phase2.php:201
msgid "A valid NAT local network IPv4 address must be specified or Mode needs to be changed to IPv6"
msgstr "ຕ້ອງລະບຸທີ່ຢູ່ IPv4 ເຄືອຂ່າຍ NAT ທ້ອງຖິ່ນທີ່ຖືກຕ້ອງ ຫຼື ປ່ຽນໂໝດເປັນ IPv6"

#: src/usr/local/www/vpn_ipsec_phase2.php:203
msgid "A valid NAT local network IPv6 address must be specified or Mode needs to be changed to IPv4"
msgstr "ຕ້ອງລະບຸທີ່ຢູ່ IPv6 ເຄືອຂ່າຍ NAT ທ້ອງຖິ່ນທີ່ຖືກຕ້ອງ ຫຼື ປ່ຽນໂໝດເປັນ IPv4"

#: src/usr/local/www/vpn_ipsec_phase2.php:222
msgid "A valid remote network bit count must be specified."
msgstr "ຕ້ອງລະບຸຈຳນວນບິດເຄືອຂ່າຍປາຍທາງທີ່ຖືກຕ້ອງ."

#: src/usr/local/www/vpn_ipsec_phase2.php:226
msgid "A valid remote network IP address must be specified."
msgstr "ຕ້ອງລະບຸທີ່ຢູ່ IP ເຄືອຂ່າຍປາຍທາງທີ່ຖືກຕ້ອງ."

#: src/usr/local/www/vpn_ipsec_phase2.php:229
msgid "VTI requires a valid remote address"
msgstr "VTI ຕ້ອງການທີ່ຢູ່ປາຍທາງທີ່ຖືກຕ້ອງ"

#: src/usr/local/www/vpn_ipsec_phase2.php:232
msgid "An IPv4 remote network was specified but the mode is not set to tunnel"
msgstr "ມີການລະບຸເຄືອຂ່າຍ IPv4 ປາຍທາງ ແຕ່ໂໝດບໍ່ໄດ້ຕັ້ງເປັນ tunnel"

#: src/usr/local/www/vpn_ipsec_phase2.php:234
msgid "An IPv6 remote network was specified but the mode is not set to tunnel6"
msgstr "ມີການລະບຸເຄືອຂ່າຍ IPv6 ປາຍທາງ ແຕ່ໂໝດບໍ່ໄດ້ຕັ້ງເປັນ tunnel6"

#: src/usr/local/www/vpn_ipsec_phase2.php:243
msgid "VTI is not compatible with mobile IPsec."
msgstr "VTI ບໍ່ຮອງຮັບກັບ IPsec ສຳລັບອຸປະກອນເຄື່ອນທີ່ (mobile)."

#: src/usr/local/www/vpn_ipsec_phase2.php:264
msgid "Phase2 with this Local Network is already defined for mobile clients."
msgstr "Phase2 ທີ່ມີເຄືອຂ່າຍທ້ອງຖິ່ນນີ້ໄດ້ຖືກກຳນົດໄວ້ແລ້ວສຳລັບຜູ້ໃຊ້ເຄື່ອນທີ່."

#: src/usr/local/www/vpn_ipsec_phase2.php:297
msgid "Phase2 with this Local/Remote networks combination is already defined for this Phase1."
msgstr "Phase2 ທີ່ມີການຈັບຄູ່ເຄືອຂ່າຍ ທ້ອງຖິ່ນ/ປາຍທາງ ນີ້ໄດ້ຖືກກຳນົດໄວ້ແລ້ວສຳລັບ Phase1 ນີ້."

#: src/usr/local/www/vpn_ipsec_phase2.php:308
msgid "Cannot switch away from VTI while the interface is assigned. Remove the interface assignment before switching away from VTI."
msgstr "ບໍ່ສາມາດປ່ຽນອອກຈາກ VTI ໄດ້ໃນຂະນະທີ່ອິນເຕີເຟສຖືກກຳນົດໄວ້. ກະລຸນາລຶບການກຳນົດອິນເຕີເຟສກ່ອນທີ່ຈະປ່ຽນຈາກ VTI."

#: src/usr/local/www/vpn_ipsec_phase2.php:343 src/usr/local/www/vpn_ipsec_phase2.php:348
msgid "The local and remote networks of a phase 2 entry cannot overlap the outside of the tunnel (interface and remote gateway) configured in its phase 1."
msgstr "ເຄືອຂ່າຍທ້ອງຖິ່ນ ແລະ ປາຍທາງຂອງ phase 2 ບໍ່ສາມາດຊ້ອນທັບກັບສ່ວນພາຍນອກຂອງ tunnel (interface ແລະ remote gateway) ທີ່ຕັ້ງຄ່າໄວ້ໃນ phase 1."

#: src/usr/local/www/vpn_ipsec_phase2.php:362
msgid "At least one encryption algorithm must be selected."
msgstr "ຕ້ອງເລືອກຢ່າງໜ້ອຍໜຶ່ງອັນກໍຣິທຶມການເຂົ້າລະຫັດ (encryption algorithm)."

#: src/usr/local/www/vpn_ipsec_phase2.php:367
msgid "At least one hashing algorithm needs to be selected."
msgstr "ຕ້ອງເລືອກຢ່າງໜ້ອຍໜຶ່ງອັນກໍຣິທຶມການແຮຊ (hashing algorithm)."

#: src/usr/local/www/vpn_ipsec_phase2.php:380
msgid "Life Time cannot be set to the same value as Rekey Time."
msgstr "Life Time ບໍ່ສາມາດຕັ້ງເປັນຄ່າດຽວກັນກັບ Rekey Time."

#: src/usr/local/www/vpn_ipsec_phase2.php:383
msgid "Life Time must be larger than Rekey Time."
msgstr "Life Time ຕ້ອງມີຄ່າຫຼາຍກວ່າ Rekey Time."

#: src/usr/local/www/vpn_ipsec_phase2.php:479
msgid "Saved IPsec tunnel Phase 2 configuration."
msgstr "ບັນທຶກການຕັ້ງຄ່າ IPsec tunnel Phase 2 ແລ້ວ."

#: src/usr/local/www/vpn_ipsec_phase2.php:494 src/usr/local/www/vpn_ipsec_phase2.php:498
msgid "Edit Phase 2"
msgstr "ແກ້ໄຂ Phase 2"

#: src/usr/local/www/vpn_ipsec_phase2.php:602
msgid "*Local Network"
msgstr "*ເຄືອຂ່າຍທ້ອງຖິ່ນ"

#: src/usr/local/www/vpn_ipsec_phase2.php:626
msgid "NAT/BINAT translation"
msgstr "ການແປ NAT/BINAT"

#: src/usr/local/www/vpn_ipsec_phase2.php:650
msgid "If NAT/BINAT is required on this network specify the address to be translated"
msgstr "ຖ້າຕ້ອງການໃຊ້ NAT/BINAT ໃນເຄືອຂ່າຍນີ້ ໃຫ້ລະບຸທີ່ຢູ່ທີ່ຈະຖືກແປ"

#: src/usr/local/www/vpn_ipsec_phase2.php:654
msgid "*Remote Network"
msgstr "*ເຄືອຂ່າຍປາຍທາງ"

#: src/usr/local/www/vpn_ipsec_phase2.php:683
msgid "Phase 2 Proposal (SA/Key Exchange)"
msgstr "ຂໍ້ສະເໜີ Phase 2 (SA/Key Exchange)"

#: src/usr/local/www/vpn_ipsec_phase2.php:690
msgid "Encapsulating Security Payload (ESP) is encryption, Authentication Header (AH) is authentication only."
msgstr "Encapsulating Security Payload (ESP) ແມ່ນການເຂົ້າລະຫັດ, Authentication Header (AH) ແມ່ນການຢືນຢັນຕົວຕົນເທົ່ານັ້ນ."

#: src/usr/local/www/vpn_ipsec_phase2.php:696
msgid "*Encryption Algorithms"
msgstr "*ອັນກໍຣິທຶມການເຂົ້າລະຫັດ"

#: src/usr/local/www/vpn_ipsec_phase2.php:727
msgid "Note: Blowfish, 3DES, and CAST128 provide weak security and should be avoided."
msgstr "ໝາຍເຫດ: Blowfish, 3DES, ແລະ CAST128 ມີຄວາມປອດໄພຕ່ຳ ແລະ ຄວນຫຼີກເວັ້ນ."

#: src/usr/local/www/vpn_ipsec_phase2.php:734
msgid "*Hash Algorithms"
msgstr "*ອັນກໍຣິທຶມການແຮຊ"

#: src/usr/local/www/vpn_ipsec_phase2.php:746
msgid "Note: Hash is ignored with GCM algorithms. MD5 and SHA1 provide weak security and should be avoided."
msgstr "ໝາຍເຫດ: ຄ່າ Hash ຈະຖືກລະເລີຍເມື່ອໃຊ້ກັບອັນກໍຣິທຶມ GCM. MD5 ແລະ SHA1 ມີຄວາມປອດໄພຕ່ຳ ແລະ ຄວນຫຼີກເວັ້ນ."

#: src/usr/local/www/vpn_ipsec_phase2.php:757
msgid "PFS key group"
msgstr "ກຸ່ມຄີ PFS"

#: src/usr/local/www/vpn_ipsec_phase2.php:772
#, no-php-format
msgid "Hard Child SA life time, in seconds, after which the Child SA will be expired. Must be larger than Rekey Time. Cannot be set to the same value as Rekey Time. If left empty, defaults to 110% of Rekey Time. If both Life Time and Rekey Time are empty, defaults to 3960."
msgstr "ອາຍຸການໃຊ້ງານ Hard Child SA (ວິນາທີ), ຫຼັງຈາກນັ້ນ Child SA ຈະໝົດອາຍຸ. ຕ້ອງຫຼາຍກວ່າ Rekey Time ແລະ ບໍ່ສາມາດຕັ້ງຄ່າດຽວກັນໄດ້. ຖ້າປະວ່າງໄວ້ ຈະຕັ້ງເປັນ 110% ຂອງ Rekey Time ໂດຍອັດຕະໂນມັດ. ຖ້າບໍ່ໄດ້ໃສ່ທັງສອງຄ່າ ຈະຕັ້ງເປັນ 3960."

#: src/usr/local/www/vpn_ipsec_phase2.php:784
msgid "Time, in seconds, before a Child SA establishes new keys. This works without interruption. Cannot be set to the same value as Life Time. Leave blank to use a default value of 90% Life Time. If both Life Time and Rekey Time are empty, defaults to 3600. Enter a value of 0 to disable, but be aware that when rekey is disabled, connections can be interrupted while new Child SA entries are negotiated."
msgstr "ເວລາ (ວິນາທີ) ກ່ອນທີ່ Child SA ຈະສ້າງຄີໃໝ່. ສາມາດເຮັດວຽກໄດ້ໂດຍບໍ່ມີການຂັດຈັງຫວະ. ບໍ່ສາມາດຕັ້ງຄ່າດຽວກັນກັບ Life Time ໄດ້. ຖ້າປະວ່າງໄວ້ ຈະຕັ້ງເປັນ 90% ຂອງ Life Time ໂດຍອັດຕະໂນມັດ. ຖ້າບໍ່ໄດ້ໃສ່ທັງສອງຄ່າ ຈະຕັ້ງເປັນ 3600. ໃສ່ 0 ເພື່ອປິດການໃຊ້ງານ, ແຕ່ໃຫ້ລະວັງວ່າເມື່ອປິດ rekey ການເຊື່ອມຕໍ່ອາດຈະຖືກຂັດຈັງຫວະໃນລະຫວ່າງການເຈລະຈາ Child SA ໃໝ່."

#: src/usr/local/www/vpn_ipsec_phase2.php:797
#, no-php-format
msgid "A random value up to this amount will be subtracted from Rekey Time to avoid simultaneous renegotiation. If left empty, defaults to 10% of Life Time. Enter 0 to disable randomness, but be aware that simultaneous renegotiation can lead to duplicate security associations."
msgstr "ຄ່າສຸ່ມ (random) ທີ່ຈະຖືກຫັກອອກຈາກ Rekey Time ເພື່ອຫຼີກເວັ້ນການເຈລະຈາຄືນໃໝ່ພ້ອມກັນ. ຖ້າປະວ່າງໄວ້ ຈະຕັ້ງເປັນ 10% ຂອງ Life Time ໂດຍອັດຕະໂນມັດ. ໃສ່ 0 ເພື່ອປິດການສຸ່ມ, ແຕ່ໃຫ້ລະວັງວ່າການເຈລະຈາພ້ອມກັນອາດເຮັດໃຫ້ເກີດ security associations ທີ່ຊ້ຳກັນ."

