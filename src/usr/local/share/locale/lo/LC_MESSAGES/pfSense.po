msgstr "ໂດຍປົກກະຕິແມ່ນ *99# ສຳລັບເຄືອຂ່າຍ GSM ແລະ #777 ສຳລັບເຄືອຂ່າຍ CDMA"

#: src/usr/local/www/interfaces_ppps_edit.php:640
msgid "Access Point Name (APN)"
msgstr "ຊື່ຈຸດເຂົ້າເຖິງ (APN)"

#: src/usr/local/www/interfaces_ppps_edit.php:647
msgid "APN number (optional)"
msgstr "ໝາຍເລກ APN (ບໍ່ບັງຄັບ)"

#: src/usr/local/www/interfaces_ppps_edit.php:650
msgid "Defaults to 1 if APN is set. Ignored if no APN is set."
msgstr "ຄ່າເລີ່ມຕົ້ນແມ່ນ 1 ຖ້າຕັ້ງຄ່າ APN. ຈະຖືກລະເລີຍຖ້າບໍ່ມີການຕັ້ງຄ່າ APN."

#: src/usr/local/www/interfaces_ppps_edit.php:654
msgid "SIM PIN"
msgstr "SIM PIN"

#: src/usr/local/www/interfaces_ppps_edit.php:661
msgid "SIM PIN wait"
msgstr "ລໍຖ້າ SIM PIN"

#: src/usr/local/www/interfaces_ppps_edit.php:664
msgid "Time to wait for SIM to discover network after PIN is sent to SIM (seconds)."
msgstr "ເວລາລໍຖ້າໃຫ້ SIM ຄົ້ນຫາເຄືອຂ່າຍຫຼັງຈາກສົ່ງ PIN ໄປຫາ SIM (ວິນາທີ)."

#: src/usr/local/www/interfaces_ppps_edit.php:668
msgid "Init string"
msgstr "Init string"

#: src/usr/local/www/interfaces_ppps_edit.php:671
msgid "Enter the modem initialization string here. Do NOT include the \"AT\" string at the beginning of the command. Many modern USB 3G modems don't need an initialization string."
msgstr "ປ້ອນ modem initialization string ທີ່ນີ້. ຫ້າມລວມຂໍ້ຄວາມ \"AT\" ທີ່ສ່ວນຕົ້ນຂອງຄຳສັ່ງ. ໂມເດັມ USB 3G ທີ່ທັນສະໄໝຫຼາຍລຸ້ນບໍ່ຈຳເປັນຕ້ອງມີ initialization string."

#: src/usr/local/www/interfaces_ppps_edit.php:676
msgid "Connection Timeout"
msgstr "ເວລາໝົດຂອງການເຊື່ອມຕໍ່"

#: src/usr/local/www/interfaces_ppps_edit.php:679
msgid "Enter timeout in seconds for connection to be established (sec.) Default is 45 sec."
msgstr "ປ້ອນເວລາໝົດເປັນວິນາທີສຳລັບການສ້າງການເຊື່ອມຕໍ່ (ວິນາທີ). ຄ່າເລີ່ມຕົ້ນແມ່ນ 45 ວິນາທີ."

#: src/usr/local/www/interfaces_ppps_edit.php:683
msgid "Uptime logging"
msgstr "ການບັນທຶກເວລາເຮັດວຽກ"

#: src/usr/local/www/interfaces_ppps_edit.php:686
#, php-format
msgid "Causes cumulative uptime to be recorded and displayed on the %1$sStatus->Interfaces%2$s page."
msgstr "ເຮັດໃຫ້ມີການບັນທຶກເວລາເຮັດວຽກສະສົມ ແລະ ສະແດງໃນໜ້າ %1$sStatus->Interfaces%2$s."

#: src/usr/local/www/interfaces_ppps_edit.php:689 src/usr/local/www/interfaces.php:2916
msgid "Service name"
msgstr "ຊື່ບໍລິການ"

#: src/usr/local/www/interfaces_ppps_edit.php:706
msgid "This field can usually be left empty. Service name will not be configured if this field is empty. Check the \"Configure NULL\" box to configure a blank Service name."
msgstr "ປົກກະຕິແລ້ວຊ່ອງນີ້ສາມາດປ່ອຍຫວ່າງໄວ້ໄດ້. ຊື່ບໍລິການຈະບໍ່ຖືກຕັ້ງຄ່າຖ້າ ຊ່ອງນີ້ຫວ່າງ. ໝາຍເລືອກ \"Configure NULL\" ເພື່ອຕັ້ງຄ່າຊື່ບໍລິການແບບຫວ່າງ."

#: src/usr/local/www/interfaces_ppps_edit.php:719 src/usr/local/www/interfaces.php:2949
msgid "Pre-set"
msgstr "Pre-set"

#: src/usr/local/www/interfaces_ppps_edit.php:714
msgid "Periodic Reset"
msgstr "ການຣີເຊັດເປັນໄລຍະ"

#: src/usr/local/www/interfaces_ppps_edit.php:721
msgid "Select a reset timing type"
msgstr "ເລືອກປະເພດເວລາການຣີເຊັດ"

#: src/usr/local/www/interfaces_ppps_edit.php:723
msgid "Reset Date/Time"
msgstr "ວັນທີ/ເວລາຣີເຊັດ"

#: src/usr/local/www/interfaces_ppps_edit.php:746
msgid "Specific date"
msgstr "ວັນທີສະເພາະ"

#: src/usr/local/www/interfaces_ppps_edit.php:748
msgid "Leaving the date field empty will cause the reset to be executed each day at the time specified in the minutes and hour fields. "
msgstr "ການປ່ອຍຊ່ອງວັນທີໃຫ້ຫວ່າງຈະເຮັດໃຫ້ການຣີເຊັດຖືກດຳເນີນການໃນແຕ່ລະວັນຕາມ ເວລາທີ່ລະບຸໄວ້ໃນຊ່ອງນາທີ ແລະ ຊົ່ວໂມງ. "

#: src/usr/local/www/interfaces_ppps_edit.php:752
msgid "Reset frequency"
msgstr "ຄວາມຖີ່ໃນການຣີເຊັດ"

#: src/usr/local/www/interfaces_ppps_edit.php:799
msgid "Advanced options"
msgstr "ຕົວເລືອກຂັ້ນສູງ"

#: src/usr/local/www/interfaces_ppps_edit.php:810
msgid "Dial On Demand"
msgstr "Dial On Demand"

#: src/usr/local/www/interfaces_ppps_edit.php:813
msgid "Causes the interface to operate in dial-on-demand mode. Do NOT enable if the link is to remain continuously connected. The interface is configured, but the actual connection of the link is delayed until qualifying outgoing traffic is detected."
msgstr "ເຮັດໃຫ້ອິນເຕີເຟດເຮັດວຽກໃນໂໝດ dial-on-demand. ຫ້າມເປີດໃຊ້ງານຖ້າ ຕ້ອງການໃຫ້ລິ້ງເຊື່ອມຕໍ່ຕະຫຼອດເວລາ. ອິນເຕີເຟດຖືກຕັ້ງຄ່າໄວ້, ແຕ່ ການເຊື່ອມຕໍ່ຕົວຈິງຈະຖືກເລື່ອນອອກໄປຈົນກວ່າຈະກວດພົບຂໍ້ມູນຂາອອກ."

#: src/usr/local/www/interfaces_ppps_edit.php:818
msgid "Idle Timeout"
msgstr "ເວລາໝົດເມື່ອບໍ່ມີການໃຊ້ງານ"

#: src/usr/local/www/interfaces_ppps_edit.php:821
msgid "If no incoming or outgoing packets are transmitted for the entered number of seconds the connection is brought down. When the idle timeout occurs, if the dial-on-demand option is enabled, mpd goes back into dial-on-demand mode. Otherwise, the interface is brought down and all associated routes removed."
msgstr "ຖ້າບໍ່ມີການຮັບສົ່ງແພັກເກັດພາຍໃນຈຳນວນວິນາທີທີ່ລະບຸ, ການເຊື່ອມຕໍ່ຈະ ຖືກຕັດ. ເມື່ອເກີດ idle timeout, ຖ້າເປີດໃຊ້ dial-on-demand, mpd ຈະກັບເຂົ້າສູ່ໂໝດ dial-on-demand. ຖ້າບໍ່ດັ່ງນັ້ນ, ອິນເຕີເຟດຈະ ຖືກປິດ ແລະ ເສັ້ນທາງ (routes) ທີ່ກ່ຽວຂ້ອງທັງໝົດຈະຖືກລຶບອອກ."

#: src/usr/local/www/interfaces_ppps_edit.php:830
#, php-format
msgid "Disable vjcomp(compression) (auto-negotiated by default).%1$sThis option enables Van Jacobson TCP header compression, which saves several bytes per TCP data packet. This option is almost always required. Compression is not effective for TCP connections with enabled modern extensions like time stamping or SACK, which modify TCP options between sequential packets."
msgstr "ປິດໃຊ້ງານ vjcomp(compression) (ໂດຍເລີ່ມຕົ້ນແມ່ນການເຈລະຈາອັດຕະໂນມັດ).%1$sຕົວເລືອກນີ້ ເປີດໃຊ້ການບີບອັດສ່ວນຫົວ TCP ຂອງ Van Jacobson, ເຊິ່ງຊ່ວຍປະຢັດໄດ້ຫຼາຍໄບຕ໌ຕໍ່ ແພັກເກັດ TCP. ຕົວເລືອກນີ້ເກືອບຈະຈຳເປັນສະເໝີ. ການບີບອັດຈະບໍ່ ມີປະສິດທິພາບສຳລັບການເຊື່ອມຕໍ່ TCP ທີ່ເປີດໃຊ້ສ່ວນຂະຫຍາຍທີ່ທັນສະໄໝ ເຊັ່ນ: time stamping ຫຼື SACK."

#: src/usr/local/www/interfaces_ppps_edit.php:837
msgid "TCPmssFix"
msgstr "TCPmssFix"

#: src/usr/local/www/interfaces_ppps_edit.php:840
msgid ""
"Causes mpd to adjust incoming and outgoing TCP SYN segments so that the requested maximum segment size is not greater than the amount allowed by the interface MTU. This is necessary in many setups to avoid problems caused by routers that drop ICMP Datagram Too Big messages. Without these messages, the originating machine sends data, it passes the rogue router then hits a machine that has an MTU that is not big enough for the data. Because the IP Don't Fragment option is set, this machine sends an ICMP Datagram Too Big message back to the originator and drops the "
"packet. The rogue router drops the ICMP message and the originator never gets to discover that it must reduce the fragment size or drop the IP Don't Fragment option from its outgoing data."
msgstr "ເຮັດໃຫ້ mpd ປັບແຕ່ງ TCP SYN segments ຂາເຂົ້າ ແລະ ຂາອອກ ເພື່ອໃຫ້ maximum segment size ບໍ່ເກີນຄ່າທີ່ອະນຸຍາດໂດຍ MTU ຂອງອິນເຕີເຟດ. ນີ້ແມ່ນສິ່ງຈຳເປັນເພື່ອຫຼີກລ່ຽງບັນຫາທີ່ເກີດຈາກຣາວເຕີທີ່ຖິ້ມຂໍ້ຄວາມ ICMP Datagram Too Big."

#: src/usr/local/www/interfaces_ppps_edit.php:848
msgid "ShortSeq"
msgstr "ShortSeq"

#: src/usr/local/www/interfaces_ppps_edit.php:851
msgid "This option is only meaningful if multi-link PPP is negotiated. It proscribes shorter multi-link fragment headers, saving two bytes on every frame. It is not necessary to disable this for connections that are not multi-link."
msgstr "ຕົວເລືອກນີ້ມີຄວາມໝາຍສະເພາະເມື່ອມີການເຈລະຈາ multi-link PPP. ມັນ ກຳນົດໃຫ້ສ່ວນຫົວຂອງ multi-link fragment ສັ້ນລົງ, ຊ່ວຍປະຢັດໄດ້ສອງໄບຕ໌ໃນທຸກໆ ເຟຣມ. ບໍ່ຈຳເປັນຕ້ອງປິດໃຊ້ງານນີ້ສຳລັບການເຊື່ອມຕໍ່ທີ່ບໍ່ແມ່ນ multi-link."

#: src/usr/local/www/interfaces_ppps_edit.php:856
msgid "ACFComp"
msgstr "ACFComp"

#: src/usr/local/www/interfaces_ppps_edit.php:859
msgid "Address and control field compression. This option only applies to asynchronous link types. It saves two bytes per frame."
msgstr "ການບີບອັດ Address and control field. ຕົວເລືອກນີ້ໃຊ້ສະເພາະກັບ ປະເພດລິ້ງ asynchronous. ມັນຊ່ວຍປະຢັດໄດ້ສອງໄບຕ໌ຕໍ່ເຟຣມ."

#: src/usr/local/www/interfaces_ppps_edit.php:863
msgid "ProtoComp"
msgstr "ProtoComp"

#: src/usr/local/www/interfaces_ppps_edit.php:866
msgid "Protocol field compression. This option saves one byte per frame for most frames."
msgstr "ການບີບອັດ Protocol field. ຕົວເລືອກນີ້ຊ່ວຍປະຢັດໄດ້ໜຶ່ງໄບຕ໌ຕໍ່ເຟຣມສຳລັບ ເຟຣມສ່ວນໃຫຍ່."

