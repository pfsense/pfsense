msgstr "ຄ່າປະຈຸບັນ"

#: src/usr/local/www/system_certmanager_renew.php:220
msgid "Secure Value"
msgstr "ຄ່າທີ່ປອດໄພ"

#: src/usr/local/www/system_certmanager_renew.php:221
msgid "Would Change"
msgstr "ຈະມີການປ່ຽນແປງ"

#: src/usr/local/www/system_certmanager_renew.php:228 src/usr/local/www/system_certmanager_renew.php:231
msgid "Days"
msgstr "ວັນ"

