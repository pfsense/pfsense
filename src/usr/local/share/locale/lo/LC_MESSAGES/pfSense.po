#: src/usr/local/www/system_advanced_admin.php:120
msgid "Certificates known to be incompatible with use for HTTPS are not included in this list."
msgstr "ໃບຢັ້ງຢືນທີ່ຮູ້ກັນວ່າບໍ່ສາມາດໃຊ້ງານກັບ HTTPS ໄດ້ ຈະບໍ່ຖືກລວມເຂົ້າໃນລາຍການນີ້."

#: src/usr/local/www/system_advanced_admin.php:124
msgid "TCP port"
msgstr "ພອດ TCP"

#: src/usr/local/www/system_advanced_admin.php:128
msgid "Enter a custom port number for the webConfigurator above to override the default (80 for HTTP, 443 for HTTPS). Changes will take effect immediately after save."
msgstr "ປ້ອນໝາຍເລກພອດທີ່ກຳນົດເອງສຳລັບ webConfigurator ເພື່ອຂ້າມຄ່າເລີ່ມຕົ້ນ (80 ສຳລັບ HTTP, 443 ສຳລັບ HTTPS). ການປ່ຽນແປງຈະມີຜົນທັນທີຫຼັງຈາກບັນທຶກ."

#: src/usr/local/www/system_advanced_admin.php:134
msgid "Max Processes"
msgstr "ຂະບວນການສູງສຸດ (Max Processes)"

#: src/usr/local/www/system_advanced_admin.php:137
msgid "Enter the number of webConfigurator processes to run. This defaults to 2. Increasing this will allow more users/browsers to access the GUI concurrently."
msgstr "ປ້ອນຈຳນວນຂະບວນການຂອງ webConfigurator ທີ່ຈະໃຫ້ເຮັດວຽກ. ຄ່າເລີ່ມຕົ້ນແມ່ນ 2. ການເພີ່ມຄ່ານີ້ຈະຊ່ວຍໃຫ້ຜູ້ໃຊ້/ບຣາວເຊີ ສາມາດເຂົ້າເຖິງ GUI ພ້ອມກັນໄດ້ຫຼາຍຂຶ້ນ."

#: src/usr/local/www/system_advanced_admin.php:143
msgid "WebGUI redirect"
msgstr "ການຣີໄດເຣັກ WebGUI"

#: src/usr/local/www/system_advanced_admin.php:146
msgid "When this is unchecked, access to the webConfigurator is always permitted even on port 80, regardless of the listening port configured. Check this box to disable this automatically added redirect rule."
msgstr "ເມື່ອບໍ່ໄດ້ເລືອກຊ່ອງນີ້, ການເຂົ້າເຖິງ webConfigurator ຈະຖືກອະນຸຍາດສະເໝີ ແມ່ນແຕ່ຜ່ານພອດ 80, ໂດຍບໍ່ສົນວ່າຈະຕັ້ງຄ່າພອດທີ່ລໍຖ້າຮັບຂໍ້ມູນເປັນພອດໃດ. ເລືອກຊ່ອງນີ້ເພື່ອປິດການນຳໃຊ້ກົດການຣີໄດເຣັກທີ່ຖືກເພີ່ມໃຫ້ໂດຍອັດຕະໂນມັດ."

#: src/usr/local/www/system_advanced_admin.php:152
msgid "HSTS"
msgstr "HSTS"

#: src/usr/local/www/system_advanced_admin.php:155
msgid "When this is unchecked, Strict-Transport-Security HTTPS response header is sent by the webConfigurator to the browser. This will force the browser to use only HTTPS for future requests to the firewall FQDN. Check this box to disable HSTS. (NOTE: Browser-specific steps are required for disabling to take effect when the browser already visited the FQDN while HSTS was enabled.)"
msgstr "ເມື່ອບໍ່ໄດ້ເລືອກຊ່ອງນີ້, webConfigurator ຈະສົ່ງ Strict-Transport-Security HTTPS response header ໄປຫາບຣາວເຊີ. ສິ່ງນີ້ຈະບັງຄັບໃຫ້ບຣາວເຊີໃຊ້ສະເພາະ HTTPS ເທົ່ານັ້ນໃນການຮ້ອງຂໍຂໍ້ມູນໄປຫາ FQDN ຂອງໄຟວໍໃນອະນາຄົດ. ເລືອກຊ່ອງນີ້ເພື່ອປິດໃຊ້ງານ HSTS. (ໝາຍເຫດ: ອາດຈະຕ້ອງໄດ້ເຮັດບາງຂັ້ນຕອນໃນບຣາວເຊີເພື່ອໃຫ້ການປິດໃຊ້ງານມີຜົນ ຖ້າບຣາວເຊີນັ້ນເຄີຍເຂົ້າເຖິງ FQDN ໃນຂະນະທີ່ HSTS ຍັງເປີດຢູ່.)"

#: src/usr/local/www/system_advanced_admin.php:163
msgid "OCSP Must-Staple"
msgstr "OCSP Must-Staple"

#: src/usr/local/www/system_advanced_admin.php:166
msgid "When this is checked, OCSP Stapling is forced on in nginx. Remember to upload your certificate as a full chain, not just the certificate, or this option will be ignored by nginx."
msgstr "ເມື່ອເລືອກຊ່ອງນີ້, ຈະມີການບັງຄັບໃຊ້ OCSP Stapling ໃນ nginx. ຢ່າລືມອັບໂຫຼດໃບຢັ້ງຢືນຂອງທ່ານແບບເຕັມສາຍ (full chain), ບໍ່ແມ່ນສະເພາະໃບຢັ້ງຢືນດຽວ, ຖ້າບໍ່ດັ່ງນັ້ນ nginx ຈະບໍ່ສົນໃຈຕົວເລືອກນີ້."

#: src/usr/local/www/system_advanced_admin.php:172
msgid "WebGUI Login Autocomplete"
msgstr "ການເຕີມຂໍ້ມູນການເຂົ້າສູ່ລະບົບ WebGUI ອັດຕະໂນມັດ"

#: src/usr/local/www/system_advanced_admin.php:175
msgid "When this is checked, login credentials for the webConfigurator may be saved by the browser. While convenient, some security standards require this to be disabled. Check this box to enable autocomplete on the login form so that browsers will prompt to save credentials (NOTE: Some browsers do not respect this option)."
msgstr "ເມື່ອເລືອກຊ່ອງນີ້, ຂໍ້ມູນການເຂົ້າສູ່ລະບົບສຳລັບ webConfigurator ອາດຈະຖືກບັນທຶກໄວ້ໂດຍບຣາວເຊີ. ເຖິງວ່າມັນຈະສະດວກ, ແຕ່ບາງມາດຕະຖານຄວາມປອດໄພຮຽກຮ້ອງໃຫ້ປິດໃຊ້ງານ. ເລືອກຊ່ອງນີ້ເພື່ອເປີດໃຊ້ການເຕີມຂໍ້ມູນອັດຕະໂນມັດໃນຟອມເຂົ້າສູ່ລະບົບ ເພື່ອໃຫ້ບຣາວເຊີຖາມຫາການບັນທຶກຂໍ້ມູນ (ໝາຍເຫດ: ບາງບຣາວເຊີອາດຈະບໍ່ຮອງຮັບຕົວເລືອກນີ້)."

#: src/usr/local/www/system_advanced_admin.php:183
msgid "WebGUI login messages"
msgstr "ຂໍ້ຄວາມການເຂົ້າສູ່ລະບົບ WebGUI"

#: src/usr/local/www/system_advanced_admin.php:186
msgid "When this is checked, successful logins to the webConfigurator will not be logged."
msgstr "ເມື່ອເລືອກຊ່ອງນີ້, ການເຂົ້າສູ່ລະບົບ webConfigurator ທີ່ສຳເລັດແລ້ວ ຈະບໍ່ຖືກບັນທຶກລົງໃນລັອກ (Log)."

#: src/usr/local/www/system_advanced_admin.php:197
msgid "Anti-lockout"
msgstr "ລະບົບປ້ອງກັນການຖືກລັອກ (Anti-lockout)"

#: src/usr/local/www/system_advanced_admin.php:200
#, php-format
msgid "When this is unchecked, access to the webConfigurator on the %1$s interface is always permitted, regardless of the user-defined firewall rule set. Check this box to disable this automatically added rule, so access to the webConfigurator is controlled by the user-defined firewall rules (ensure a firewall rule is in place that allows access, to avoid being locked out!) %2$sHint: the &quot;Set interface(s) IP address&quot; option in the console menu resets this setting as well.%3$s"
msgstr "ເມື່ອບໍ່ໄດ້ເລືອກຊ່ອງນີ້, ການເຂົ້າເຖິງ webConfigurator ຜ່ານອິນເຕີເຟສ %1$s ຈະຖືກອະນຸຍາດສະເໝີ, ໂດຍບໍ່ສົນວ່າຈະຕັ້ງກົດໄຟວໍໄວ້ແນວໃດ. ເລືອກຊ່ອງນີ້ເພື່ອປິດໃຊ້ງານກົດທີ່ຖືກເພີ່ມໃຫ້ອັດຕະໂນມັດນີ້, ເພື່ອໃຫ້ການເຂົ້າເຖິງ webConfigurator ຖືກຄວບຄຸມໂດຍກົດໄຟວໍທີ່ຜູ້ໃຊ້ກຳນົດເອງ (ກະລຸນາໝັ້ນໃຈວ່າມີກົດໄຟວໍທີ່ອະນຸຍາດໃຫ້ເຂົ້າເຖິງໄດ້ແລ້ວ ເພື່ອຫຼີກເວັ້ນການຖືກລັອກບໍ່ໃຫ້ເຂົ້າລະບົບ!) %2$sຄຳແນະນຳ: ຕົວເລືອກ &quot;Set interface(s) IP address&quot; ໃນເມນູຄອນໂຊນ ກໍຈະຣີເຊັດຄ່ານີ້ຄືກັນ. %3$s"

#: src/usr/local/www/system_advanced_admin.php:210
msgid "DNS Rebind Check"
msgstr "ການກວດສອບ DNS Rebind"

#: src/usr/local/www/system_advanced_admin.php:213
#, php-format
msgid "When this is unchecked, the system is protected against %1$sDNS Rebinding attacks%2$s. This blocks private IP responses from the configured DNS servers. Check this box to disable this protection if it interferes with webConfigurator access or name resolution in the environment."
msgstr "ເມື່ອບໍ່ໄດ້ເລືອກຊ່ອງນີ້, ລະບົບຈະໄດ້ຮັບການປ້ອງກັນຈາກ %1$sການໂຈມຕີແບບ DNS Rebinding%2$s. ສິ່ງນີ້ຈະບລັອກການຕອບສະໜອງ IP ສ່ວນຕົວຈາກເຊີບເວີ DNS ທີ່ຕັ້ງຄ່າໄວ້. ເລືອກຊ່ອງນີ້ເພື່ອປິດການປ້ອງກັນ ຖ້າມັນລົບກວນການເຂົ້າເຖິງ webConfigurator ຫຼື ການແກ້ໄຂຊື່ໃນສະພາບແວດລ້ອມຂອງທ່ານ."

#: src/usr/local/www/system_advanced_admin.php:221
msgid "Alternate Hostnames"
msgstr "ຊື່ໂຮສສຳຮອງ (Alternate Hostnames)"

#: src/usr/local/www/system_advanced_admin.php:224
msgid "Alternate Hostnames for DNS Rebinding and HTTP_REFERER Checks. Specify alternate hostnames by which the router may be queried, to bypass the DNS Rebinding Attack checks. Separate hostnames with spaces."
msgstr "ຊື່ໂຮສສຳຮອງສຳລັບການກວດສອບ DNS Rebinding ແລະ HTTP_REFERER. ລະບຸຊື່ໂຮສສຳຮອງທີ່ອະນຸຍາດໃຫ້ເລົາເຕີຖືກສອບຖາມ ເພື່ອຂ້າມການກວດສອບການໂຈມຕີ DNS Rebinding. ແຍກແຕ່ລະຊື່ໂຮສດ້ວຍຍະຫວ່າງ."

#: src/usr/local/www/system_advanced_admin.php:230
msgid "Browser HTTP_REFERER enforcement"
msgstr "ການບັງຄັບໃຊ້ HTTP_REFERER ຂອງບຣາວເຊີ"

#: src/usr/local/www/system_advanced_admin.php:233
#, php-format
msgid "When this is unchecked, access to the webConfigurator is protected against HTTP_REFERER redirection attempts. Check this box to disable this protection if it interferes with webConfigurator access in certain corner cases such as using external scripts to interact with this system. More information on HTTP_REFERER is available from %1$sWikipedia%2$s"
msgstr "ເມື່ອບໍ່ໄດ້ເລືອກຊ່ອງນີ້, ການເຂົ້າເຖິງ webConfigurator ຈະໄດ້ຮັບການປ້ອງກັນຈາກຄວາມພະຍາຍາມຣີໄດເຣັກຜ່ານ HTTP_REFERER. ເລືອກຊ່ອງນີ້ເພື່ອປິດການປ້ອງກັນ ຖ້າມັນລົບກວນການເຂົ້າເຖິງ webConfigurator ໃນບາງກໍລະນີ ເຊັ່ນ ການໃຊ້ສະຄຣິບພາຍນອກເພື່ອຕິດຕໍ່ກັບລະບົບນີ້. ສາມາດເບິ່ງຂໍ້ມູນເພີ່ມເຕີມກ່ຽວກັບ HTTP_REFERER ໄດ້ຈາກ %1$sWikipedia%2$s"

#: src/usr/local/www/system_advanced_admin.php:243
msgid "Secure Shell"
msgstr "Secure Shell (SSH)"

#: src/usr/local/www/system_advanced_admin.php:247
msgid "Secure Shell Server"
msgstr "ເຊີບເວີ Secure Shell"

#: src/usr/local/www/system_advanced_admin.php:254
msgid "SSHd Key Only"
msgstr "ໃຊ້ສະເພາະຄີ (Key) SSHd ເທົ່ານັ້ນ"

#: src/usr/local/www/system_advanced_admin.php:261
#, php-format
msgid "When set to %3$sPublic Key Only%4$s, SSH access requires authorized keys and these keys must be configured for each %1$suser%2$s that has been granted secure shell access. If set to %3$sRequire Both Password and Public Key%4$s, the SSH daemon requires both authorized keys %5$sand%6$s valid passwords to gain access. The default %3$sPassword or Public Key%4$s setting allows either a valid password or a valid authorized key to login."
msgstr "ເມື່ອຕັ້ງເປັນ %3$sPublic Key Only%4$s, ການເຂົ້າເຖິງ SSH ຈະຕ້ອງໃຊ້ຄີທີ່ໄດ້ຮັບອະນຸຍາດ ແລະ ຄີເຫຼົ່ານີ້ຕ້ອງຖືກຕັ້ງຄ່າສຳລັບແຕ່ລະ %1$sຜູ້ໃຊ້%2$s ທີ່ໄດ້ຮັບສິດເຂົ້າເຖິງ. ຖ້າຕັ້ງເປັນ %3$sRequire Both Password and Public Key%4$s, ບໍລິການ SSH ຈະຕ້ອງໃຊ້ທັງຄີ %5$sແລະ%6$s ລະຫັດຜ່ານທີ່ຖືກຕ້ອງເພື່ອເຂົ້າລະບົບ. ຄ່າເລີ່ມຕົ້ນ %3$sPassword or Public Key%4$s ຈະອະນຸຍາດໃຫ້ໃຊ້ຢ່າງໃດຢ່າງໜຶ່ງກໍໄດ້."

#: src/usr/local/www/system_advanced_admin.php:270
msgid "Allow Agent Forwarding"
msgstr "ອະນຸຍາດ Agent Forwarding"

#: src/usr/local/www/system_advanced_admin.php:277
msgid "SSH port"
msgstr "ພອດ SSH"

#: src/usr/local/www/system_advanced_admin.php:281
msgid "Note: Leave this blank for the default of 22."
msgstr "ໝາຍເຫດ: ປ່ອຍຫວ່າງໄວ້ເພື່ອໃຊ້ຄ່າເລີ່ມຕົ້ນແມ່ນ 22."

#: src/usr/local/www/system_advanced_admin.php:284
msgid "Login Protection"
msgstr "ການປ້ອງກັນການເຂົ້າສູ່ລະບົບ"

#: src/usr/local/www/system_advanced_admin.php:292
msgid "Block attackers when their cumulative attack score exceeds threshold.  Most attacks have a score of 10."
msgstr "ບລັອກຜູ້ໂຈມຕີເມື່ອຄະແນນການໂຈມຕີສະສົມເກີນກຳນົດ. ການໂຈມຕີສ່ວນໃຫຍ່ມີຄະແນນແມ່ນ 10."

#: src/usr/local/www/system_advanced_admin.php:301
#, php-format
msgid "Block attackers for initially blocktime seconds after exceeding threshold. Subsequent blocks increase by a factor of 1.5.%sAttacks are unblocked at random intervals, so actual block times will be longer."
msgstr "ບລັອກຜູ້ໂຈມຕີເປັນເວລາ blocktime ວິນາທີໃນເບື້ອງຕົ້ນຫຼັງຈາກເກີນກຳນົດ. ການບລັອກຄັ້ງຕໍ່ໄປຈະເພີ່ມຂຶ້ນ 1.5 ເທົ່າ. %sການປົດບລັອກຈະເກີດຂຶ້ນແບບສຸ່ມໄລຍະເວລາ, ດັ່ງນັ້ນເວລາບລັອກຕົວຈິງອາດຈະດົນກວ່າທີ່ກຳນົດ."

#: src/usr/local/www/system_advanced_admin.php:312
msgid "Remember potential attackers for up to detection_time seconds before resetting their score."
msgstr "ຈື່ຈຳຜູ້ທີ່ອາດເປັນຜູ້ໂຈມຕີໄດ້ສູງສຸດ detection_time ວິນາທີ ກ່ອນທີ່ຈະຣີເຊັດຄະແນນຂອງພວກເຂົາ."

