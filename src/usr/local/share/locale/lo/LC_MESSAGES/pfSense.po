msgid "Enable DHCPv6 server on interface "
msgstr "ເປີດໃຊ້ງານເຊີເວີ DHCPv6 ໃນອິນເຕີເຟສ "

#: src/usr/local/www/services_dhcpv6.php:647
msgid " bits"
msgstr " ບິດ"

#: src/usr/local/www/services_dhcpv6.php:652
msgid " to "
msgstr " ຫາ "

