#: src/etc/inc/openvpn.inc:128
msgid "Decompress incoming, do not compress outgoing (Asymmetric)"
msgstr "ຄາຍການບີບອັດຂາເຂົ້າ, ບໍ່ບີບອັດຂາອອກ (ບໍ່ສົມມາດ)"

#: src/etc/inc/openvpn.inc:129
msgid "Refuse any non-stub compression (Most secure)"
msgstr "ປະຕິເສດການບີບອັດທີ່ບໍ່ແມ່ນ stub (ປອດໄພທີ່ສຸດ)"

#: src/etc/inc/openvpn.inc:130
msgid "Compress packets (WARNING: Potentially dangerous!)"
msgstr "ບີບອັດແພັກເກັດ (ຄຳເຕືອນ: ອາດຈະເປັນອັນຕະລາຍ!)"

#: src/etc/inc/openvpn.inc:135
msgid "Disable Compression [Omit Preference]"
msgstr "ປິດການບີບອັດ [ຂ້າມຄວາມມັກ]"

#: src/etc/inc/openvpn.inc:136
msgid "Disable Compression, retain compression packet framing [compress]"
msgstr "ປິດການບີບອັດ, ແຕ່ຄົງຮູບແບບເຟຣມການບີບອັດ [compress]"

#: src/etc/inc/openvpn.inc:137
msgid "Enable Compression (stub) [compress stub]"
msgstr "ເປີດການບີບອັດ (stub) [compress stub]"

#: src/etc/inc/openvpn.inc:138
msgid "Enable Compression (stub v2) [compress stub-v2]"
msgstr "ເປີດການບີບອັດ (stub v2) [compress stub-v2]"

#: src/etc/inc/openvpn.inc:139
msgid "LZ4 Compression [compress lz4]"
msgstr "ການບີບອັດ LZ4 [compress lz4]"

#: src/etc/inc/openvpn.inc:140
msgid "LZ4 Compression v2 [compress lz4-v2]"
msgstr "ການບີບອັດ LZ4 v2 [compress lz4-v2]"

#: src/etc/inc/openvpn.inc:141
msgid "LZO Compression [compress lzo, equivalent to comp-lzo yes for compatibility]"
msgstr "ການບີບອັດ LZO [compress lzo, ທຽບເທົ່າກັບ comp-lzo yes ເພື່ອຄວາມເຂົ້າກັນໄດ້]"

#: src/etc/inc/openvpn.inc:142
msgid "Omit Preference, + Disable Adaptive LZO Compression [Legacy style, comp-noadapt]"
msgstr "ຂ້າມຄວາມມັກ, + ປິດການບີບອັດ LZO ແບບປັບຕົວ [ແບບເກົ່າ, comp-noadapt]"

#: src/etc/inc/openvpn.inc:143
msgid "Adaptive LZO Compression [Legacy style, comp-lzo adaptive]"
msgstr "ການບີບອັດ LZO ແບບປັບຕົວ [ແບບເກົ່າ, comp-lzo adaptive]"

#: src/etc/inc/openvpn.inc:144
msgid "LZO Compression [Legacy style, comp-lzo yes]"
msgstr "ການບີບອັດ LZO [ແບບເກົ່າ, comp-lzo yes]"

#: src/etc/inc/openvpn.inc:145
msgid "No LZO Compression [Legacy style, comp-lzo no]"
msgstr "ບໍ່ມີການບີບອັດ LZO [ແບບເກົ່າ, comp-lzo no]"

