#: src/usr/local/www/system.php:213
#, php-format
msgid "The IPv6 gateway \"%1$s\" can not be specified for IPv4 DNS server \"%2$s\"."
msgstr "ບໍ່ສາມາດກຳນົດ IPv6 ເກດເວ \"%1$s\" ໃຫ້ກັບ IPv4 DNS ເຊີເວີ \"%2$s\" ໄດ້."

#: src/usr/local/www/system.php:216
#, php-format
msgid "The IPv4 gateway \"%1$s\" can not be specified for IPv6 DNS server \"%2$s\"."
msgstr "ບໍ່ສາມາດກຳນົດ IPv4 ເກດເວ \"%1$s\" ໃຫ້ກັບ IPv6 DNS ເຊີເວີ \"%2$s\" ໄດ້."

#: src/usr/local/www/system.php:229
msgid "Each configured DNS server must have a unique IP address. Remove the duplicated IP."
msgstr "DNS ເຊີເວີແຕ່ລະຕົວຕ້ອງມີ IP ທີ່ບໍ່ຊ້ຳກັນ. ກະລຸນາລົບ IP ທີ່ຊ້ຳກັນອອກ."

#: src/usr/local/www/system.php:241
#, php-format
msgid "A gateway cannot be specified for %s because that IP address is part of a directly connected subnet %s. To use that nameserver, change its Gateway to `none`."
msgstr "ບໍ່ສາມາດລະບຸປະຕູເຊື່ອມຕໍ່ (Gateway) ສຳລັບ %s ໄດ້ ເພາະທີ່ຢູ່ IP ນັ້ນເປັນສ່ວນໜຶ່ງຂອງເຄືອຂ່າຍຍ່ອຍ (Subnet) %s ທີ່ເຊື່ອມຕໍ່ໂດຍກົງ. ເພື່ອໃຊ້ງານເນມເຊີບເວີ (Nameserver) ນັ້ນ, ໃຫ້ປ່ຽນ Gateway ຂອງມັນເປັນ `none`."

#: src/usr/local/www/system.php:496 src/usr/local/www/head.inc:250
msgid "General Setup"
msgstr "ການຕັ້ງຄ່າທົ່ວໄປ"

#: src/usr/local/www/system.php:518
msgid "Name of the firewall host, without domain part"
msgstr "ຊື່ຂອງໂຮສໄຟວໍ (Firewall Host), ໂດຍບໍ່ລວມສ່ວນຂອງໂດເມນ"

#: src/usr/local/www/system.php:526
#, php-format
msgid "Do not end the domain name with '.local' as the final part (Top Level Domain, TLD), The 'local' TLD is %1$swidely used%2$s by mDNS (e.g. Avahi, Bonjour, Rendezvous, Airprint, Airplay) and some Windows systems and networked devices. These will not network correctly if the router uses 'local' as its TLD. Alternative TLDs such as 'local.lan' or 'mylocal' are safe."
msgstr "ຫ້າມລົງທ້າຍຊື່ໂດເມນດ້ວຍ '.local' ເປັນສ່ວນທ້າຍ (Top Level Domain, TLD), ເພາະ 'local' TLD ແມ່ນ %1$sຖືກນຳໃຊ້ຢ່າງກວ້າງຂວາງ%2$s ໂດຍ mDNS (ເຊັ່ນ Avahi, Bonjour, Rendezvous, Airprint, Airplay) ແລະ ບາງລະບົບ Windows ລວມທັງອຸປະກອນເຄືອຂ່າຍຕ່າງໆ. ອຸປະກອນເຫຼົ່ານີ້ຈະບໍ່ສາມາດເຊື່ອມຕໍ່ເຄືອຂ່າຍໄດ້ຢ່າງຖືກຕ້ອງ ຖ້າເລົາເຕີໃຊ້ 'local' ເປັນ TLD. ຕົວເລືອກ TLD ອື່ນໆ ເຊັ່ນ 'local.lan' ຫຼື 'mylocal' ແມ່ນມີຄວາມປອດໄພກວ່າ."

#: src/usr/local/www/system.php:537
msgid "DNS Server Settings"
msgstr "ການຕັ້ງຄ່າເຊີບເວີ DNS"

#: src/usr/local/www/system.php:545
msgid "Enter IP addresses to be used by the system for DNS resolution."
msgstr "ປ້ອນທີ່ຢູ່ IP ທີ່ຈະໃຫ້ລະບົບນຳໃຊ້ໃນການແກ້ໄຂຊື່ DNS (DNS resolution)."

#: src/usr/local/www/system.php:546
msgid "These are also used for the DHCP service, DNS Forwarder and DNS Resolver when it has DNS Query Forwarding enabled."
msgstr "ຄ່າເຫຼົ່ານີ້ຍັງຖືກນຳໃຊ້ສຳລັບບໍລິການ DHCP, DNS Forwarder ແລະ DNS Resolver ເມື່ອມີການເປີດໃຊ້ງານ DNS Query Forwarding."

#: src/usr/local/www/system.php:547
msgid "Enter the DNS Server Hostname for TLS Verification in the DNS Resolver (optional)."
msgstr "ປ້ອນຊື່ໂຮສ (Hostname) ຂອງເຊີບເວີ DNS ສຳລັບການກວດສອບ TLS ໃນ DNS Resolver (ບໍ່ບັງຄັບ)."

#: src/usr/local/www/system.php:548
msgid "Optionally select the gateway for each DNS server."
msgstr "ເລືອກປະຕູເຊື່ອມຕໍ່ (Gateway) ສຳລັບແຕ່ລະເຊີບເວີ DNS (ບໍ່ບັງຄັບ)."

#: src/usr/local/www/system.php:549
msgid "When using multiple WAN connections there should be at least one unique DNS server per gateway."
msgstr "ເມື່ອໃຊ້ການເຊື່ອມຕໍ່ WAN ຫຼາຍສາຍ, ຄວນມີເຊີບເວີ DNS ຢ່າງໜ້ອຍໜຶ່ງຕົວທີ່ບໍ່ຊ້ຳກັນຕໍ່ແຕ່ລະ Gateway."

#: src/usr/local/www/system.php:571
msgid "DNS Hostname"
msgstr "ຊື່ໂຮສ DNS"

#: src/usr/local/www/system.php:612
