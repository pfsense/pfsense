#: src/etc/inc/priv/user.priv.inc:22
msgid "Allow access to all pages required for the dashboard."
msgstr "ອະນຸຍາດໃຫ້ເຂົ້າເຖິງທຸກໜ້າທີ່ຈຳເປັນສຳລັບ dashboard."

#: src/etc/inc/priv/user.priv.inc:33
msgid "WebCfg - Dashboard widgets (direct access)."
msgstr "WebCfg - Dashboard widgets (ການເຂົ້າເຖິງໂດຍກົງ)."

#: src/etc/inc/priv/user.priv.inc:34
msgid "Allow direct access to all Dashboard widget pages, required for some widgets using AJAX."
msgstr "ອະນຸຍາດໃຫ້ເຂົ້າເຖິງທຸກໜ້າ Dashboard widget ໂດຍກົງ, ເຊິ່ງຈຳເປັນສຳລັບບາງ widget ທີ່ໃຊ້ AJAX."

#: src/etc/inc/priv/user.priv.inc:39
