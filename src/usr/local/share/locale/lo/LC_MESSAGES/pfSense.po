#: src/usr/local/www/services_dhcpv6.php:298 src/usr/local/www/services_dhcp.php:343
msgid "Range From and Range To must both be entered."
msgstr "ຕ້ອງປ້ອນທັງຊ່ວງເລີ່ມຕົ້ນ ແລະ ຊ່ວງສິ້ນສຸດ."

#: src/usr/local/www/services_dhcpv6.php:301
msgid "A valid IPv6 address must be specified for the gateway."
msgstr "ຕ້ອງລະບຸທີ່ຢູ່ IPv6 ທີ່ຖືກຕ້ອງສຳລັບເກດເວ."

#: src/usr/local/www/services_dhcpv6.php:307 src/usr/local/www/services_router_advertisements.php:161
msgid "A valid IPv6 address must be specified for each of the DNS servers."
msgstr "ຕ້ອງລະບຸທີ່ຢູ່ IPv6 ທີ່ຖືກຕ້ອງສຳລັບເຊີເວີ DNS ແຕ່ລະອັນ."

#: src/usr/local/www/services_dhcpv6.php:311 src/usr/local/www/services_dhcp.php:364 src/usr/local/www/services_dhcp_edit.php:279
msgid "The default lease time must be at least 60 seconds."
msgstr "ເວລາເຊົ່າໃຊ້ເລີ່ມຕົ້ນຕ້ອງມີຢ່າງໜ້ອຍ 60 ວິນາທີ."

#: src/usr/local/www/services_dhcpv6.php:314 src/usr/local/www/services_dhcp.php:392 src/usr/local/www/services_dhcp_edit.php:282
msgid "The maximum lease time must be at least 60 seconds and higher than the default lease time."
msgstr "ເວລາເຊົ່າໃຊ້ສູງສຸດຕ້ອງມີຢ່າງໜ້ອຍ 60 ວິນາທີ ແລະ ຕ້ອງຫຼາຍກວ່າເວລາເຊົ່າໃຊ້ເລີ່ມຕົ້ນ."

#: src/usr/local/www/services_dhcpv6.php:318 src/usr/local/www/services_dhcp.php:396 src/usr/local/www/services_dhcp_edit.php:286
msgid "A valid domain name must be specified for the dynamic DNS registration."
msgstr "ຕ້ອງລະບຸຊື່ໂດເມນທີ່ຖືກຕ້ອງສຳລັບການລົງທະບຽນ DNS ແບບໄດນາມິກ."

#: src/usr/local/www/services_dhcpv6.php:321 src/usr/local/www/services_dhcp.php:399 src/usr/local/www/services_dhcp_edit.php:289
msgid "A valid primary domain name server IP address must be specified for the dynamic domain name."
msgstr "ຕ້ອງລະບຸ IP ຂອງເຊີເວີຊື່ໂດເມນຫຼັກທີ່ຖືກຕ້ອງສຳລັບຊື່ໂດເມນແບບໄດນາມິກ."

#: src/usr/local/www/services_dhcpv6.php:324 src/usr/local/www/services_dhcp.php:402 src/usr/local/www/services_dhcp_edit.php:292
msgid "A valid secondary domain name server IP address must be specified for the dynamic domain name."
msgstr "ຕ້ອງລະບຸ IP ຂອງເຊີເວີຊື່ໂດເມນສຳຮອງທີ່ຖືກຕ້ອງສຳລັບຊື່ໂດເມນແບບໄດນາມິກ."

#: src/usr/local/www/services_dhcpv6.php:327 src/usr/local/www/services_dhcp.php:405 src/usr/local/www/services_dhcp_edit.php:295
msgid "A valid domain key name, algorithm and secret must be specified."
msgstr "ຕ້ອງລະບຸຊື່ຄີໂດເມນ, ອັນກໍລິທຶມ ແລະ ລະຫັດລັບທີ່ຖືກຕ້ອງ."

#: src/usr/local/www/services_dhcpv6.php:330 src/usr/local/www/services_dhcp.php:408 src/usr/local/www/services_dhcp_edit.php:298
msgid "The domain key name may only contain the characters a-z, A-Z, 0-9, '-', '_' and '.'"
msgstr "ຊື່ຄີໂດເມນຕ້ອງປະກອບດ້ວຍຕົວອັກສອນ a-z, A-Z, 0-9, '-', '_' ແລະ '.' ເທົ່ານັ້ນ."

#: src/usr/local/www/services_dhcpv6.php:333 src/usr/local/www/services_dhcp.php:411 src/usr/local/www/services_dhcp_edit.php:301
msgid "The domain key secret must be a Base64 encoded value."
msgstr "ລະຫັດລັບຄີໂດເມນຕ້ອງເປັນຄ່າທີ່ເຂົ້າລະຫັດ Base64."

#: src/usr/local/www/services_dhcpv6.php:340 src/usr/local/www/services_router_advertisements.php:167 src/usr/local/www/services_dhcp.php:418 src/usr/local/www/services_dhcp_edit.php:308
msgid "A valid domain search list must be specified."
msgstr "ຕ້ອງລະບຸລາຍການຄົ້ນຫາໂດເມນທີ່ຖືກຕ້ອງ."

#: src/usr/local/www/services_dhcpv6.php:349
msgid "A valid IPv6 address must be specified for the primary/secondary NTP servers."
msgstr "ຕ້ອງລະບຸທີ່ຢູ່ IPv6 ທີ່ຖືກຕ້ອງສຳລັບເຊີເວີ NTP ຫຼັກ/ສຳຮອງ."

#: src/usr/local/www/services_dhcpv6.php:352 src/usr/local/www/services_dhcp.php:438 src/usr/local/www/services_dhcp_edit.php:320
msgid "A valid domain name must be specified for the DNS domain."
msgstr "ຕ້ອງລະບຸຊື່ໂດເມນທີ່ຖືກຕ້ອງສຳລັບໂດເມນ DNS."

#: src/usr/local/www/services_dhcpv6.php:355
msgid "A valid IPv6 address or hostname must be specified for the TFTP server."
msgstr "ຕ້ອງລະບຸທີ່ຢູ່ IPv6 ຫຼື ຊື່ໂຮສທີ່ຖືກຕ້ອງສຳລັບເຊີເວີ TFTP."

#: src/usr/local/www/services_dhcpv6.php:358
msgid "A valid URL must be specified for the network bootfile."
msgstr "ຕ້ອງລະບຸ URL ທີ່ຖືກຕ້ອງສຳລັບໄຟລ໌ບູດເຄືອຂ່າຍ."

#: src/usr/local/www/services_dhcpv6.php:366
#, php-format
msgid "The subnet range cannot overlap with virtual IPv6 address %s."
msgstr "ຊ່ວງຊັບເນັດບໍ່ສາມາດຊ້ອນທັບກັບທີ່ຢູ່ IPv6 ສະເໝືອນ %s ໄດ້."

#: src/usr/local/www/services_dhcpv6.php:383 src/usr/local/www/services_dhcp.php:510
#, php-format
msgid "The DHCP relay on the %s interface must be disabled before enabling the DHCP server."
msgstr "ຕ້ອງປິດໃຊ້ງານ DHCP relay ໃນອິນເຕີເຟສ %s ກ່ອນທີ່ຈະເປີດໃຊ້ງານ DHCP ເຊີເວີ."

#: src/usr/local/www/services_dhcpv6.php:395 src/usr/local/www/services_dhcp.php:555
msgid "The specified range lies outside of the current subnet."
msgstr "ຊ່ວງທີ່ລະບຸຢູ່ພາຍນອກຊັບເນັດປັດຈຸບັນ."

#: src/usr/local/www/services_dhcpv6.php:400 src/usr/local/www/services_dhcp.php:550
msgid "The range is invalid (first element higher than second element)."
msgstr "ຊ່ວງບໍ່ຖືກຕ້ອງ (ຄ່າທຳອິດສູງກວ່າຄ່າທີສອງ)."

#: src/usr/local/www/services_dhcpv6.php:416 src/usr/local/www/services_dhcp.php:589
#, php-format
msgid "The DHCP range cannot overlap any static DHCP mappings."
msgstr "ຊ່ວງ DHCP ບໍ່ສາມາດຊ້ອນທັບກັບການຈັບຄູ່ DHCP ແບບຄົງທີ່ໃດໆ."

