#: src/usr/local/www/interfaces_ppps_edit.php:283
msgid "A valid PPPoE reset month must be specified (1-12) in the Custom PPPoE Periodic reset fields."
msgstr "ຕ້ອງລະບຸເດືອນຣີເຊັດ PPPoE ທີ່ຖືກຕ້ອງ (1-12) ໃນຊ່ອງການຣີເຊັດ PPPoE ແບບກຳນົດເອງ."

#: src/usr/local/www/interfaces_ppps_edit.php:286
msgid "A valid PPPoE reset day of month must be specified (1-31) in the Custom PPPoE Periodic reset fields. No checks are done on valid # of days per month"
msgstr "ຕ້ອງລະບຸວັນທີຣີເຊັດ PPPoE ທີ່ຖືກຕ້ອງ (1-31) ໃນຊ່ອງການຣີເຊັດ PPPoE ແບບກຳນົດເອງ. ບໍ່ມີການກວດສອບຈຳນວນວັນທີ່ຖືກຕ້ອງໃນແຕ່ລະເດືອນ"

#: src/usr/local/www/interfaces_ppps_edit.php:289
msgid "A valid PPPoE reset year must be specified. Don't select a year in the past!"
msgstr "ຕ້ອງລະບຸປີຣີເຊັດ PPPoE ທີ່ຖືກຕ້ອງ. ຫ້າມເລືອກປີທີ່ຜ່ານມາ!"

#: src/usr/local/www/interfaces_ppps_edit.php:297
#, php-format
msgid "A valid local IP address must be specified for %s."
msgstr "ຕ້ອງລະບຸທີ່ຢູ່ IP ພາຍໃນທີ່ຖືກຕ້ອງສຳລັບ %s."

#: src/usr/local/www/interfaces_ppps_edit.php:300
#, php-format
msgid "A valid gateway IP address OR hostname must be specified for %s."
msgstr "ຕ້ອງລະບຸທີ່ຢູ່ IP ເກດເວ ຫຼື ຊື່ໂຮສທີ່ຖືກຕ້ອງສຳລັບ %s."

#: src/usr/local/www/interfaces_ppps_edit.php:303
#, php-format
msgid "The bandwidth value for %s must be an integer."
msgstr "ຄ່າແບນວິດສຳລັບ %s ຕ້ອງເປັນຕົວເລກຖ້ວນ."

#: src/usr/local/www/interfaces_ppps_edit.php:306
#, php-format
msgid "The MTU for %s must be greater than 576 bytes."
msgstr "MTU ສຳລັບ %s ຕ້ອງຫຼາຍກວ່າ 576 ໄບຕ໌."

#: src/usr/local/www/interfaces_ppps_edit.php:309
#, php-format
msgid "The MRU for %s must be greater than 576 bytes."
msgstr "MRU ສຳລັບ %s ຕ້ອງຫຼາຍກວ່າ 576 ໄບຕ໌."

#: src/usr/local/www/interfaces_ppps_edit.php:322
#, php-format
msgid "The MTU (%1$d) is too big for %2$s (maximum allowed with current settings: %3$d)."
msgstr "MTU (%1$d) ໃຫຍ່ເກີນໄປສຳລັບ %2$s (ຄ່າສູງສຸດທີ່ອະນຸຍາດໃນການຕັ້ງຄ່າປະຈຸບັນ: %3$d)."

#: src/usr/local/www/interfaces_ppps_edit.php:484
msgid "Select"
msgstr "ເລືອກ"

#: src/usr/local/www/interfaces_ppps_edit.php:484 src/usr/local/www/interfaces.php:1868
msgid "PPPoE"
msgstr "PPPoE"

#: src/usr/local/www/interfaces_ppps_edit.php:484 src/usr/local/www/interfaces.php:1868
msgid "PPTP"
msgstr "PPTP"

#: src/usr/local/www/interfaces_ppps_edit.php:512
msgid "Bandwidth is set only for MLPPP connections and when links have different bandwidths<br />MTU defaults to 1492<br />MRU will be auto-negotiated by default<br />Set only for MLPPP connections. MRRU will be auto-negotiated by default."
msgstr "ແບນວິດຖືກຕັ້ງຄ່າສະເພາະການເຊື່ອມຕໍ່ MLPPP ແລະ ເມື່ອລິ້ງມີ ແບນວິດທີ່ຕ່າງກັນ<br />ຄ່າ MTU ເລີ່ມຕົ້ນແມ່ນ 1492<br />MRU ຈະຖືກເຈລະຈາໂດຍອັດຕະໂນມັດ ໂດຍເລີ່ມຕົ້ນ<br />ຕັ້ງຄ່າສະເພາະການເຊື່ອມຕໍ່ MLPPP. MRRU ຈະຖືກເຈລະຈາໂດຍອັດຕະໂນມັດໂດຍເລີ່ມຕົ້ນ."

#: src/usr/local/www/interfaces_ppps_edit.php:519 src/usr/local/www/interfaces.php:2807
msgid "PPP Configuration"
msgstr "ການຕັ້ງຄ່າ PPP"

