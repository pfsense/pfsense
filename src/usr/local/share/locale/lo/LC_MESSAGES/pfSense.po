#: src/etc/inc/dyndns.class:2049 src/etc/inc/dyndns.class:2069 src/etc/inc/dyndns.class:2090 src/etc/inc/dyndns.class:2107 src/etc/inc/dyndns.class:2172 src/etc/inc/dyndns.class:2190 src/etc/inc/dyndns.class:2203 src/etc/inc/dyndns.class:2228 src/etc/inc/dyndns.class:2252 src/etc/inc/dyndns.class:2277 src/etc/inc/dyndns.class:2314 src/etc/inc/dyndns.class:2335 src/etc/inc/dyndns.class:2350 src/etc/inc/dyndns.class:2361 src/etc/inc/dyndns.class:2450 src/etc/inc/dyndns.class:2482
msgid "Unknown Response"
msgstr "ການຕອບສະໜອງທີ່ບໍ່ຮູ້ຈັກ"

#: src/etc/inc/dyndns.class:1666
msgid "The DNS-O-Matic username or password specified are incorrect. No updates will be distributed to services until this is resolved."
msgstr "ຊື່ຜູ້ໃຊ້ ຫຼື ລະຫັດຜ່ານ DNS-O-Matic ທີ່ລະບຸບໍ່ຖືກຕ້ອງ. ຈະບໍ່ມີການອັບເດດໃຫ້ບໍລິການຈົນກວ່າບັນຫານີ້ຈະຖືກແກ້ໄຂ."

#: src/etc/inc/dyndns.class:1668
msgid "The hostname specified is not a fully-qualified domain name. If no hostnames included, notfqdn will be returned once."
msgstr "ຊື່ໂຮສ (hostname) ທີ່ລະບຸບໍ່ແມ່ນ FQDN ທີ່ຖືກຕ້ອງ. ຖ້າບໍ່ມີຊື່ໂຮສລວມຢູ່ນຳ, ຈະມີການສົ່ງຄ່າ notfqdn ກັບຄືນມາ."

#: src/etc/inc/dyndns.class:1670
msgid "The hostname passed could not be matched to any services configured. The service field will be blank in the return code."
msgstr "ຊື່ໂຮສທີ່ສົ່ງໄປບໍ່ກົງກັບບໍລິການໃດໆທີ່ຕັ້ງຄ່າໄວ້. ຫ້ອງບໍລິການຈະຫວ່າງເປົ່າໃນລະຫັດທີ່ສົ່ງຄືນມາ."

#: src/etc/inc/dyndns.class:1672
msgid "Up to 20 hosts my be updated. numhost is returned if attempting to update more than 20 or update a round-robin."
msgstr "ສາມາດອັບເດດໄດ້ສູງສຸດ 20 ໂຮສ. ຈະສົ່ງຄ່າ numhost ຄືນມາຖ້າພະຍາຍາມອັບເດດເກີນ 20 ຫຼື ອັບເດດແບບ round-robin."

#: src/etc/inc/dyndns.class:1674
msgid "The hostname is blocked for update abuse."
msgstr "ຊື່ໂຮສຖືກບລັອກເນື່ອງຈາກການອັບເດດທີ່ຜິດປົກກະຕິ (abuse)."

#: src/etc/inc/dyndns.class:1679
msgid "DNS error encountered. Stop updating for 30 minutes."
msgstr "ພົບຂໍ້ຜິດພາດ DNS. ຢຸດການອັບເດດເປັນເວລາ 30 ນາທີ."

#: src/etc/inc/dyndns.class:1694 src/etc/inc/dyndns.class:1887 src/etc/inc/dyndns.class:1890 src/etc/inc/dyndns.class:1908 src/etc/inc/dyndns.class:1918 src/etc/inc/dyndns.class:2017 src/etc/inc/dyndns.class:2030 src/etc/inc/dyndns.class:2044 src/etc/inc/dyndns.class:2063 src/etc/inc/dyndns.class:2084 src/etc/inc/dyndns.class:2140 src/etc/inc/dyndns.class:2187 src/etc/inc/dyndns.class:2200 src/etc/inc/dyndns.class:2216 src/etc/inc/dyndns.class:2240
msgid "IP Address Updated Successfully!"
msgstr "ອັບເດດທີ່ຢູ່ IP ສຳເລັດແລ້ວ!"

#: src/etc/inc/dyndns.class:1704 src/etc/inc/dyndns.class:1724 src/etc/inc/dyndns.class:1741 src/etc/inc/dyndns.class:1758 src/etc/inc/dyndns.class:2097 src/etc/inc/dyndns.class:2162 src/etc/inc/dyndns.class:2323
msgid "Not A FQDN!"
msgstr "ບໍ່ແມ່ນ FQDN!"

#: src/etc/inc/dyndns.class:1706 src/etc/inc/dyndns.class:2325
msgid "No such host"
msgstr "ບໍ່ມີໂຮສນີ້"

#: src/etc/inc/dyndns.class:1708 src/etc/inc/dyndns.class:1726 src/etc/inc/dyndns.class:1743 src/etc/inc/dyndns.class:1760 src/etc/inc/dyndns.class:1929 src/etc/inc/dyndns.class:1943 src/etc/inc/dyndns.class:1956 src/etc/inc/dyndns.class:1969 src/etc/inc/dyndns.class:2164 src/etc/inc/dyndns.class:2261 src/etc/inc/dyndns.class:2304 src/etc/inc/dyndns.class:2327
msgid "No Change In IP Address"
msgstr "ທີ່ຢູ່ IP ບໍ່ມີການປ່ຽນແປງ"

#: src/etc/inc/dyndns.class:1782
msgid "IP address is current, no update performed."
msgstr "ທີ່ຢູ່ IP ເປັນປັດຈຸບັນແລ້ວ, ບໍ່ມີການອັບເດດ."

#: src/etc/inc/dyndns.class:1786
msgid "DNS hostname update successful."
msgstr "ອັບເດດ DNS hostname ສຳເລັດ."

#: src/etc/inc/dyndns.class:1790
msgid "Hostname supplied does not exist."
msgstr "ຊື່ໂຮສທີ່ລະບຸບໍ່ມີຢູ່."

#: src/etc/inc/dyndns.class:1793
msgid "Invalid Username."
msgstr "ຊື່ຜູ້ໃຊ້ບໍ່ຖືກຕ້ອງ."

#: src/etc/inc/dyndns.class:1796
msgid "Invalid Password."
msgstr "ລະຫັດຜ່ານບໍ່ຖືກຕ້ອງ."

#: src/etc/inc/dyndns.class:1799
msgid "Too many updates sent."
msgstr "ສົ່ງການອັບເດດຫຼາຍເກີນໄປ."

#: src/etc/inc/dyndns.class:1802
msgid "Account disabled due to violation of No-IP terms of service."
msgstr "ບັນຊີຖືກປິດເນື່ອງຈາກລະເມີດຂໍ້ກຳນົດການບໍລິການຂອງ No-IP."

#: src/etc/inc/dyndns.class:1805
msgid "Invalid IP. IP Address submitted is improperly formatted or is a private IP address or is on a blacklist."
msgstr "IP ບໍ່ຖືກຕ້ອງ. ທີ່ຢູ່ IP ທີ່ສົ່ງໄປມີຮູບແບບບໍ່ຖືກຕ້ອງ ຫຼື ເປັນ IP ສ່ວນຕົວ ຫຼື ຕິດແບລັກລິສ (blacklist)."

#: src/etc/inc/dyndns.class:1808
msgid "Disabled / Locked Hostname."
msgstr "ຊື່ໂຮສຖືກປິດໃຊ້ງານ / ຖືກລັອກ."

#: src/etc/inc/dyndns.class:1811
msgid "Host updated is configured as a web redirect and no update was performed."
msgstr "ໂຮສທີ່ອັບເດດຖືກຕັ້ງຄ່າເປັນການປ່ຽນເສັ້ນທາງເວັບ (web redirect) ຈຶ່ງບໍ່ມີການອັບເດດ."

#: src/etc/inc/dyndns.class:1814
msgid "Group supplied does not exist."
msgstr "ກຸ່ມທີ່ລະບຸບໍ່ມີຢູ່."

#: src/etc/inc/dyndns.class:1817
msgid "DNS group update is successful."
msgstr "ອັບເດດກຸ່ມ DNS ສຳເລັດ."

#: src/etc/inc/dyndns.class:1821
msgid "DNS group is current, no update performed."
msgstr "ກຸ່ມ DNS ເປັນປັດຈຸບັນແລ້ວ, ບໍ່ມີການອັບເດດ."

#: src/etc/inc/dyndns.class:1825
msgid "Update client support not available for supplied hostname or group."
msgstr "ບໍ່ຮອງຮັບການອັບເດດໄຄເອັນ (client) ສຳລັບຊື່ໂຮສ ຫຼື ກຸ່ມທີ່ລະບຸ."

#: src/etc/inc/dyndns.class:1828
msgid "Hostname supplied does not have offline settings configured."
msgstr "ຊື່ໂຮສທີ່ລະບຸບໍ່ໄດ້ຕັ້ງຄ່າແບບອອບລາຍ (offline)."

#: src/etc/inc/dyndns.class:1831 src/etc/inc/dyndns.class:1834
msgid "Client disabled. Client should exit and not perform any more updates without user intervention."
msgstr "ໄຄເອັນຖືກປິດໃຊ້ງານ. ໄຄເອັນຄວນຢຸດການເຮັດງານ ແລະ ບໍ່ອັບເດດໃດໆຈົນກວ່າຜູ້ໃຊ້ຈະແກ້ໄຂ."

#: src/etc/inc/dyndns.class:1838
msgid "Unknown Response:"
msgstr "ການຕອບສະໜອງທີ່ບໍ່ຮູ້ຈັກ:"

#: src/etc/inc/dyndns.class:1844 src/etc/inc/dyndns.class:1862
msgid "Authentication Failed: Username and/or Password was Incorrect."
msgstr "ການຢືນຢັນຕົວຕົນຫຼົ້ມເຫຼວ: ຊື່ຜູ້ໃຊ້ ແລະ/ຫຼື ລະຫັດຜ່ານບໍ່ຖືກຕ້ອງ."

#: src/etc/inc/dyndns.class:1846 src/etc/inc/dyndns.class:1864
msgid "No Service: Dynamic DNS Service has been disabled for this domain."
msgstr "ບໍ່ມີບໍລິການ: ບໍລິການ Dynamic DNS ຖືກປິດໃຊ້ງານສຳລັບໂດເມນນີ້."

#: src/etc/inc/dyndns.class:1848 src/etc/inc/dyndns.class:1866
msgid "Illegal Input: Self-Explanatory"
msgstr "ຂໍ້ມູນເຂົ້າບໍ່ຖືກຕ້ອງ: ຕາມທີ່ລະບຸ"

#: src/etc/inc/dyndns.class:1850 src/etc/inc/dyndns.class:1868
msgid "Too Soon: Not Enough Time Has Elapsed Since Last Update"
msgstr "ໄວເກີນໄປ: ຍັງບໍ່ຮອດເວລາກຳນົດນັບຈາກການອັບເດດຄັ້ງຫຼ້າສຸດ"

#: src/etc/inc/dyndns.class:1852 src/etc/inc/dyndns.class:1870
msgid "IP Updated Successfully!"
msgstr "ອັບເດດ IP ສຳເລັດແລ້ວ!"

#: src/etc/inc/dyndns.class:1883
msgid "Error 799"
msgstr "ຂໍ້ຜິດພາດ 799"

#: src/etc/inc/dyndns.class:1883 src/etc/inc/dyndns.class:1885
msgid "Update Failed!"
msgstr "ການອັບເດດຫຼົ້ມເຫຼວ!"

#: src/etc/inc/dyndns.class:1885
msgid "Error 700"
msgstr "ຂໍ້ຜິດພາດ 700"

#: src/etc/inc/dyndns.class:1900
msgid "Bad Request - The URL was malformed. Required parameters were not provided."
msgstr "ຄຳຮ້ອງຂໍບໍ່ຖືກຕ້ອງ - URL ບໍ່ຖືກຮູບແບບ ຫຼື ບໍ່ມີພາລາມິເຕີທີ່ຈຳເປັນ."

#: src/etc/inc/dyndns.class:1902
msgid "Update Too Soon - Attempted to update too quickly since last change."
msgstr "ອັບເດດໄວເກີນໄປ - ພະຍາຍາມອັບເດດໄວເກີນໄປນັບຈາກການປ່ຽນແປງຄັ້ງຫຼ້າສຸດ."

#: src/etc/inc/dyndns.class:1904
msgid "Database Error - There was a server-sided database error."
msgstr "ຂໍ້ຜິດພາດຖານຂໍ້ມູນ - ເກີດຂໍ້ຜິດພາດທີ່ຖານຂໍ້ມູນຂອງເຊີເວີ."

#: src/etc/inc/dyndns.class:1906
#, php-format
msgid "Hostname Error - The hostname (%1$s) doesn't belong to user (%2$s)."
msgstr "ຂໍ້ຜິດພາດຊື່ໂຮສ - ຊື່ໂຮສ (%1$s) ບໍ່ແມ່ນຂອງຜູ້ໃຊ້ (%2$s)."

#: src/etc/inc/dyndns.class:1984
msgid "Not a valid username or password!"
msgstr "ຊື່ຜູ້ໃຊ້ ຫຼື ລະຫັດຜ່ານບໍ່ຖືກຕ້ອງ!"

#: src/etc/inc/dyndns.class:1986
msgid "Hostname specified does not exist."
msgstr "ຊື່ໂຮສທີ່ລະບຸບໍ່ມີຢູ່."

#: src/etc/inc/dyndns.class:1992
msgid "Hostname specified exists, but not under the username specified."
msgstr "ຊື່ໂຮສທີ່ລະບຸມີຢູ່, ແຕ່ບໍ່ໄດ້ຢູ່ພາຍໃຕ້ຊື່ຜູ້ໃຊ້ທີ່ລະບຸ."

#: src/etc/inc/dyndns.class:1994
msgid "Updating too frequently, considered abuse."
msgstr "ອັບເດດເລື້ອຍເກີນໄປ, ຖືວ່າເປັນການໃຊ້ງານທີ່ຜິດປົກກະຕິ (abuse)."

#: src/etc/inc/dyndns.class:2003 src/etc/inc/dyndns.class:2078
msgid "Bad Request - The IP provided was invalid."
msgstr "ຄຳຮ້ອງຂໍບໍ່ຖືກຕ້ອງ - IP ທີ່ລະບຸບໍ່ຖືກຕ້ອງ."

#: src/etc/inc/dyndns.class:2005
msgid "Bad Request - Required parameters were not provided."
msgstr "ຄຳຮ້ອງຂໍບໍ່ຖືກຕ້ອງ - ບໍ່ມີພາລາມິເຕີທີ່ຈຳເປັນ."

#: src/etc/inc/dyndns.class:2007
msgid "Bad Request - Illegal characters in either the username or the password."
msgstr "ຄຳຮ້ອງຂໍບໍ່ຖືກຕ້ອງ - ມີຕົວອັກສອນທີ່ບໍ່ໄດ້ຮັບອະນຸຍາດໃນຊື່ຜູ້ໃຊ້ ຫຼື ລະຫັດຜ່ານ."

#: src/etc/inc/dyndns.class:2009
msgid "Invalid password."
msgstr "ລະຫັດຜ່ານບໍ່ຖືກຕ້ອງ."

#: src/etc/inc/dyndns.class:2011
msgid "This account has been administratively locked."
msgstr "ບັນຊີນີ້ຖືກລັອກໂດຍຜູ້ດູແລລະບົບ."

#: src/etc/inc/dyndns.class:2013
msgid "Updating too frequently."
msgstr "ອັບເດດເລື້ອຍເກີນໄປ."

#: src/etc/inc/dyndns.class:2015 src/etc/inc/dyndns.class:2040 src/etc/inc/dyndns.class:2057
msgid "Server side error."
msgstr "ເກີດຂໍ້ຜິດພາດທີ່ຝັ່ງເຊີເວີ."

#: src/etc/inc/dyndns.class:2033
msgid "Error message: "
msgstr "ຂໍ້ຄວາມຜິດພາດ: "

#: src/etc/inc/dyndns.class:2042
msgid "Badly Formed Request (check the settings)."
msgstr "ຮູບແບບຄຳຮ້ອງຂໍບໍ່ຖືກຕ້ອງ (ກະລຸນາກວດສອບການຕັ້ງຄ່າ)."

#: src/etc/inc/dyndns.class:2059 src/etc/inc/dyndns.class:2080
msgid "Bad Request - A hostname was not provided."
msgstr "ຄຳຮ້ອງຂໍບໍ່ຖືກຕ້ອງ - ບໍ່ໄດ້ລະບຸຊື່ໂຮສ."

#: src/etc/inc/dyndns.class:2061 src/etc/inc/dyndns.class:2082
msgid "Invalid username or password."
msgstr "ຊື່ຜູ້ໃຊ້ ຫຼື ລະຫັດຜ່ານບໍ່ຖືກຕ້ອງ."

#: src/etc/inc/dyndns.class:2066 src/etc/inc/dyndns.class:2087 src/etc/inc/dyndns.class:2099
msgid "No Change In IP Address."
msgstr "ທີ່ຢູ່ IP ບໍ່ມີການປ່ຽນແປງ."

#: src/etc/inc/dyndns.class:2115
msgid "Route53 API call failed"
msgstr "ການເອີ້ນໃຊ້ Route53 API ຫຼົ້ມເຫຼວ"

#: src/etc/inc/dyndns.class:2119
msgid "IP address changed successfully"
msgstr "ປ່ຽນທີ່ຢູ່ IP ສຳເລັດແລ້ວ"

#: src/etc/inc/dyndns.class:2142 src/etc/inc/dyndns.class:2345
msgid "Result did not match."
