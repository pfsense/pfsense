msgstr "ສຳຮອງຂໍ້ມູນ RRD ຕາມໄລຍະເວລາ"

#: src/usr/local/www/system_advanced_misc.php:353 src/usr/local/www/diag_backup.php:94
msgid "RRD Data"
msgstr "ຂໍ້ມູນ RRD"

#: src/usr/local/www/system_advanced_misc.php:357
msgid "Periodic DHCP Leases Backup"
msgstr "ສຳຮອງຂໍ້ມູນ DHCP Leases ຕາມໄລຍະເວລາ"

