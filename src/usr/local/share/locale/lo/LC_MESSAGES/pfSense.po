msgid "Port or Range"
msgstr "ພອດ ຫຼື ຊ່ວງພອດ"

#: src/usr/local/www/firewall_nat_out_edit.php:540
msgid "Destination network for the outbound NAT mapping."
msgstr "ເຄືອຂ່າຍປາຍທາງສຳລັບການຈັບຄູ່ NAT ຂາອອກ."

#: src/usr/local/www/firewall_nat_out_edit.php:556
msgid "Invert the sense of the destination match."
msgstr "ສະຫຼັບເງື່ອນໄຂການກວດສອບປາຍທາງ (Invert)."

#: src/usr/local/www/firewall_nat_out_edit.php:560
msgid "Translation"
msgstr "ການແປງທີ່ຢູ່ (Translation)"

