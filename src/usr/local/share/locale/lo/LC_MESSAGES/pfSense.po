#: src/usr/local/www/vpn_openvpn_client.php:1086 src/usr/local/www/services_unbound.php:467 src/usr/local/www/services_unbound.php:481 src/usr/local/www/services_dnsmasq.php:351 src/usr/local/www/vpn_openvpn_server.php:1553
msgid "Custom options"
msgstr "ຕົວເລືອກກຳນົດເອງ"

#: src/usr/local/www/vpn_openvpn_client.php:1092
msgid "Enter any additional options to add to the OpenVPN client configuration here, separated by semicolon."
msgstr "ປ້ອນຕົວເລືອກເພີ່ມເຕີມເພື່ອເພີ່ມໃສ່ການຕັ້ງຄ່າ OpenVPN client ຢູ່ບ່ອນນີ້, ແຍກແຕ່ລະອັນດ້ວຍເຄື່ອງໝາຍຈຸດຈ້ຳ (;)."

#: src/usr/local/www/vpn_openvpn_client.php:1096 src/usr/local/www/vpn_openvpn_server.php:1572
msgid "UDP Fast I/O"
msgstr "UDP Fast I/O"

#: src/usr/local/www/vpn_openvpn_client.php:1099 src/usr/local/www/vpn_openvpn_server.php:1575
msgid "Optimizes the packet write event loop, improving CPU efficiency by 5% to 10%. Not compatible with all platforms, and not compatible with OpenVPN bandwidth limiting."
msgstr "ເພີ່ມປະສິດທິພາບຮອບການຂຽນແພັກເກັດ (packet write event loop), ຊ່ວຍໃຫ້ CPU ເຮັດວຽກໄດ້ດີຂຶ້ນ 5% ຫາ 10%. ບໍ່ຮອງຮັບກັບທຸກແພລັດຟອມ ແລະ ບໍ່ຮອງຮັບກັບການຈຳກັດແບນວິດຂອງ OpenVPN."

#: src/usr/local/www/vpn_openvpn_client.php:1104 src/usr/local/www/vpn_openvpn_server.php:1580
msgid "Exit Notify"
msgstr "ການແຈ້ງເຕືອນຕອນອອກ"

#: src/usr/local/www/vpn_openvpn_client.php:1107
msgid "Send an explicit exit notification to connected servers/peers when restarting or shutting down, so they may immediately disconnect rather than waiting for a timeout. This value controls how many times this instance will attempt to send the exit notification."
msgstr "ສົ່ງການແຈ້ງເຕືອນການອອກທີ່ຊັດເຈນໄປຍັງເຊີບເວີ/ພີເຢີ (servers/peers) ທີ່ເຊື່ອມຕໍ່ຢູ່ ເມື່ອມີການເລີ່ມລະບົບໃໝ່ ຫຼື ປິດລະບົບ, ເພື່ອໃຫ້ພວກເຂົາສາມາດຕັດການເຊື່ອມຕໍ່ໄດ້ທັນທີ ແທນທີ່ຈະລໍຖ້າໃຫ້ໝົດເວລາ (timeout). ຄ່ານີ້ກຳນົດຈຳນວນຄັ້ງທີ່ລະບົບຈະພະຍາຍາມສົ່ງການແຈ້ງເຕືອນການອອກ."

#: src/usr/local/www/vpn_openvpn_client.php:1113 src/usr/local/www/vpn_openvpn_server.php:1591
msgid "Send/Receive Buffer"
msgstr "ບັບເຟີ ສົ່ງ/ຮັບ"

#: src/usr/local/www/vpn_openvpn_client.php:1116 src/usr/local/www/vpn_openvpn_server.php:1594
msgid "Configure a Send and Receive Buffer size for OpenVPN. The default buffer size can be too small in many cases, depending on hardware and network uplink speeds. Finding the best buffer size can take some experimentation. To test the best value for a site, start at 512KiB and test higher and lower values."
msgstr "ກຳນົດຂະໜາດບັບເຟີ (Buffer size) ສົ່ງ ແລະ ຮັບ ສຳລັບ OpenVPN. ຂະໜາດບັບເຟີມາດຕະຖານອາດຈະນ້ອຍເກີນໄປໃນຫຼາຍໆກໍລະນີ, ຂຶ້ນກັບຮາດແວ ແລະ ຄວາມໄວຂອງເຄືອຂ່າຍຂາຂຶ້ນ (uplink). ການຊອກຫາຂະໜາດບັບເຟີທີ່ດີທີ່ສຸດອາດຕ້ອງໃຊ້ການທົດລອງ. ເພື່ອທົດສອບຄ່າທີ່ດີທີ່ສຸດສຳລັບເວັບໄຊ, ໃຫ້ເລີ່ມຈາກ 512KiB ແລ້ວທົດສອບຄ່າທີ່ສູງຂຶ້ນ ຫຼື ຕ່ຳລົງ."

#: src/usr/local/www/vpn_openvpn_client.php:1121 src/usr/local/www/vpn_openvpn_server.php:1599
msgid "Gateway creation"
msgstr "ການສ້າງ ເກດເວ (Gateway)"

#: src/usr/local/www/vpn_openvpn_client.php:1146
msgid "If you assign a virtual interface to this OpenVPN client, this setting controls which gateway types will be created. The default setting is 'both'."
msgstr "ຫາກທ່ານກຳນົດ ອິນເຕີເຟສສະເໝືອນ (virtual interface) ໃຫ້ກັບ OpenVPN client ນີ້, ການຕັ້ງຄ່ານີ້ຈະກຳນົດວ່າຈະສ້າງເກດເວປະເພດໃດ. ຄ່າມາດຕະຖານແມ່ນ 'ທັງສອງ' (both)."

#: src/usr/local/www/vpn_openvpn_client.php:1154 src/usr/local/www/vpn_openvpn_server.php:1632
msgid "Verbosity level"
msgstr "ລະດັບການສະແດງລາຍລະອຽດ"

#: src/usr/local/www/vpn_openvpn_client.php:1157 src/usr/local/www/vpn_openvpn_server.php:1635
#, php-format
msgid "Each level shows all info from the previous levels. Level 3 is recommended for a good summary of what's happening without being swamped by output.%1$s%1$sNone: Only fatal errors%1$sDefault through 4: Normal usage range%1$s5: Output R and W characters to the console for each packet read and write. Uppercase is used for TCP/UDP packets and lowercase is used for TUN/TAP packets.%1$s6-11: Debug info range"
msgstr "ແຕ່ລະລະດັບຈະສະແດງຂໍ້ມູນທັງໝົດຈາກລະດັບກ່ອນໜ້າ. ລະດັບ 3 ແມ່ນແນະນຳສຳລັບການສະຫຼຸບສິ່ງທີ່ກຳລັງເກີດຂຶ້ນໄດ້ດີ ໂດຍທີ່ບໍ່ມີຂໍ້ມູນອອກມາຫຼາຍເກີນໄປ.%1$s%1$sບໍ່ມີ: ສະແດງສະເພາະຂໍ້ຜິດພາດທີ່ຮ້າຍແຮງເທົ່ານັ້ນ%1$sຄ່າມາດຕະຖານ ຫາ 4: ຊ່ວງການນຳໃຊ້ປົກກະຕິ%1$s5: ສະແດງຕົວອັກສອນ R ແລະ W ຢູ່ທີ່ຄອນໂຊນ (console) ສຳລັບການອ່ານ ແລະ ຂຽນແພັກເກັດແຕ່ລະອັນ. ຕົວອັກສອນໃຫຍ່ແມ່ນໃຊ້ສຳລັບແພັກເກັດ TCP/UDP ແລະ ຕົວອັກສອນນ້ອຍແມ່ນໃຊ້ສຳລັບແພັກເກັດ TUN/TAP.%1$s6-11: ຊ່ວງຂໍ້ມູນສຳລັບການກວດສອບຂໍ້ຜິດພາດ (Debug)"

