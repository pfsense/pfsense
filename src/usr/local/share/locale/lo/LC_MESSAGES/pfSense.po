msgid "Local IP Address"
msgstr "ທີ່ຢູ່ IP ພາຍໃນ"

#: src/usr/local/www/interfaces_ppps_edit.php:622
msgid "Gateway IP or Hostname"
msgstr "IP ເກດເວ ຫຼື ຊື່ໂຮສ"

#: src/usr/local/www/interfaces_ppps_edit.php:632 src/usr/local/www/interfaces.php:2848
