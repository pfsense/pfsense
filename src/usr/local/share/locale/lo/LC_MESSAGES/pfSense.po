#: src/usr/local/www/services_dhcpv6.php:275 src/usr/local/www/services_dhcpv6.php:287
msgid "A valid range must be specified."
msgstr "ຕ້ອງລະບຸຊ່ວງທີ່ຖືກຕ້ອງ."

#: src/usr/local/www/services_dhcpv6.php:280 src/usr/local/www/services_dhcpv6.php:292 src/usr/local/www/services_dhcpv6_edit.php:120
#, php-format
