#: src/usr/local/www/firewall_rules_edit.php:1657
msgid "State Timeout in seconds"
msgstr "ເວລາກຳນົດຂອງສະຖານະ ເປັນວິນາທີ"

#: src/usr/local/www/firewall_rules_edit.php:1662
msgid "Use this to choose TCP flags that must be set or cleared for this rule to match."
msgstr "ໃຊ້ຕົວເລືອກນີ້ເພື່ອເລືອກ TCP flags ທີ່ຕ້ອງຖືກຕັ້ງຄ່າ ຫຼື ຖືກລ້າງອອກ ເພື່ອໃຫ້ກົງກັບກົດນີ້."

#: src/usr/local/www/firewall_rules_edit.php:1666
msgid "No pfSync"
msgstr "ບໍ່ໃຊ້ pfSync"

#: src/usr/local/www/firewall_rules_edit.php:1673
msgid "State type"
msgstr "ປະເພດສະຖານະ"

#: src/usr/local/www/firewall_rules_edit.php:1676
#, php-format
msgid "Select which type of state tracking mechanism to use.  If in doubt, use keep state.%1$s"
msgstr "ເລືອກປະເພດຂອງກົນໄກການຕິດຕາມສະຖານະທີ່ຈະໃຊ້. ຖ້າບໍ່ແນ່ໃຈ, ໃຫ້ໃຊ້ keep state.%1$s"

#: src/usr/local/www/firewall_rules_edit.php:1684
msgid "This does NOT prevent the rule from being overwritten on Slave."
msgstr "ສິ່ງນີ້ບໍ່ໄດ້ປ້ອງກັນກົດຈາກການຖືກຂຽນທັບໃນເຄື່ອງຮອງ (Slave)."

#: src/usr/local/www/firewall_rules_edit.php:1688 src/usr/local/www/interfaces.php:2237 src/usr/local/www/interfaces.php:2466
