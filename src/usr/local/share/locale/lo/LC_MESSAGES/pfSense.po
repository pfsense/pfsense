#: src/usr/local/www/services_dhcp.php:241 src/usr/local/www/services_dhcp_edit.php:164
msgid "The DHCP option must be a number between 1 and 254."
msgstr "ຕົວເລືອກ DHCP ຕ້ອງແມ່ນຕົວເລກລະຫວ່າງ 1 ຫາ 254."

#: src/usr/local/www/services_dhcp.php:267
msgid "The specified OMAPI port number is invalid. Port number must be between 1024 and 65635."
msgstr "ເລກພອດ OMAPI ທີ່ລະບຸບໍ່ຖືກຕ້ອງ. ເລກພອດຕ້ອງຢູ່ລະຫວ່າງ 1024 ຫາ 65635."

#: src/usr/local/www/services_dhcp.php:270
msgid "Specified port number for OMAPI is in use. Please choose another port or consider using the default."
msgstr "ເລກພອດທີ່ລະບຸສຳລັບ OMAPI ຖືກນຳໃຊ້ຢູ່. ກະລຸນາເລືອກພອດອື່ນ ຫຼື ພິຈາລະນາໃຊ້ພອດມາດຕະຖານ."

#: src/usr/local/www/services_dhcp.php:320
msgid "A key is required when OMAPI is enabled (port specified)."
msgstr "ຕ້ອງມີຄີ (key) ເມື່ອເປີດໃຊ້ OMAPI (ມີການລະບຸພອດ)."

#: src/usr/local/www/services_dhcp.php:327
msgid "Range begin"
msgstr "ຈຸດເລີ່ມຕົ້ນຊ່ວງ"

#: src/usr/local/www/services_dhcp.php:327
msgid "Range end"
msgstr "ຈຸດສິ້ນສຸດຊ່ວງ"

#: src/usr/local/www/services_dhcp.php:333
msgid "Ignore Denied Clients may not be used when a Failover Peer IP is defined."
msgstr "\"ບໍ່ສົນໃຈ Client ທີ່ຖືກປະຕິເສດ\" ອາດຈະບໍ່ສາມາດໃຊ້ໄດ້ ເມື່ອມີການກຳນົດ Failover Peer IP."

#: src/usr/local/www/services_dhcp.php:337
msgid "A valid IPv4 address must be specified for range from."
msgstr "ຕ້ອງລະບຸທີ່ຢູ່ IPv4 ທີ່ຖືກຕ້ອງສຳລັບ \"ຊ່ວງເລີ່ມຕົ້ນຈາກ\"."

#: src/usr/local/www/services_dhcp.php:340
msgid "A valid IPv4 address must be specified for range to."
msgstr "ຕ້ອງລະບຸທີ່ຢູ່ IPv4 ທີ່ຖືກຕ້ອງສຳລັບ \"ຊ່ວງສິ້ນສຸດເຖິງ\"."

#: src/usr/local/www/services_dhcp.php:346
msgid "A valid IP address must be specified for the gateway."
msgstr "ຕ້ອງລະບຸທີ່ຢູ່ IP ທີ່ຖືກຕ້ອງສຳລັບເກດເວ (gateway)."

#: src/usr/local/www/services_dhcp.php:349
msgid "A valid IP address must be specified for the primary/secondary WINS servers."
msgstr "ຕ້ອງລະບຸທີ່ຢູ່ IP ທີ່ຖືກຕ້ອງສຳລັບເຊີບເວີ WINS ຫຼັກ/ສຳຮອງ."

#: src/usr/local/www/services_dhcp.php:355 src/usr/local/www/services_dhcp_edit.php:268
#, php-format
msgid "The gateway address %s does not lie within the chosen interface's subnet."
msgstr "ທີ່ຢູ່ເກດເວ %s ບໍ່ຢູ່ໃນຊັບເນັດ (subnet) ຂອງອິນເຕີເຟສທີ່ເລືອກ."

#: src/usr/local/www/services_dhcp.php:360
msgid "A valid IP address must be specified for each of the DNS servers."
msgstr "ຕ້ອງລະບຸທີ່ຢູ່ IP ທີ່ຖືກຕ້ອງສຳລັບແຕ່ລະເຊີບເວີ DNS."

#: src/usr/local/www/services_dhcp.php:386
#, php-format
msgid "The Captive Portal zone (%1$s) has Hard Timeout parameter set to a value bigger than Default lease time (%2$s)."
msgstr "ໂຊນ Captive Portal (%1$s) ມີການຕັ້ງຄ່າ Hard Timeout ໃຫຍ່ກວ່າເວລາການເຊົ່າໃຊ້ມາດຕະຖານ (%2$s)."

#: src/usr/local/www/services_dhcp.php:426
msgid "If a mac allow list is specified, it must contain only valid partial MAC addresses."
msgstr "ຫາກມີການລະບຸລາຍການອະນຸຍາດ MAC, ມັນຕ້ອງມີສະເພາະທີ່ຢູ່ MAC ບາງສ່ວນທີ່ຖືກຕ້ອງເທົ່ານັ້ນ."

#: src/usr/local/www/services_dhcp.php:429
msgid "If a mac some deny list is specified, it must contain only valid partial MAC addresses."
msgstr "ຫາກມີການລະບຸລາຍການປະຕິເສດ MAC, ມັນຕ້ອງມີສະເພາະທີ່ຢູ່ MAC ບາງສ່ວນທີ່ຖືກຕ້ອງເທົ່ານັ້ນ."

#: src/usr/local/www/services_dhcp.php:435 src/usr/local/www/services_dhcp_edit.php:317
msgid "A valid IP address or hostname must be specified for the primary/secondary NTP servers."
msgstr "ຕ້ອງລະບຸທີ່ຢູ່ IP ຫຼື ຊື່ໂຮສ (hostname) ທີ່ຖືກຕ້ອງສຳລັບເຊີບເວີ NTP ຫຼັກ/ສຳຮອງ."

#: src/usr/local/www/services_dhcp.php:441
msgid "A valid IP address, hostname or URL must be specified for the TFTP server."
msgstr "ຕ້ອງລະບຸທີ່ຢູ່ IP, ຊື່ໂຮສ ຫຼື URL ທີ່ຖືກຕ້ອງສຳລັບເຊີບເວີ TFTP."

#: src/usr/local/www/services_dhcp.php:444
msgid "A valid IP address must be specified for the network boot server."
msgstr "ຕ້ອງລະບຸທີ່ຢູ່ IP ທີ່ຖືກຕ້ອງສຳລັບເຊີບເວີບູດເຄືອຂ່າຍ (network boot server)."

#: src/usr/local/www/services_dhcp.php:448
msgid "The network address cannot be used in the starting subnet range."
msgstr "ທີ່ຢູ່ເຄືອຂ່າຍ (network address) ບໍ່ສາມາດໃຊ້ໃນຊ່ວງເລີ່ມຕົ້ນຂອງຊັບເນັດໄດ້."

#: src/usr/local/www/services_dhcp.php:451
msgid "The broadcast address cannot be used in the ending subnet range."
msgstr "ທີ່ຢູ່ບຣອດແຄສ (broadcast address) ບໍ່ສາມາດໃຊ້ໃນຊ່ວງສິ້ນສຸດຂອງຊັບເນັດໄດ້."

#: src/usr/local/www/services_dhcp.php:459
#, php-format
msgid "The subnet range cannot overlap with virtual IP address %s."
msgstr "ຊ່ວງຊັບເນັດບໍ່ສາມາດຊ້ອນທັບກັບທີ່ຢູ່ IP ສະເໝືອນ (virtual IP) %s ໄດ້."

#: src/usr/local/www/services_dhcp.php:475
msgid "Cannot enable static ARP when there are static map entries without IP addresses. Ensure all static maps have IP addresses and try again."
msgstr "ບໍ່ສາມາດເປີດໃຊ້ static ARP ໄດ້ ເມື່ອມີລາຍການ static map ທີ່ບໍ່ມີທີ່ຢູ່ IP. ກະລຸນາກວດສອບໃຫ້ແນ່ໃຈວ່າ static maps ທັງໝົດມີທີ່ຢູ່ IP ແລ້ວລອງໃໝ່ອີກຄັ້ງ."

#: src/usr/local/www/services_dhcp.php:482
msgid "Text type cannot include quotation marks."
msgstr "ປະເພດຂໍ້ຄວາມ (Text type) ບໍ່ສາມາດລວມມີເຄື່ອງໝາຍຄຳເວົ້າໄດ້."

#: src/usr/local/www/services_dhcp.php:484
msgid "String type must be enclosed in quotes like \"this\" or must be a series of octets specified in hexadecimal, separated by colons, like 01:23:45:67:89:ab:cd:ef"
msgstr "ປະເພດສະຕຣິງ (String type) ຕ້ອງຢູ່ໃນເຄື່ອງໝາຍຄຳເວົ້າ ເຊັ່ນ \"ຂໍ້ຄວາມນີ້\" ຫຼື ຕ້ອງເປັນຊຸດຂອງ octets ທີ່ລະບຸເປັນເລກຖານສິບຫົກ, ແຍກດ້ວຍເຄື່ອງໝາຍຈ້ຳ (:), ເຊັ່ນ 01:23:45:67:89:ab:cd:ef"

#: src/usr/local/www/services_dhcp.php:486
msgid "Boolean type must be true, false, on, or off."
msgstr "ປະເພດ Boolean ຕ້ອງແມ່ນ true, false, on, ຫຼື off."

#: src/usr/local/www/services_dhcp.php:488
msgid "Unsigned 8-bit integer type must be a number in the range 0 to 255."
msgstr "ປະເພດຈຳນວນເຕັມ 8 ບິດ ທີ່ບໍ່ມີເຄື່ອງໝາຍ ຕ້ອງແມ່ນຕົວເລກໃນຊ່ວງ 0 ຫາ 255."

#: src/usr/local/www/services_dhcp.php:490
msgid "Unsigned 16-bit integer type must be a number in the range 0 to 65535."
msgstr "ປະເພດຈຳນວນເຕັມ 16 ບິດ ທີ່ບໍ່ມີເຄື່ອງໝາຍ ຕ້ອງແມ່ນຕົວເລກໃນຊ່ວງ 0 ຫາ 65535."

#: src/usr/local/www/services_dhcp.php:492
msgid "Unsigned 32-bit integer type must be a number in the range 0 to 4294967295."
msgstr "ປະເພດຈຳນວນເຕັມ 32 ບິດ ທີ່ບໍ່ມີເຄື່ອງໝາຍ ຕ້ອງແມ່ນຕົວເລກໃນຊ່ວງ 0 ຫາ 4294967295."

#: src/usr/local/www/services_dhcp.php:494
msgid "Signed 8-bit integer type must be a number in the range -128 to 127."
msgstr "ປະເພດຈຳນວນເຕັມ 8 ບິດ ທີ່ມີເຄື່ອງໝາຍ ຕ້ອງແມ່ນຕົວເລກໃນຊ່ວງ -128 ຫາ 127."

#: src/usr/local/www/services_dhcp.php:496
msgid "Signed 16-bit integer type must be a number in the range -32768 to 32767."
msgstr "ປະເພດຈຳນວນເຕັມ 16 ບິດ ທີ່ມີເຄື່ອງໝາຍ ຕ້ອງແມ່ນຕົວເລກໃນຊ່ວງ -32768 ຫາ 32767."

#: src/usr/local/www/services_dhcp.php:498
msgid "Signed 32-bit integer type must be a number in the range -2147483648 to 2147483647."
msgstr "ປະເພດຈຳນວນເຕັມ 32 ບິດ ທີ່ມີເຄື່ອງໝາຍ ຕ້ອງແມ່ນຕົວເລກໃນຊ່ວງ -2147483648 ຫາ 2147483647."

#: src/usr/local/www/services_dhcp.php:500
msgid "IP address or host type must be an IP address or host name."
msgstr "ປະເພດທີ່ຢູ່ IP ຫຼື ໂຮສ ຕ້ອງແມ່ນທີ່ຢູ່ IP ຫຼື ຊື່ໂຮສ."

#: src/usr/local/www/services_dhcp.php:534
msgid "DHCP Registration features in the DNS Forwarder are active and require at least one enabled DHCP Server."
msgstr "ຄຸນສົມບັດການລົງທະບຽນ DHCP ໃນ DNS Forwarder ກຳລັງເຮັດວຽກຢູ່ ແລະ ຕ້ອງການເຊີບເວີ DHCP ຢ່າງໜ້ອຍໜຶ່ງອັນທີ່ເປີດໃຊ້ງານ."

#: src/usr/local/www/services_dhcp.php:541
msgid "DHCP Registration features in the DNS Resolver are active and require at least one enabled DHCP Server."
msgstr "ຄຸນສົມບັດການລົງທະບຽນ DHCP ໃນ DNS Resolver ກຳລັງເຮັດວຽກຢູ່ ແລະ ຕ້ອງການເຊີບເວີ DHCP ຢ່າງໜ້ອຍໜຶ່ງອັນທີ່ເປີດໃຊ້ງານ."

#: src/usr/local/www/services_dhcp.php:565
msgid "The specified range must not be within the DHCP range for this interface."
msgstr "ຊ່ວງທີ່ລະບຸຕ້ອງບໍ່ຢູ່ໃນຊ່ວງ DHCP ສຳລັບອິນເຕີເຟສນີ້."

#: src/usr/local/www/services_dhcp.php:578
msgid "The specified range must not be within the range configured on a DHCP pool for this interface."
msgstr "ຊ່ວງທີ່ລະບຸຕ້ອງບໍ່ຢູ່ໃນຊ່ວງທີ່ກຳນົດໄວ້ໃນ DHCP pool ສຳລັບອິນເຕີເຟສນີ້."

#: src/usr/local/www/services_dhcp.php:768
msgid "DHCP Server - Settings changed for interface "
msgstr "ເຊີບເວີ DHCP - ການຕັ້ງຄ່າປ່ຽນແປງສຳລັບອິນເຕີເຟສ "

#: src/usr/local/www/services_dhcp.php:869 src/usr/local/www/status_dhcp_leases.php:333
msgid "Pool Start"
msgstr "ເລີ່ມຕົ້ນ Pool"

#: src/usr/local/www/services_dhcp.php:870 src/usr/local/www/status_dhcp_leases.php:334
msgid "Pool End"
msgstr "ສິ້ນສຸດ Pool"

#: src/usr/local/www/services_dhcp.php:891
msgid "Edit pool"
msgstr "ແກ້ໄຂ pool"

#: src/usr/local/www/services_dhcp.php:893
msgid "Delete pool"
msgstr "ລົບ pool"

#: src/usr/local/www/services_dhcp.php:907 src/usr/local/www/services_dhcp_edit.php:445 src/usr/local/www/diag_backup.php:84 src/usr/local/www/head.inc:324
msgid "DHCP Server"
msgstr "ເຊີບເວີ DHCP"

#: src/usr/local/www/services_dhcp.php:962
#, php-format
msgid "%1$s has a CIDR mask of %2$s, which does not contain enough addresses."
msgstr "%1$s ມີ CIDR mask ແມ່ນ %2$s, ເຊິ່ງມີທີ່ຢູ່ IP ບໍ່ພຽງພໍ."

#: src/usr/local/www/services_dhcp.php:964
msgid "This system has no interfaces configured with a static IPv4 address."
msgstr "ລະບົບນີ້ບໍ່ມີອິນເຕີເຟສໃດທີ່ກຳນົດທີ່ຢູ່ IPv4 ແບບຄົງທີ່ (static)."

#: src/usr/local/www/services_dhcp.php:966
msgid "The DHCP Server requires a static IPv4 subnet large enough to serve addresses to clients."
msgstr "ເຊີບເວີ DHCP ຕ້ອງການຊັບເນັດ IPv4 ແບບຄົງທີ່ ທີ່ໃຫຍ່ພໍທີ່ຈະໃຫ້ບໍລິການທີ່ຢູ່ IP ແກ່ client ໄດ້."

#: src/usr/local/www/services_dhcp.php:975 src/usr/local/www/pkg_edit.php:749
msgid "General Options"
msgstr "ຕົວເລືອກທົ່ວໄປ"

#: src/usr/local/www/services_dhcp.php:982
msgid "DHCP Relay is currently enabled. DHCP Server canot be enabled while the DHCP Relay is enabled on any interface."
msgstr "ປະຈຸບັນເປີດໃຊ້ DHCP Relay ຢູ່. ເຊີບເວີ DHCP ບໍ່ສາມາດເປີດໃຊ້ງານໄດ້ໃນຂະນະທີ່ DHCP Relay ຖືກເປີດໃຊ້ໃນອິນເຕີເຟສໃດໜຶ່ງ."

#: src/usr/local/www/services_dhcp.php:989
#, php-format
msgid "Enable DHCP server on %s interface"
msgstr "ເປີດໃຊ້ເຊີບເວີ DHCP ໃນອິນເຕີເຟສ %s"

#: src/usr/local/www/services_dhcp.php:994
msgid "Editing pool-specific options. To return to the Interface, click its tab above."
msgstr "ກຳລັງແກ້ໄຂຕົວເລືອກສະເພາະຂອງ pool. ເພື່ອກັບໄປທີ່ອິນເຕີເຟສ, ໃຫ້ຄລິກແທັບຂອງມັນຢູ່ດ້ານເທິງ."

#: src/usr/local/www/services_dhcp.php:999
msgid "BOOTP"
msgstr "BOOTP"

#: src/usr/local/www/services_dhcp.php:1006
msgid "Deny unknown clients"
msgstr "ປະຕິເສດ Client ທີ່ບໍ່ຮູ້ຈັກ"

#: src/usr/local/www/services_dhcp.php:1013
#, php-format
msgid "When set to %3$sAllow all clients%4$s, any DHCP client will get an IP address within this scope/range on this interface. If set to %3$sAllow known clients from any interface%4$s, any DHCP client with a MAC address listed on %1$s%3$sany%4$s%2$s scope(s)/interface(s) will get an IP address. If set to %3$sAllow known clients from only this interface%4$s, only MAC addresses listed below (i.e. for this interface) will get an IP address within this scope/range."
msgstr "ເມື່ອຕັ້ງເປັນ %3$sອະນຸຍາດ Client ທັງໝົດ%4$s, Client DHCP ໃດໆກໍຕາມຈະໄດ້ຮັບທີ່ຢູ່ IP ພາຍໃນຂອບເຂດ/ຊ່ວງນີ້ໃນອິນເຕີເຟສນີ້. ຫາກຕັ້ງເປັນ %3$sອະນຸຍາດ Client ທີ່ຮູ້ຈັກຈາກທຸກອິນເຕີເຟສ%4$s, Client DHCP ໃດໆທີ່ມີທີ່ຢູ່ MAC ຢູ່ໃນລາຍຊື່ຂອງ %1$s%3$sທຸກ%4$s%2$s ຂອບເຂດ/ອິນເຕີເຟສ ຈະໄດ້ຮັບທີ່ຢູ່ IP. ຫາກຕັ້ງເປັນ %3$sອະນຸຍາດ Client ທີ່ຮູ້ຈັກຈາກອິນເຕີເຟສນີ້ເທົ່ານັ້ນ%4$s, ຈະມີພຽງທີ່ຢູ່ MAC ທີ່ລະບຸໄວ້ຂ້າງລຸ່ມນີ້ (ຄືສຳລັບອິນເຕີເຟສນີ້) ເທົ່ານັ້ນທີ່ຈະໄດ້ຮັບທີ່ຢູ່ IP ພາຍໃນຂອບເຂດ/ຊ່ວງນີ້."

#: src/usr/local/www/services_dhcp.php:1020
msgid "Ignore denied clients"
msgstr "ບໍ່ສົນໃຈ Client ທີ່ຖືກປະຕິເສດ"

#: src/usr/local/www/services_dhcp.php:1023
msgid "This option is not compatible with failover and cannot be enabled when a Failover Peer IP address is configured."
msgstr "ຕົວເລືອກນີ້ບໍ່ຮອງຮັບກັບ failover ແລະ ບໍ່ສາມາດເປີດໃຊ້ໄດ້ເມື່ອມີການກຳນົດທີ່ຢູ່ Failover Peer IP ໄວ້."

#: src/usr/local/www/services_dhcp.php:1027
msgid "Ignore client identifiers"
msgstr "ບໍ່ສົນໃຈຕົວລະບຸ Client"

#: src/usr/local/www/services_dhcp.php:1030
msgid "This option may be useful when a client can dual boot using different client identifiers but the same hardware (MAC) address.  Note that the resulting server behavior violates the official DHCP specification."
msgstr "ຕົວເລືອກນີ້ອາດມີປະໂຫຍດເມື່ອ client ສາມາດບູດໄດ້ສອງລະບົບ (dual boot) ໂດຍໃຊ້ຕົວລະບຸ client ທີ່ຕ່າງກັນ ແຕ່ໃຊ້ທີ່ຢູ່ຮາດແວ (MAC) ດຽວກັນ. ໝາຍເຫດ: ພຶດຕິກຳຂອງເຊີບເວີທີ່ເກີດຂຶ້ນຈະລະເມີດຂໍ້ກຳນົດມາດຕະຖານຂອງ DHCP."

#: src/usr/local/www/services_dhcp.php:1036
msgid "Pool Description"
msgstr "ຄຳອະທິບາຍ Pool"

#: src/usr/local/www/services_dhcp.php:1056
msgid "In-use DHCP Pool Ranges:"
msgstr "ຊ່ວງ DHCP Pool ທີ່ກຳລັງໃຊ້ງານ:"

#: src/usr/local/www/services_dhcp.php:1069
msgid "Available range"
msgstr "ຊ່ວງທີ່ມີໃຫ້ໃຊ້"

#: src/usr/local/www/services_dhcp.php:1094
msgid "Additional Pools"
msgstr "Pool ເພີ່ມເຕີມ"

#: src/usr/local/www/services_dhcp.php:1098
msgid "Add pool"
msgstr "ເພີ່ມ pool"

#: src/usr/local/www/services_dhcp.php:1107
msgid "If additional pools of addresses are needed inside of this subnet outside the above Range, they may be specified here."
msgstr "ຫາກຕ້ອງການ pool ຂອງທີ່ຢູ່ IP ເພີ່ມເຕີມພາຍໃນຊັບເນັດນີ້ ຢູ່ນອກຊ່ວງຂ້າງເທິງ, ສາມາດລະບຸໄດ້ຢູ່ບ່ອນນີ້."

#: src/usr/local/www/services_dhcp.php:1123 src/usr/local/www/vpn_openvpn_csc.php:584
msgid "WINS servers"
msgstr "ເຊີບເວີ WINS"

#: src/usr/local/www/services_dhcp.php:1138 src/usr/local/www/status_interfaces.php:183
msgid "DNS servers"
msgstr "ເຊີບເວີ DNS"

#: src/usr/local/www/services_dhcp.php:1141
msgid "Leave blank to use the system default DNS servers: this interface's IP if DNS Forwarder or Resolver is enabled, otherwise the servers configured on the System / General Setup page."
msgstr "ປະຫວ່າງໄວ້ເພື່ອໃຊ້ເຊີບເວີ DNS ມາດຕະຖານຂອງລະບົບ: ທີ່ຢູ່ IP ຂອງອິນເຕີເຟສນີ້ ຫາກເປີດໃຊ້ DNS Forwarder ຫຼື Resolver, ຖ້າບໍ່ດັ່ງນັ້ນ ຈະໃຊ້ເຊີບເວີທີ່ກຳນົດໄວ້ໃນໜ້າ System / General Setup."

#: src/usr/local/www/services_dhcp.php:1147
msgid "OMAPI"
msgstr "OMAPI"

#: src/usr/local/www/services_dhcp.php:1151
msgid "OMAPI Port"
msgstr "ພອດ OMAPI"

#: src/usr/local/www/services_dhcp.php:1155
msgid "Set the port that OMAPI will listen on. The default port is 7911, leave blank to disable.Only the first OMAPI configuration is used."
msgstr "ກຳນົດພອດທີ່ OMAPI ຈະລໍຖ້າການເຊື່ອມຕໍ່. ພອດມາດຕະຖານແມ່ນ 7911, ປະຫວ່າງໄວ້ເພື່ອປິດໃຊ້ງານ. ຈະມີພຽງການຕັ້ງຄ່າ OMAPI ທຳອິດເທົ່ານັ້ນທີ່ຈະຖືກນຳໃຊ້."

#: src/usr/local/www/services_dhcp.php:1158 src/usr/local/www/services_dhcp.php:1162
msgid "OMAPI Key"
msgstr "ຄີ OMAPI"

#: src/usr/local/www/services_dhcp.php:1166
msgid "Enter a key matching the selected algorithm<br />to secure connections to the OMAPI endpoint."
msgstr "ປ້ອນຄີໃຫ້ກົງກັບອັລກໍຣິດທຶມທີ່ເລືອກ<br />ເພື່ອຄວາມປອດໄພໃນການເຊື່ອມຕໍ່ກັບ OMAPI endpoint."

#: src/usr/local/www/services_dhcp.php:1173
msgid "Generate a new key based<br />on the selected algorithm."
msgstr "ສ້າງຄີໃໝ່ຕາມ<br />ອັລກໍຣິດທຶມທີ່ເລືອກ."

#: src/usr/local/www/services_dhcp.php:1179
msgid "Key Algorithm"
msgstr "ອັລກໍຣິດທຶມຂອງຄີ"

#: src/usr/local/www/services_dhcp.php:1189
msgid "Set the algorithm that OMAPI key will use."
msgstr "ກຳນົດອັລກໍຣິດທຶມທີ່ຄີ OMAPI ຈະນຳໃຊ້."

#: src/usr/local/www/services_dhcp.php:1193
msgid "Other Options"
msgstr "ຕົວເລືອກອື່ນໆ"

#: src/usr/local/www/services_dhcp.php:1201
msgid "The default is to use the IP on this interface of the firewall as the gateway. Specify an alternate gateway here if this is not the correct gateway for the network. Type \"none\" for no gateway assignment."
msgstr "ຄ່າມາດຕະຖານແມ່ນໃຊ້ທີ່ຢູ່ IP ຂອງອິນເຕີເຟສນີ້ເປັນເກດເວ. ໃຫ້ລະບຸເກດເວສຳຮອງຢູ່ບ່ອນນີ້ ຫາກນີ້ບໍ່ແມ່ນເກດເວທີ່ຖືກຕ້ອງສຳລັບເຄືອຂ່າຍ. ພິມ \"none\" ຫາກບໍ່ຕ້ອງການກຳນົດເກດເວ."

#: src/usr/local/www/services_dhcp.php:1208
msgid "The default is to use the domain name of this system as the default domain name provided by DHCP. An alternate domain name may be specified here."
msgstr "ຄ່າມາດຕະຖານແມ່ນໃຊ້ຊື່ໂດເມນຂອງລະບົບນີ້ ເປັນຊື່ໂດເມນມາດຕະຖານທີ່ DHCP ມອບໃຫ້. ສາມາດລະບຸຊື່ໂດເມນອື່ນໄດ້ຢູ່ບ່ອນນີ້."

#: src/usr/local/www/services_dhcp.php:1222
msgid "This is used for clients that do not ask for a specific expiration time. The default is 7200 seconds."
msgstr "ໃຊ້ສຳລັບ client ທີ່ບໍ່ໄດ້ຂໍເວລາໝົດອາຍຸສະເພາະ. ຄ່າມາດຕະຖານແມ່ນ 7200 ວິນາທີ."

#: src/usr/local/www/services_dhcp.php:1226
msgid "Maximum lease time"
msgstr "ເວລາການເຊົ່າໃຊ້ສູງສຸດ"

#: src/usr/local/www/services_dhcp.php:1229 src/usr/local/www/services_dhcp_edit.php:627
msgid "This is the maximum lease time for clients that ask for a specific expiration time. The default is 86400 seconds."
msgstr "ນີ້ແມ່ນເວລາການເຊົ່າໃຊ້ສູງສຸດ ສຳລັບ client ທີ່ຂໍເວລາໝົດອາຍຸສະເພາະ. ຄ່າມາດຕະຖານແມ່ນ 86400 ວິນາທີ."

#: src/usr/local/www/services_dhcp.php:1234
msgid "Failover peer IP"
msgstr "IP ຂອງຄູ່ Failover"

#: src/usr/local/www/services_dhcp.php:1237
msgid "Leave blank to disable. Enter the interface IP address of the other machine. Machines must be using CARP. Interface's advskew determines whether the DHCPd process is Primary or Secondary. Ensure one machine's advskew &lt; 20 (and the other is &gt; 20)."
msgstr "ປະຫວ່າງໄວ້ເພື່ອປິດໃຊ້ງານ. ປ້ອນທີ່ຢູ່ IP ອິນເຕີເຟສຂອງເຄື່ອງອື່ນ. ເຄື່ອງຕ່າງໆຕ້ອງໃຊ້ CARP. ຄ່າ advskew ຂອງອິນເຕີເຟສຈະເປັນຕົວ ກຳນົດວ່າໂປຣເຊສ DHCPd ເປັນແບບ Primary ຫຼື Secondary. ກວດສອບໃຫ້ແນ່ໃຈວ່າ advskew ຂອງເຄື່ອງໜຶ່ງ &lt; 20 (ແລະ ອີກເຄື່ອງແມ່ນ &gt; 20)."

#: src/usr/local/www/services_dhcp.php:1242 src/usr/local/www/services_dhcp.php:1686 src/usr/local/www/widgets/widgets/wake_on_lan.widget.php:114
msgid "Static ARP"
msgstr "Static ARP"

#: src/usr/local/www/services_dhcp.php:1245
msgid "This option persists even if DHCP server is disabled. Only the machines listed below will be able to communicate with the firewall on this interface."
msgstr "ຕົວເລືອກນີ້ຍັງຄົງຢູ່ ເຖິງແມ່ນວ່າເຊີບເວີ DHCP ຈະຖືກປິດໃຊ້ງານ. ຈະມີພຽງເຄື່ອງທີ່ລະບຸໄວ້ຂ້າງລຸ່ມນີ້ເທົ່ານັ້ນ ທີ່ຈະສາມາດຕິດຕໍ່ສື່ສານກັບໄຟວໍໃນອິນເຕີເຟສນີ້ໄດ້."

#: src/usr/local/www/services_dhcp.php:1249
msgid "Time format change"
msgstr "ປ່ຽນຮູບແບບເວລາ"

#: src/usr/local/www/services_dhcp.php:1252
msgid "By default DHCP leases are displayed in UTC time.\tBy checking this box DHCP lease time will be displayed in local time and set to the time zone selected. This will be used for all DHCP interfaces lease time."
msgstr "ໂດຍມາດຕະຖານແລ້ວ ການເຊົ່າໃຊ້ DHCP ຈະສະແດງໃນຮູບແບບເວລາ UTC. ຫາກໝາຍເອົາຫ້ອງນີ້ ເວລາການເຊົ່າໃຊ້ DHCP ຈະສະແດງເປັນເວລາທ້ອງຖິ່ນ ແລະ ຕັ້ງຕາມເຂດເວລາທີ່ເລືອກ. ສິ່ງນີ້ຈະຖືກໃຊ້ສຳລັບເວລາການເຊົ່າໃຊ້ຂອງທຸກອິນເຕີເຟສ DHCP."

#: src/usr/local/www/services_dhcp.php:1257
msgid "Statistics graphs"
msgstr "ກຣາຟສະຖິຕິ"

#: src/usr/local/www/services_dhcp.php:1260
msgid "Enable this to add DHCP leases statistics to the RRD graphs. Disabled by default."
msgstr "ເປີດໃຊ້ສິ່ງນີ້ເພື່ອເພີ່ມສະຖິຕິການເຊົ່າໃຊ້ DHCP ເຂົ້າໃນກຣາຟ RRD. ຖືກປິດໄວ້ໂດຍມາດຕະຖານ."

#: src/usr/local/www/services_dhcp.php:1264
msgid "Ping check"
msgstr "ການກວດສອບ Ping"

#: src/usr/local/www/services_dhcp.php:1267
msgid "When enabled dhcpd sends a ping to the address being assigned, and if no response has been heard, it assigns the address. Enabled by default."
msgstr "ເມື່ອເປີດໃຊ້ງານ dhcpd ຈະສົ່ງ ping ໄປຫາທີ່ຢູ່ IP ທີ່ຈະຖືກມອບໝາຍ, ແລະ ຫາກບໍ່ມີການຕອບຮັບ, ມັນຈະມອບໝາຍທີ່ຢູ່ນັ້ນ. ເປີດໃຊ້ງານໄວ້ໂດຍມາດຕະຖານ."

#: src/usr/local/www/services_dhcp.php:1311 src/usr/local/www/services_dhcp_edit.php:671
msgid "Primary domain name server IP address for the dynamic domain name."
msgstr "ທີ່ຢູ່ IP ຂອງເຊີບເວີຊື່ໂດເມນຫຼັກ ສຳລັບຊື່ໂດເມນແບບໄດນາມິກ."

#: src/usr/local/www/services_dhcp.php:1318 src/usr/local/www/services_dhcp_edit.php:678
msgid "Secondary domain name server IP address for the dynamic domain name."
