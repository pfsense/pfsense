msgstr "ບັງຄັບໃຫ້ Rebuild ອຸປະກອນໃນ Mirror"

#: src/usr/local/www/diag_gmirror.php:64
msgid "A valid mirror name must be supplied."
msgstr "ຕ້ອງລະບຸຊື່ Mirror ທີ່ຖືກຕ້ອງ."

#: src/usr/local/www/diag_gmirror.php:68
msgid "A valid consumer name must be supplied"
msgstr "ຕ້ອງລະບຸຊື່ Consumer ທີ່ຖືກຕ້ອງ"

#: src/usr/local/www/diag_gmirror.php:75
msgid "Consumer is already in use and cannot be inserted. Remove consumer from existing mirror first."
msgstr "ອຸປະກອນກຳລັງຖືກໃຊ້ງານຢູ່ ແລະ ບໍ່ສາມາດເພີ່ມໄດ້. ກະລຸນາລຶບອອກຈາກ Mirror ເດີມກ່ອນ."

#: src/usr/local/www/diag_gmirror.php:78
msgid "Consumer has metadata from an existing mirror. Clear metadata before inserting consumer."
msgstr "ອຸປະກອນມີ metadata ຈາກ Mirror ອື່ນຢູ່. ກະລຸນາລ້າງ metadata ກ່ອນເພີ່ມເຂົ້າໃໝ່."

#: src/usr/local/www/diag_gmirror.php:82
msgid "Mirror is not in a COMPLETE state, cannot insert consumer. Forget disconnected disks or wait for rebuild to finish."
msgstr "Mirror ຍັງບໍ່ຢູ່ໃນສະຖານະທີ່ສົມບູນ, ບໍ່ສາມາດເພີ່ມອຸປະກອນໄດ້. ກະລຸນາ Forget ດິສກ໌ທີ່ຫຼຸດໄປ ຫຼື ລໍຖ້າໃຫ້ Rebuild ສຳເລັດກ່ອນ."

#: src/usr/local/www/diag_gmirror.php:88
msgid "Consumer is in use and cannot be cleared. Deactivate disk first."
msgstr "ອຸປະກອນກຳລັງຖືກໃຊ້ງານ ແລະ ບໍ່ສາມາດລ້າງຂໍ້ມູນໄດ້. ກະລຸນາປິດໃຊ້ງານດິສກ໌ກ່ອນ."

#: src/usr/local/www/diag_gmirror.php:91
msgid "Consumer has no metadata to clear."
msgstr "ອຸປະກອນບໍ່ມີ metadata ໃຫ້ລ້າງ."

#: src/usr/local/www/diag_gmirror.php:97
msgid "Consumer is already present on specified mirror."
msgstr "ອຸປະກອນນີ້ມີຢູ່ໃນ Mirror ທີ່ລະບຸໄວ້ແລ້ວ."

#: src/usr/local/www/diag_gmirror.php:100
msgid "Consumer has no metadata and cannot be reactivated."
msgstr "ອຸປະກອນບໍ່ມີ metadata ແລະ ບໍ່ສາມາດເປີດໃຊ້ງານໃໝ່ໄດ້."

#: src/usr/local/www/diag_gmirror.php:109
msgid "Consumer must be present on the specified mirror."
msgstr "ອຸປະກອນຕ້ອງມີຢູ່ໃນ Mirror ທີ່ລະບຸ."

#: src/usr/local/www/diag_gmirror.php:168
msgid "There was an error performing the chosen mirror operation. Check the System Log for details."
msgstr "ເກີດຂໍ້ຜິດພາດໃນການເຮັດວຽກກັບ Mirror. ກະລຸນາກວດສອບ System Log ເພື່ອເບິ່ງລາຍລະອຽດ."

#: src/usr/local/www/diag_gmirror.php:178
