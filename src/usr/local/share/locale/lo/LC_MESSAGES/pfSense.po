#: src/etc/inc/gwlb.inc:1261
#, php-format
msgid "MONITOR: %1$s has packet loss, omitting from routing group %2$s"
msgstr "ຕິດຕາມ: %1$s ມີແພັກເກັດເສຍຫາຍ (packet loss), ຈະຕັດອອກຈາກກຸ່ມເສັ້ນທາງ %2$s"

#: src/etc/inc/gwlb.inc:1264
#, php-format
msgid "MONITOR: %1$s has high latency, omitting from routing group %2$s"
msgstr "ຕິດຕາມ: %1$s ມີຄວາມໜ່ວງ (latency) ສູງ, ຈະຕັດອອກຈາກກຸ່ມເສັ້ນທາງ %2$s"

#: src/etc/inc/gwlb.inc:1267
#, php-format
msgid "MONITOR: %1$s is down, omitting from routing group %2$s"
msgstr "ຕິດຕາມ: %1$s ໃຊ້ການບໍ່ໄດ້, ຈະຕັດອອກຈາກກຸ່ມເສັ້ນທາງ %2$s"

#: src/etc/inc/gwlb.inc:1288
#, php-format
msgid "MONITOR: %1$s is available now, adding to routing group %2$s"
msgstr "ຕິດຕາມ: %1$s ສາມາດໃຊ້ງານໄດ້ແລ້ວ, ກຳລັງເພີ່ມເຂົ້າໃນກຸ່ມເສັ້ນທາງ %2$s"

#: src/etc/inc/gwlb.inc:1310
#, php-format
msgid "Gateways status could not be determined, considering all as up/active. (Group: %s)"
msgstr "ບໍ່ສາມາດລະບຸສະຖານະເກດເວໄດ້, ຈະຖືວ່າທັງໝົດໃຊ້ງານໄດ້. (ກຸ່ມ: %s)"

#: src/etc/inc/gwlb.inc:1353
#, php-format
msgid "GATEWAYS: Group %1$s did not have any gateways up on tier %2$s!"
msgstr "ເກດເວ: ກຸ່ມ %1$s ບໍ່ມີເກດເວໃດໃຊ້ງານໄດ້ໃນລະດັບ %2$s!"

#: src/etc/inc/gwlb.inc:1431
#, php-format
msgid "Updating gateway group gateway for %1$s - new gateway is %2$s"
msgstr "ກຳລັງອັບເດດເກດເວຂອງກຸ່ມສຳລັບ %1$s - ເກດເວໃໝ່ແມ່ນ %2$s"

#: src/etc/inc/gwlb.inc:1720
msgid "gateway"
msgstr "ເກດເວ"

#: src/etc/inc/gwlb.inc:1749
msgid "A valid gateway IP address must be specified."
msgstr "ຕ້ອງລະບຸທີ່ຢູ່ IP ເກດເວທີ່ຖືກຕ້ອງ."

#: src/etc/inc/gwlb.inc:1759
msgid "Cannot add IPv4 Gateway Address because no IPv4 address could be found on the interface."
msgstr "ບໍ່ສາມາດເພີ່ມ IP ເກດເວ IPv4 ໄດ້ ເພາະບໍ່ພົບທີ່ຢູ່ IPv4 ໃນອິນເຕີເຟສ."

#: src/etc/inc/gwlb.inc:1781 src/etc/inc/gwlb.inc:1814
#, php-format
msgid "The gateway address %s does not lie within one of the chosen interface's subnets."
msgstr "ທີ່ຢູ່ເກດເວ %s ບໍ່ໄດ້ຢູ່ໃນເນັດເວີກຍ່ອຍ (subnet) ຂອງອິນເຕີເຟສທີ່ເລືອກ."

#: src/etc/inc/gwlb.inc:1792
msgid "Cannot add IPv6 Gateway Address because no IPv6 address could be found on the interface."
msgstr "ບໍ່ສາມາດເພີ່ມ IP ເກດເວ IPv6 ໄດ້ ເພາະບໍ່ພົບທີ່ຢູ່ IPv6 ໃນອິນເຕີເຟສ."

#: src/etc/inc/gwlb.inc:1822
msgid "Dynamic gateway values cannot be specified for interfaces with a static IPv4 configuration."
msgstr "ບໍ່ສາມາດລະບຸຄ່າເກດເວແບບໄດນາມິກ (dynamic) ສຳລັບອິນເຕີເຟສທີ່ຕັ້ງຄ່າ IPv4 ແບບຄົງທີ່ (static) ໄດ້."

#: src/etc/inc/gwlb.inc:1827
msgid "Dynamic gateway values cannot be specified for interfaces with a static IPv6 configuration."
msgstr "ບໍ່ສາມາດລະບຸຄ່າເກດເວແບບໄດນາມິກ (dynamic) ສຳລັບອິນເຕີເຟສທີ່ຕັ້ງຄ່າ IPv6 ແບບຄົງທີ່ (static) ໄດ້."

#: src/etc/inc/gwlb.inc:1835
msgid "A valid data payload must be specified."
msgstr "ຕ້ອງລະບຸຂໍ້ມູນ (data payload) ທີ່ຖືກຕ້ອງ."

#: src/etc/inc/gwlb.inc:1840
#, php-format
msgid "The IPv6 gateway address '%s' can not be used as a IPv4 gateway."
msgstr "ທີ່ຢູ່ເກດເວ IPv6 '%s' ບໍ່ສາມາດໃຊ້ເປັນເກດເວ IPv4 ໄດ້."

#: src/etc/inc/gwlb.inc:1843
#, php-format
msgid "The IPv4 gateway address '%s' can not be used as a IPv6 gateway."
msgstr "ທີ່ຢູ່ເກດເວ IPv4 '%s' ບໍ່ສາມາດໃຊ້ເປັນເກດເວ IPv6 ໄດ້."

#: src/etc/inc/gwlb.inc:1849
#, php-format
msgid "The IPv6 monitor address '%s' can not be used on a IPv4 gateway."
msgstr "ທີ່ຢູ່ຕິດຕາມ IPv6 '%s' ບໍ່ສາມາດໃຊ້ກັບເກດເວ IPv4 ໄດ້."

#: src/etc/inc/gwlb.inc:1852
#, php-format
msgid "The IPv4 monitor address '%s' can not be used on a IPv6 gateway."
msgstr "ທີ່ຢູ່ຕິດຕາມ IPv4 '%s' ບໍ່ສາມາດໃຊ້ກັບເກດເວ IPv6 ໄດ້."

#: src/etc/inc/gwlb.inc:1861
msgid "Changing name on a gateway is not allowed."
msgstr "ບໍ່ອະນຸຍາດໃຫ້ປ່ຽນຊື່ເກດເວ."

#: src/etc/inc/gwlb.inc:1867
#, php-format
msgid "The gateway name \"%s\" already exists."
msgstr "ຊື່ເກດເວ \"%s\" ມີຢູ່ແລ້ວ."

#: src/etc/inc/gwlb.inc:1873
#, php-format
msgid "The gateway IP address \"%s\" already exists."
msgstr "ທີ່ຢູ່ IP ເກດເວ \"%s\" ມີຢູ່ແລ້ວ."

#: src/etc/inc/gwlb.inc:1879
#, php-format
msgid "The monitor IP address \"%s\" is already in use. A different monitor IP must be chosen."
msgstr "ທີ່ຢູ່ IP ຕິດຕາມ \"%s\" ຖືກໃຊ້ງານຢູ່. ຕ້ອງເລືອກ IP ຕິດຕາມອື່ນ."

#: src/etc/inc/gwlb.inc:1892
msgid "The low latency threshold needs to be a numeric value."
msgstr "ຄ່າຄວາມໜ່ວງຕໍ່າ (low latency threshold) ຕ້ອງເປັນຕົວເລກ."

#: src/etc/inc/gwlb.inc:1894
msgid "The low latency threshold needs to be positive."
msgstr "ຄ່າຄວາມໜ່ວງຕໍ່າຕ້ອງເປັນຄ່າບວກ."

#: src/etc/inc/gwlb.inc:1903
msgid "The high latency threshold needs to be a numeric value."
msgstr "ຄ່າຄວາມໜ່ວງສູງ (high latency threshold) ຕ້ອງເປັນຕົວເລກ."

#: src/etc/inc/gwlb.inc:1905
msgid "The high latency threshold needs to be positive."
msgstr "ຄ່າຄວາມໜ່ວງສູງຕ້ອງເປັນຄ່າບວກ."

#: src/etc/inc/gwlb.inc:1914
msgid "The low Packet Loss threshold needs to be a numeric value."
msgstr "ຄ່າແພັກເກັດເສຍຫາຍຕໍ່າ (low Packet Loss threshold) ຕ້ອງເປັນຕົວເລກ."

#: src/etc/inc/gwlb.inc:1916
msgid "The low Packet Loss threshold needs to be positive."
msgstr "ຄ່າແພັກເກັດເສຍຫາຍຕໍ່າຕ້ອງເປັນຄ່າບວກ."

#: src/etc/inc/gwlb.inc:1918
msgid "The low Packet Loss threshold needs to be less than 100."
msgstr "ຄ່າແພັກເກັດເສຍຫາຍຕໍ່າຕ້ອງໜ້ອຍກວ່າ 100."

#: src/etc/inc/gwlb.inc:1927
msgid "The high Packet Loss threshold needs to be a numeric value."
msgstr "ຄ່າແພັກເກັດເສຍຫາຍສູງ (high Packet Loss threshold) ຕ້ອງເປັນຕົວເລກ."

#: src/etc/inc/gwlb.inc:1929
msgid "The high Packet Loss threshold needs to be positive."
msgstr "ຄ່າແພັກເກັດເສຍຫາຍສູງຕ້ອງເປັນຄ່າບວກ."

#: src/etc/inc/gwlb.inc:1931
msgid "The high Packet Loss threshold needs to be 100 or less."
msgstr "ຄ່າແພັກເກັດເສຍຫາຍສູງຕ້ອງບໍ່ເກີນ 100."

#: src/etc/inc/gwlb.inc:1940
msgid "The time period over which results are averaged needs to be a numeric value."
msgstr "ຊ່ວງເວລາທີ່ໃຊ້ຫາຄ່າສະເລ່ຍຕ້ອງເປັນຕົວເລກ."

#: src/etc/inc/gwlb.inc:1942
msgid "The time period over which results are averaged needs to be positive."
msgstr "ຊ່ວງເວລາທີ່ໃຊ້ຫາຄ່າສະເລ່ຍຕ້ອງເປັນຄ່າບວກ."

#: src/etc/inc/gwlb.inc:1951
msgid "The probe interval needs to be a numeric value."
msgstr "ໄລຍະຫ່າງຂອງການກວດສອບ (probe interval) ຕ້ອງເປັນຕົວເລກ."

#: src/etc/inc/gwlb.inc:1953
msgid "The probe interval needs to be positive."
msgstr "ໄລຍະຫ່າງຂອງການກວດສອບຕ້ອງເປັນຄ່າບວກ."

#: src/etc/inc/gwlb.inc:1962
msgid "The loss interval needs to be a numeric value."
msgstr "ໄລຍະຫ່າງຂອງການສູນເສຍ (loss interval) ຕ້ອງເປັນຕົວເລກ."

#: src/etc/inc/gwlb.inc:1964
msgid "The loss interval setting needs to be positive."
msgstr "ໄລຍະຫ່າງຂອງການສູນເສຍຕ້ອງເປັນຄ່າບວກ."

#: src/etc/inc/gwlb.inc:1973
msgid "The alert interval needs to be a numeric value."
msgstr "ໄລຍະຫ່າງຂອງການແຈ້ງເຕືອນ (alert interval) ຕ້ອງເປັນຕົວເລກ."

#: src/etc/inc/gwlb.inc:1975
msgid "The alert interval setting needs to be positive."
msgstr "ໄລຍະຫ່າງຂອງການແຈ້ງເຕືອນຕ້ອງເປັນຄ່າບວກ."

#: src/etc/inc/gwlb.inc:1983
msgid "The high latency threshold needs to be greater than the low latency threshold"
msgstr "ຄ່າຄວາມໜ່ວງສູງຕ້ອງຫຼາຍກວ່າຄ່າຄວາມໜ່ວງຕໍ່າ"

#: src/etc/inc/gwlb.inc:1988
msgid "The high packet loss threshold needs to be higher than the low packet loss threshold"
msgstr "ຄ່າແພັກເກັດເສຍຫາຍສູງຕ້ອງຫຼາຍກວ່າຄ່າແພັກເກັດເສຍຫາຍຕໍ່າ"

#: src/etc/inc/gwlb.inc:1994
msgid "The loss interval needs to be greater than or equal to the high latency threshold."
msgstr "ໄລຍະຫ່າງຂອງການສູນເສຍຕ້ອງຫຼາຍກວ່າ ຫຼື ເທົ່າກັບ ຄ່າຄວາມໜ່ວງສູງ."

#: src/etc/inc/gwlb.inc:1999
msgid "The time period needs to be greater than twice the probe interval plus the loss interval."
msgstr "ຊ່ວງເວລາຕ້ອງຫຼາຍກວ່າ ສອງເທົ່າຂອງໄລຍະການກວດສອບ ບວກກັບ ໄລຍະການສູນເສຍ."

#: src/etc/inc/gwlb.inc:2005
msgid "The alert interval needs to be greater than or equal to the probe interval."
msgstr "ໄລຍະຫ່າງການແຈ້ງເຕືອນຕ້ອງຫຼາຍກວ່າ ຫຼື ເທົ່າກັບ ໄລຍະການກວດສອບ."

