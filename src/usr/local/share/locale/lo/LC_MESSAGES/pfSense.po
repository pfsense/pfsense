#: src/usr/local/www/diag_sockets.php:117
#, php-format
msgid "%1$sUSER%2$s\t%3$sThe user who owns the socket.%4$s"
msgstr "%1$sUSER%2$s\t%3$sຜູ້ໃຊ້ທີ່ເປັນເຈົ້າຂອງຊັອກເກັດ.%4$s"

#: src/usr/local/www/diag_sockets.php:118
#, php-format
msgid "%1$sCOMMAND%2$s\t%3$sThe command which holds the socket.%4$s"
msgstr "%1$sCOMMAND%2$s\t%3$sຄຳສັ່ງທີ່ຄອບຄອງຊັອກເກັດ.%4$s"

#: src/usr/local/www/diag_sockets.php:119
#, php-format
msgid "%1$sPID%2$s\t%3$sThe process ID of the command which holds the socket.%4$s"
msgstr "%1$sPID%2$s\t%3$sໄອດີຂະບວນການ (Process ID) ຂອງຄຳສັ່ງທີ່ຄອບຄອງຊັອກເກັດ.%4$s"

#: src/usr/local/www/diag_sockets.php:120
#, php-format
